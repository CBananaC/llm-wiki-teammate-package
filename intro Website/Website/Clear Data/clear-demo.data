        "sources": [
          {
            "doc_id": "諭47",
            "source_type": "上諭",
            "quote": "北路賊勢蔓延，鹽埕橋系水陸扼要之區，該鎮自應仍在彼督剿捕，未便遽回郡城，以致賊人踵後。",
            "title": "諭閩浙總督常青等痛剿抗拒者並著水陸提督速奏抵臺各情",
            "date": "1787/01/14"
          },
          {
            "doc_id": "硃78",
            "source_type": "奏摺",
            "quote": "奴才相度形勢，鐵線橋離海尚遠，惟有鹽埕橋地方可以截拿水、陸兩路。",
            "title": "為奏聞鹽埕橋接仗情形事",
            "date": "1787/01/14"
          }
        ],
        "memDoc": "硃78",
        "memTitle": "為奏聞鹽埕橋接仗情形事",
        "how": "乾隆帝認同鹽埕橋為水陸形勢扼要之地，指示柴大紀應繼續在該處督兵剿捕，不可遽然撤回郡城以防叛匪尾隨攻擊。"
      }
    },
