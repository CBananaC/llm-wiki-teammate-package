      "provenance": [],
      "whenCh": "",
      "dateAr": "1787/01/10",
      "sources": [
        {
          "doc_id": "硃94",
          "quote": "臣順道將沿海各口岸，逐一履看。其汛兵單少之處，先經臣於省標內派兵二百名，前赴增駐，以資截拿，現在巡防甚為嚴密。……至內地沿海口岸，先已添撥兵丁，協同截捕。臣發諭地方官弁，以疏漏一名，罪同縱賊，使各屬共知警惕。而漳州一屬，係賊匪原籍，誠慮有勾串連結情事。臣密札該道朱芫會、知府黃彬，不動聲色，妥為防範。",
          "label": "回應",
          "howKnown": ""
        }
      ],
      "hidden": false,
      "respondsToEventId": "evms02iv4sy3j",
      "respondsToQuote": "著嚴飭沿海口岸地方文武員，實力巡防。如有竄逸餘匪，即行擒獲審辦，最爲緊要。",
      "receiveDate": "乾隆五十二年正月初十日"
    },
