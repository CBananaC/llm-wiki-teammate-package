      "provenance": [
        {
          "id": "pvcms04llqi382",
          "hops": [
            {
              "doc_id": "硃77",
              "from_person": "臺灣道永福",
              "how": "來札",
              "inferred": false,
              "layer": 1,
              "place": "",
              "quote": "茲十四日子刻，接到臺灣道永福來札，據南路逃回兵丁劉茂光稟稱：鳳邑瑚參將於十二日聞知賊匪有攻打鳳城之信，即帶兵三百名紮營城外。十三日天明時候，有賊匪二千餘名直攻縣城。瑚參將施放槍炮，僅斃賊五、六人，賊勢稍退。瑚參將放馬直追，賊匪乘虛由龜山北門撲入城內。斯時官兵槍炮莫施，旋即潰散。瑚參將縱馬由南而去，不知下落。等語。",
              "to_person": "柴大紀",
              "whenAr": "",
              "whenCh": "",
              "id": "pvms04llqi6pm"
            },
