      "dateAr": "1786/12/27",
      "sources": [
        {
          "doc_id": "諭13",
          "quote": "但恐餘黨四散逸，或偷越內渡。常青、任承恩現住蚶江一帶，著嚴飭沿海口岸地方文武員，實力巡防。如有竄逸餘匪，即行擒獲審辦，最爲緊要。",
          "label": "乾隆帝命常青與任承恩嚴飭沿海口岸防範內渡",
          "aiFilterLabel": "相關上諭",
          "howKnown": "上諭"
        }
      ],
