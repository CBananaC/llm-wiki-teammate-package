      "provenance": [],
      "whenCh": "乾隆五十一年十二月十二日",
      "dateAr": "1786/12/12",
      "sources": [
        {
          "doc_id": "硃31",
          "quote": "茲于十二日有該廳程峻之子程必大，奔赴奴才轅門求見...又，有北路竹塹營外委虞文光、兵丁王元浩，亦先後投到求救...彰化地方已被賊踞",
          "label": "程必大與虞文光等報彰化失陷",
          "aiFilterLabel": "林方行動",
          "howKnown": "轉述"
        },
        {
          "doc_id": "諭20",
          "quote": "詢悉淡水同知程峻之子程必大，及外委虞文光等彰化失陷，文報梗塞情形",
          "label": "程必大與虞文光等報彰化失陷",
          "aiFilterLabel": "林方行動",
          "howKnown": "上諭所載",
          "viaDoc": "硃35"
        }
      ],
      "hidden": false,
      "category": "",
      "aiFilterLabel": "林方行動"
    },
