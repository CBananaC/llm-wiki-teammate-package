    {
      "id": "evms02iv4sy3j",
      "actor": "emperor",
      "subtitle": "認可徐嗣曾嚴飭沿海口岸巡防之舉並命督撫嚴防賊匪偷越內渡",
      "description": "乾隆帝高度肯定徐嗣曾嚴飭沿海口岸巡防以防賊匪竄逸之部署，於奏摺相關處批示「此為最要」，並於上諭中指示常青等督撫嚴飭沿海口岸地方文武官員實力巡防，防範餘匪偷越內渡。",
      "what": "認可徐嗣曾嚴飭沿海口岸巡防之舉並命督撫嚴防賊匪偷越內渡",
      "where": "北京",
      "who": [
        "乾隆帝",
        "徐嗣曾",
        "常青",
        "任承恩"
      ],
      "whoLoc": {},
      "relations": [],
      "provenance": [],
      "whenCh": "乾隆五十一年十二月二十七日",
      "dateAr": "1786/12/27",
      "sources": [
        {
          "doc_id": "諭13",
          "quote": "但恐餘黨四散逸，或偷越內渡。常青、任承恩現住蚶江一帶，著嚴飭沿海口岸地方文武員，實力巡防。如有竄逸餘匪，即行擒獲審辦，最爲緊要。",
          "label": "認可徐嗣曾嚴飭沿海口岸巡防之舉並命督撫嚴防賊匪偷越內渡",
          "aiFilterLabel": "相關上諭",
          "howKnown": "上諭"
        }
      ],
      "hidden": false,
      "aiFilterLabel": "相關上諭",
