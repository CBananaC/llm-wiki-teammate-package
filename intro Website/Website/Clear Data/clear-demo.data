      "relations": [],
      "provenance": [],
      "whenCh": "乾隆五十一年十二月二十七日",
      "dateAr": "1786/12/27",
      "sources": [
        {
          "doc_id": "諭13",
          "quote": "賊匪率衆擾諸羅，即被官兵殺死二千餘名。該地方文武，所辦尚好，著黃仕簡前往該處，即行查明。如果屬實，將帶兵剿殺賊匪者系屬何人，並首先出力之員及兵丁，分析具，候朕酌量加恩，以示獎勵。",
          "label": "指示黃仕簡查明諸羅官兵剿殺二千餘賊傳聞並核實加恩獎勵",
          "aiFilterLabel": "相關上諭",
          "howKnown": "上諭"
        }
      ],
