  "諭24": {
    "overallAdj": "乾隆五十二年正月初二日，清廷針對臺灣林爽文攻陷彰化與諸羅、總兵柴大紀退守府城之局勢下達上諭。乾隆帝指示總督常青等人務須鎮定持重，切勿岐視漳籍民眾以免引發內地恐慌，並命黃仕簡、任承恩等提督待各路兵馬到齊後約期併力夾攻，切忌零星冒進。此外，諭旨嘉許柴大紀嚴守郡城之功，期許其迅速收復失地，並指示當前應以速剿匪徒為首務，待平定後再嚴查地方文武官員對會匪蔓延失察之責。",
    "divisions": [
      {
        "label": "轉述戰況與增援部署",
        "summary": "轉述常青與徐嗣曾奏報彰化諸羅陷落、柴大紀守護府城及派兵增援淡水艋舺等情形。",
        "start": 0,
        "end": 259,
        "n": 1
      },
      {
        "label": "告誡勿岐視漳州籍民",
        "summary": "指示常青等不可對漳州籍民預存岐視，凡應募禦賊者皆為良民，宜加獎賞以安民心。",
        "start": 259,
        "end": 464,
        "n": 2
      },
      {
        "label": "指示軍事夾攻戰略",
        "summary": "告誡清軍切勿零星冒進致生挫失，命黃仕簡與任承恩務須會合各路大兵同時併力夾攻。",
        "start": 464,
        "end": 693,
        "n": 3
      },
      {
        "label": "後方彈壓與鄰省應援",
        "summary": "指示省城駐防滿兵勿輕動，鄰省兵力密為佈置備撥即可，切勿驚動眾聽。",
        "start": 693,
        "end": 905,
        "n": 4
