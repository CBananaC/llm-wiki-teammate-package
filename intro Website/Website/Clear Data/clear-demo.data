    {
      "id": "evms042y2wwzd",
      "actor": "emperor",
      "subtitle": "肯定柴大紀守禦府城調度合宜並指示常青等務以擒獲首犯林爽文為要",
      "description": "乾隆帝肯定柴大紀調度水陸官兵四面守禦臺灣府城之部署合乎機宜，並指出目前大兵已到、賊匪奔逃四散，要求常青等督率鎮將乘勝搜捕，務以擒獲首犯解京審辦為要。",
      "what": "肯定柴大紀守禦府城調度合宜並指示常青等務以擒獲首犯林爽文為要",
      "where": "京城",
      "who": [
        "乾隆帝",
        "柴大紀",
        "常青",
        "林爽文"
      ],
      "whoLoc": {},
      "relations": [],
      "provenance": [],
      "whenCh": "乾隆五十二年二月初四日",
      "dateAr": "1787/02/04",
      "sources": [
        {
          "doc_id": "諭89",
          "quote": "大紀所辦，尚合機宜。現在大兵已到，賊匪奔逃四散。水陸二提督剋期會剿，自必立時撲滅。常青等惟當督率鎮將，擒獲首要各犯，解京審辦。並乘此兵力，上緊搜捕，務盡根株，以靖海疆。",
          "label": "肯定柴大紀守禦府城調度合宜並指示常青等務以擒獲首犯林爽文為要",
          "aiFilterLabel": "相關上諭",
          "howKnown": "上諭"
        }
      ],
      "hidden": false,
      "aiFilterLabel": "相關上諭",
      "emperorDetail": {
        "kind": "edict",
        "combined": true,
        "action_type": "praise",
        "sources": [
          {
            "doc_id": "硃128",
            "source_type": "硃批",
            "quote": "所辦皆合機宜，目今大兵已到，賊匪四散，惟擒獲首犯為要。勉為之。欽此。",
            "title": "為奏聞調度水陸官兵守禦府城事",
            "date": "1787/02/04",
            "position": "尾批"
          },
          {
            "doc_id": "諭89",
            "source_type": "上諭",
            "quote": "大紀所辦，尚合機宜。現在大兵已到，賊匪奔逃四散。水陸二提督剋期會剿，自必立時撲滅。常青等惟當督率鎮將，擒獲首要各犯，解京審辦。並乘此兵力，上緊搜捕，務盡根株，以靖海疆。",
            "title": "諭閩浙總督李侍堯等擒獲首要解京審辦並速建郡城",
            "date": "1787/02/04"
          },
          {
            "doc_id": "硃128",
            "source_type": "奏摺",
            "quote": "福建臺灣鎮總兵官奴才柴大紀謹奏，為調度水陸官兵四面守禦，力保郡城，待應援以圖恢復，恭摺奏聞事。",
            "title": "為奏聞調度水陸官兵守禦府城事",
            "date": "1787/02/04"
          }
        ],
