    {
      "id": "evms08nedxgqf",
      "actor": "emperor",
      "subtitle": "乾隆帝命閩浙督撫查明殉職彰化知縣有無激變",
      "description": "乾隆帝認為彰化知縣俞峻帶兵緝犯係因公被害而非激變，命督撫查明其平日表現及有無激變情事後據實奏聞以憑撫恤。",
      "what": "乾隆帝命閩浙督撫查明殉職彰化知縣有無激變",
      "where": "北京",
      "who": [
        "乾隆帝"
      ],
      "whoLoc": {},
      "relations": [],
      "provenance": [],
      "whenCh": "乾隆五十一年十二月二十七日",
      "dateAr": "1786/12/27",
      "sources": [
        {
          "doc_id": "諭13",
          "quote": "該縣於搜捕賊匪後，不能嚴密防範，雖失之疏懈，但帶兵緝犯，事屬因公，倉猝被害，尚非激變者可比。並著該督撫查明該縣，如平日並無別項劣跡及激變情事，即據實奏聞，候朕降旨交部議恤。",
          "label": "乾隆帝命閩浙督撫查明殉職彰化知縣有無激變",
          "aiFilterLabel": "相關上諭",
          "howKnown": "上諭"
        }
      ],
      "hidden": false,
      "aiFilterLabel": "相關上諭",
      "emperorDetail": {
        "kind": "edict",
        "combined": true,
        "action_type": "command",
        "sources": [
          {
            "doc_id": "諭13",
            "source_type": "上諭",
            "quote": "該縣於搜捕賊匪後，不能嚴密防範，雖失之疏懈，但帶兵緝犯，事屬因公，倉猝被害，尚非激變者可比。並著該督撫查明該縣，如平日並無別項劣跡及激變情事，即據實奏聞，候朕降旨交部議恤。",
            "title": "諭閩浙總督常青等嚴行殲戮林爽文等並防餘衆四散內渡",
            "date": "1786/12/27"
