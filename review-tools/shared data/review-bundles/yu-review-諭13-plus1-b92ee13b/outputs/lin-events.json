      {
        "relation": "relay",
        "source_doc_id": "硃24",
        "source_official": "徐嗣曾",
        "source_quote": "俞知縣同赫副將、耿遊擊帶兵駐扎離縣城三十里之大墩汛地，前往各莊搜捕，賊匪俱已逃竄。二十八日辰刻，忽聞二十七日夜四更時候，賊匪散而復聚，竟有數千人往劫大墩營盤。",
        "source_receive_date": "1786/12/27",
        "source_send_date": "1786/12/14"
      }
