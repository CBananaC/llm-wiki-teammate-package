    "evTitle": "本機來源鏈（4 個事件，合併為 2 條鏈）",
    "chains": [
      {
        "events": [
          {
            "quote": "林爽文乘莊眾驚懼，遂起意拒官，糾合同會並莊眾千餘人，於二十七夜攻破大墩營盤，殺害知縣、副將、遊擊、兵役多人。",
            "reporter": "高文麟、楊詠、楊軒、陳高",
            "subtitle": "林爽文攻破大墩營盤",
            "whenCh": "十一月二十七日",
            "where": "大墩"
          },
          {
            "quote": "眾至三、四千人，於十一月二十九日往攻彰化縣城，知府孫景燧、都司王宗武、同知長庚、俸滿同知劉亨基督率署典史馮啟宗、原任典史李爾和、外委許瑪等，率領兵役居民設法防禦。因存城兵少，而縣城又係栽竹為牆，被賊眾砍破擁入，搶劫倉庫槍炮器械，縱放監犯。典史李爾和、外委許瑪均各受傷知府孫景燧、同知劉亨基、長庚、都司王宗武、典史馮啟宗等，俱被殺害。",
            "reporter": "高文麟、楊詠、楊軒、陳高",
            "subtitle": "叛軍攻陷彰化縣城",
            "whenCh": "十一月二十九日",
            "where": "彰化縣城"
          },
          {
            "quote": "各賊即分路往攻諸羅、淡水，留高文麟、楊詠、楊軒、陳高等帶同匪黨數百人保守彰化。",
            "reporter": "高文麟、楊詠、楊軒、陳高",
            "subtitle": "叛軍分攻諸羅淡水並留守彰化",
            "whenCh": "",
            "where": "彰化縣城"
          }
        ],
        "hops": [
          {
            "from_person": "高文麟、楊詠、楊軒、陳高",
            "how": "供稱",
            "inferred": false,
            "layer": 1,
            "place": "泉州",
            "quote": "經臣督同司、道等親提研訊，據各犯供悉前情不諱",
            "to_person": "閩浙總督常青",
            "whenAr": "",
            "whenCh": ""
          }
        ]
      },
      {
        "events": [
          {
            "quote": "林爽文既得縣城，自稱盟主大元帥，並搶奪店鋪綢布，豎立旗號，書寫順天字樣。以賊黨陳奉先為軍師，侯老為謀士，王芬為將軍，林與為先鋒，劉賢士、林光為同知，劉四為彰化縣官，劉升為北路協，林倉管理軍糧。並有林瓦等十餘人共為羽翼。其現獲之楊詠，林爽文念其從前賣放之情，許為副元帥。高文麟許為總爺，楊軒委辦軍務。",
            "reporter": "逆犯高文麟、楊詠、楊軒、陳高",
            "subtitle": "林爽文佔城建立偽政權",
            "whenCh": "十一月二十九日",
