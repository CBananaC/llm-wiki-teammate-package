            "sources": [
              {
                "doc_id": "硃64",
                "source_type": "硃批",
                "quote": "此亦無可奈何，不可涉險",
                "title": "為招募義民實力防守及發兵渡臺情形事",
                "date": "1787/01/10",
                "position": "夾批",
                "context_quote": "等因"
              },
              {
                "doc_id": "諭40",
                "source_type": "上諭",
                "quote": "黃仕簡、任承恩所帶之兵，因守風未能遄渡，此亦無可如何，不可涉險輕進。",
                "title": "諭閩浙總督常青不可泄漏調任消息並勿稍存觀望",
                "date": "1787/01/10"
              }
            ]
          },
          {
            "title": "否決常青密為挑備策應兵力之請並指示大兵會剿無需另增後備",
            "aspect": "reject",
            "action_type": "reject",
            "how": "乾隆帝認為大兵會剿已足，足以攻克烏合之眾，對常青提出「密為挑備策應兵力」之請明確批示「可以無需矣」，無須另行辦理。",
            "description": "乾隆帝認為大兵會剿已足，足以攻克烏合之眾，對常青提出「密為挑備策應兵力」之請明確批示「可以無需矣」，無須另行辦理。",
            "whenCh": "乾隆五十二年正月初十日",
