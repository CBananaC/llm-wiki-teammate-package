        "points": [
          {
            "title": "嘉獎淡水營都司易連擒斬叛逆貢生吳異人並指示事竣後送部引見",
            "aspect": "praise",
            "action_type": "praise",
            "how": "乾隆帝對署淡水營都司易連迅速擒拿並正法借道接應叛軍之貢生吳異人等四犯表示嘉許，認為其能安定民心，指示於事竣後將易連送部引見。",
            "description": "乾隆帝對署淡水營都司易連迅速擒拿並正法借道接應叛軍之貢生吳異人等四犯表示嘉許，認為其能安定民心，指示於事竣後將易連送部引見。",
            "whenCh": "乾隆五十二年正月初十日",
            "whenAr": "1787/01/10",
            "where": "紫禁城",
            "who": [
              "乾隆帝",
              "易連",
              "吳異人"
            ],
            "whoLoc": {
              "吳異人": "艋舺",
              "易連": "淡水"
            },
            "relations": [
