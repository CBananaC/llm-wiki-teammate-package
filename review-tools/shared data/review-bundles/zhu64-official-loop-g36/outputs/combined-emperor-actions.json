              }
            ],
            "origin_doc_id": "",
            "origin_type": "",
            "origin_quote": "",
            "origin_date": "",
            "same_as_event_id": "",
            "sources": [
              {
                "doc_id": "硃64",
                "source_type": "硃批",
                "quote": "皆當優獎",
                "title": "為招募義民實力防守及發兵渡臺情形事",
                "date": "1787/01/10",
                "position": "夾批",
                "context_quote": "守備董得魁、把總蘇升等帶領義民五百名，由艋舺渡河，直攻下莊，至草店尾大街；都司同千總席榮等，帶兵三百名，由草店尾河坡先斷浮橋，進攻國王廟邊；李因、鄭追、李明、黃挽等督率義民五百名，由武朥灣進攻中港厝；監生黃朝陽、林講、徐修等"
              },
              {
                "doc_id": "硃64",
                "source_type": "硃批",
                "quote": "亦當旌賞",
                "title": "為招募義民實力防守及發兵渡臺情形事",
                "date": "1787/01/10",
                "position": "夾批",
                "context_quote": "又廣省義民邱龍四、林貴陽等"
              },
              {
                "doc_id": "硃64",
                "source_type": "硃批",
                "quote": "皆應賞恤",
                "title": "為招募義民實力防守及發兵渡臺情形事",
                "date": "1787/01/10",
                "position": "夾批",
                "context_quote": "埋伏彭厝莊，四面攻殺，槍炮齊發，殺死賊匪五十餘人，奪得大旗兩杆，小旗一枝，黃彩一匹，並起告白、告示各一紙，義民亦被害數十人"
              },
              {
                "doc_id": "硃64",
                "source_type": "硃批",
                "quote": "好，可嘉",
                "title": "為招募義民實力防守及發兵渡臺情形事",
                "date": "1787/01/10",
                "position": "夾批",
                "context_quote": "即將吳異人等四人拿解營中，訊確隨押赴教場，斬首梟示，以安民心"
              },
              {
                "doc_id": "諭38",
                "source_type": "上諭",
                "quote": "至該處生監及本處並廣東商民，激發公義，志切同仇，共相糾衆，攻殺賊匪，保護地方，實堪嘉獎。著該督等查明，分別連賞，以示優獎。其義民內有被賊傷害者，並著該督等於事竣後，查明具奏，照陣亡兵丁之例，一體議恤。",
                "title": "諭內閣嘉獎捕殺吳異人等出力人員",
                "date": "1787/01/10"
              },
              {
                "doc_id": "諭40",
                "source_type": "上諭",
                "quote": "並令該督查明協同殺賊之生監義民，分別賞恤矣。",
                "title": "諭閩浙總督常青不可泄漏調任消息並勿稍存觀望",
                "date": "1787/01/10"
              }
            ]
          },
          {
            "title": "認同常青指匪徒蓄謀已久之論並判定天地會名目係出於傳訛",
            "aspect": "comment",
            "action_type": "comment",
            "how": "乾隆帝認同常青關於林爽文等賊匪係蓄謀已久之研判，並針對常青疑慮天地會是否與楊光勳之添弟會勾結一事，批示澄清此等名目皆屬傳訛之語。",
            "description": "乾隆帝認同常青關於林爽文等賊匪係蓄謀已久之研判，並針對常青疑慮天地會是否與楊光勳之添弟會勾結一事，批示澄清此等名目皆屬傳訛之語。",
            "whenCh": "乾隆五十二年正月初十日",
            "whenAr": "1787/01/10",
            "where": "紫禁城",
            "who": [
              "乾隆帝",
              "常青"
            ],
            "whoLoc": {
              "常青": "泉州"
            },
            "relations": [
              {
                "from": "乾隆帝",
                "to": "常青",
                "type": "approve"
              }
            ],
            "origin_doc_id": "",
            "origin_type": "",
            "origin_quote": "",
            "origin_date": "",
            "same_as_event_id": "",
            "sources": [
              {
                "doc_id": "硃64",
                "source_type": "硃批",
                "quote": "此言是",
                "title": "為招募義民實力防守及發兵渡臺情形事",
                "date": "1787/01/10",
                "position": "夾批",
                "context_quote": "竊思小丑竊發，竟至四路響應，是其蓄謀不軌，必非一日"
              },
              {
                "doc_id": "硃64",
                "source_type": "硃批",
                "quote": "不出此，蓋訛傳語耳",
                "title": "為招募義民實力防守及發兵渡臺情形事",
                "date": "1787/01/10",
                "position": "夾批",
                "context_quote": "其所稱天地會名目，尤屬不經，是否與諸羅匪犯楊光勳等所設之添弟會暗樹黨援"
              }
            ]
          },
          {
            "title": "指示水陸提督因風阻延渡海屬無可奈何切不可涉險輕進",
            "aspect": "command",
            "action_type": "command",
            "how": "乾隆帝針對黃仕簡、任承恩帶兵渡臺因風暴受阻無法放洋之情節，表示此屬無可奈何，指示切不可涉險輕進，務必俟風順後再行飛渡。",
            "description": "乾隆帝針對黃仕簡、任承恩帶兵渡臺因風暴受阻無法放洋之情節，表示此屬無可奈何，指示切不可涉險輕進，務必俟風順後再行飛渡。",
            "whenCh": "乾隆五十二年正月初十日",
            "whenAr": "1787/01/10",
            "where": "紫禁城",
            "who": [
