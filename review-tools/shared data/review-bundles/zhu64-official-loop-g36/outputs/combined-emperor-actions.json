            "sources": [
              {
                "doc_id": "諭39",
                "source_type": "上諭",
                "quote": "李侍堯著調補閩浙總督，即馳驛前赴新任。湖廣系腹地省份，且地方寧謐無事，常青自能勝任學習，以至歷練，即著調補湖廣總督。",
                "title": "諭內閣李侍堯調補閩浙總督著即馳赴新任",
                "date": "1787/01/10"
              }
            ]
