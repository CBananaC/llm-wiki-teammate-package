            "sources": [
              {
                "doc_id": "硃64",
                "source_type": "硃批",
                "quote": "此人可嘉，事完送部引見",
                "title": "為招募義民實力防守及發兵渡臺情形事",
                "date": "1787/01/10",
                "position": "夾批",
                "context_quote": "經防禦義民即來報知"
              },
              {
                "doc_id": "硃64",
                "source_type": "硃批",
                "quote": "好",
                "title": "為招募義民實力防守及發兵渡臺情形事",
                "date": "1787/01/10",
                "position": "夾批",
                "context_quote": "即將吳異人等四人拿解營中，訊確隨押赴教場，斬首梟示，以安民心"
              },
              {
                "doc_id": "諭38",
                "source_type": "上諭",
                "quote": "該署都司易連，於賊夥吳異人等前往助賊時，即擒拿梟，以安民心，所辦屬可嘉。易連事竣後，該督給諮送部引見。",
                "title": "諭內閣嘉獎捕殺吳異人等出力人員",
                "date": "1787/01/10"
              }
            ]
          },
          {
            "title": "嘉獎協助官軍攻殺賊匪之各地義民生監並下令查明賞恤及撫卹陣亡者",
            "aspect": "praise",
            "action_type": "praise",
            "how": "乾隆帝對黃朝陽等生監及泉州、廣東等各地義民奮勇禦賊、焚毀賊巢之義舉高度肯定，指示常青查明出力人員分別優獎旌賞，並要求對陣亡義民比照陣亡兵丁之例給予撫卹。",
            "description": "乾隆帝對黃朝陽等生監及泉州、廣東等各地義民奮勇禦賊、焚毀賊巢之義舉高度肯定，指示常青查明出力人員分別優獎旌賞，並要求對陣亡義民比照陣亡兵丁之例給予撫卹。",
            "whenCh": "乾隆五十二年正月初十日",
            "whenAr": "1787/01/10",
            "where": "紫禁城",
            "who": [
              "乾隆帝",
              "黃朝陽",
              "邱龍四",
              "林貴陽",
              "常青"
            ],
            "whoLoc": {
              "常青": "泉州",
              "黃朝陽": "淡水"
            },
            "relations": [
              {
                "from": "乾隆帝",
