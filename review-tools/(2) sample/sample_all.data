        "items": [
          {
            "edict_id": "諭20",
            "title": "諭閩浙總督常青等鎮定妥辦不必紛紛赴臺",
            "date": "1786/12/29",
            "memDoc": "硃32",
            "memTitle": "為特簡重臣臨閩督辦事（附片）",
            "summary": "只保留皇帝自己的評論、答覆或命令；同義硃批與上諭合為一項。",
            "points": [
              {
                "title": "乾隆帝嚴厲斥責任承恩請求特簡重臣臨閩督辦係屬至愚且不成話並諭示督撫提鎮本有綏靖地方之責",
                "aspect": "blame",
                "action_type": "blame",
                "how": "乾隆帝針對福建陸路提督任承恩奏請特簡重臣前往福建鎮安督辦臺灣善後事宜一事，於奏摺尾批嚴斥其「更不成話，不料汝亦如此至愚」，並於上諭中進一步指出地方督撫提鎮各有綏靖地方之責，若一遇匪徒滋事即請欽差大臣前往，顯屬不曉事體。",
                "description": "乾隆帝針對福建陸路提督任承恩奏請特簡重臣前往福建鎮安督辦臺灣善後事宜一事，於奏摺尾批嚴斥其「更不成話，不料汝亦如此至愚」，並於上諭中進一步指出地方督撫提鎮各有綏靖地方之責，若一遇匪徒滋事即請欽差大臣前往，顯屬不曉事體。",
                "whenCh": "乾隆五十一年十二月二十九日",
                "whenAr": "1786/12/29",
                "where": "京師",
                "who": [
                  "乾隆帝",
                  "任承恩"
                ],
                "whoLoc": {
                  "乾隆帝": "京師",
                  "任承恩": "福建"
                },
                "relations": [],
                "origin_doc_id": "",
                "origin_type": "",
                "origin_quote": "",
                "origin_date": "",
                "same_as_event_id": "evmr3ct01fofz",
                "sources": [
                  {
                    "doc_id": "硃32",
                    "source_type": "硃批",
                    "quote": "更不成話，不料汝亦如此至愚。欽此。",
                    "title": "為特簡重臣臨閩督辦事（附片）",
                    "date": "1786/12/29",
                    "position": "尾批"
                  },
                  {
                    "doc_id": "諭20",
                    "source_type": "上諭",
                    "quote": "至所稱簡派欽差督辦，更不成話。督撫提鎮俱有綏靖地方之責，設一遇匪徒滋事，輒請欽派大臣督辦，又安用伊等爲耶？",
                    "title": "諭閩浙總督常青等鎮定妥辦不必紛紛赴臺",
