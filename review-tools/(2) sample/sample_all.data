                "whenCh": "乾隆五十二年正月初十日",
                "whenAr": "1787/01/10",
                "where": "北京",
                "who": [
                  "乾隆帝",
                  "黃朝陽",
                  "邱龍四",
                  "常青"
                ],
                "whoLoc": {
                  "乾隆帝": "北京",
                  "常青": "泉州"
                },
                "relations": [],
