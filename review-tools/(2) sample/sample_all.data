        "items": [
          {
            "edict_id": "諭20",
            "title": "諭閩浙總督常青等鎮定妥辦不必紛紛赴臺",
            "date": "1786/12/29",
            "memDoc": "硃31",
            "memTitle": "為奏臺灣地方官求救及統兵會剿事",
            "summary": "只保留皇帝自己的評論、答覆或命令；同義硃批與上諭合為一項。",
            "points": [
              {
                "title": "嚴厲斥責任承恩計畫渡臺與水師提督會剿及請求簡派大臣督辦為張皇失措且不曉事體",
                "aspect": "blame",
                "action_type": "blame",
                "how": "乾隆帝對陸路提督任承恩計畫親自渡臺與水師提督黃仕簡會剿，以及請求朝廷簡派大臣督辦的意見極為不滿。皇帝嚴詞批駁水陸兩提督同時渡海將導致內地空虛，並指出地方督撫提鎮本有綏靖之責，遇事即請欽派大臣極不成話，隨即傳旨申飭常青、黃仕簡與任承恩等人。",
                "description": "乾隆帝對陸路提督任承恩計畫親自渡臺與水師提督黃仕簡會剿，以及請求朝廷簡派大臣督辦的意見極為不滿。皇帝嚴詞批駁水陸兩提督同時渡海將導致內地空虛，並指出地方督撫提鎮本有綏靖之責，遇事即請欽派大臣極不成話，隨即傳旨申飭常青、黃仕簡與任承恩等人。",
                "whenCh": "乾隆五十一年十二月二十九日",
                "whenAr": "1786/12/29",
                "where": "",
                "who": [
                  "任承恩",
                  "常青",
                  "黃仕簡"
                ],
                "whoLoc": {},
                "relations": [],
                "origin_doc_id": "",
                "origin_type": "",
                "origin_quote": "",
                "origin_date": "",
                "same_as_event_id": "evmr3i8zauko7",
                "sources": [
                  {
                    "doc_id": "硃31",
                    "source_type": "硃批",
                    "quote": "豈有兩提督往辦一匪類之理。若不誠是巧詐，若誠是至愚。欽此。",
                    "title": "為奏臺灣地方官求救及統兵會剿事",
                    "date": "1786/12/29",
                    "position": "尾批"
                  },
                  {
                    "doc_id": "諭20",
                    "source_type": "上諭",
                    "quote": "乃任承恩竟欲親往，豈有水陸兩提督俱遠渡重洋，內地於不顧，辦一匪類之理？至所稱簡派欽差督辦，更不成話。督撫提鎮俱有綏靖地方之責，設一遇匪徒滋事，輒請欽派大臣督辦，又安用伊等爲耶？",
                    "title": "諭閩浙總督常青等鎮定妥辦不必紛紛赴臺",
                    "date": "1786/12/29"
                  },
                  {
                    "doc_id": "硃31",
                    "source_type": "奏摺",
                    "quote": "奴才並已挑派備戰兵丁一千名，隨帶軍火、器具，一面飭營移會府、縣，撥運糧石，於十三日分配登舟，候風放洋。伏思該處賊匪，膽敢猖獗至此，深堪痛恨。奴才即欲起程督兵前往，實見漳泉地方，不可一日無大員鎮壓，未敢輕動。現聞督臣已自省星夜來泉，一俟到日，會籌妥協，立即登舟飛渡臺灣，協同黃仕簡戮力剿除",
                    "title": "為奏臺灣地方官求救及統兵會剿事",
                    "date": "1786/12/29"
                  }
                ],
                "__repeatId": "硃31#emperor#candidate"
              },
              {
                "title": "指示任承恩既已渡臺即毋須拘泥回任務須與黃仕簡同心協力分路夾攻速擒賊匪",
                "aspect": "command",
                "action_type": "command",
                "how": "乾隆帝考慮到任承恩既已帶兵渡臺，指示其不必拘泥原意撤回，而應與水師提督黃仕簡同心協力、鎮定持重，分路夾攻賊匪，務求迅速殲滅以期剋日奏功。",
                "description": "乾隆帝考慮到任承恩既已帶兵渡臺，指示其不必拘泥原意撤回，而應與水師提督黃仕簡同心協力、鎮定持重，分路夾攻賊匪，務求迅速殲滅以期剋日奏功。",
                "whenCh": "乾隆五十一年十二月二十九日",
                "whenAr": "1786/12/29",
                "where": "",
                "who": [
                  "任承恩",
                  "黃仕簡"
                ],
                "whoLoc": {},
                "relations": [],
                "origin_doc_id": "",
                "origin_type": "",
                "origin_quote": "",
                "origin_date": "",
                "same_as_event_id": "",
                "sources": [
                  {
                    "doc_id": "諭20",
                    "source_type": "上諭",
                    "quote": "任承恩本不應前往，今既已渡臺，亦不須拘泥回任，務須實力勇往，會同黃仕簡分路夾攻，速擒兇匪，以期剋日功速回。",
                    "title": "諭閩浙總督常青等鎮定妥辦不必紛紛赴臺",
                    "date": "1786/12/29"
                  },
                  {
                    "doc_id": "諭28",
                    "source_type": "上諭",
                    "quote": "任承恩既已同往，務須與黃仕簡同心協力，鎮定持重，努力剿捕。",
                    "title": "諭閩浙總督常青等務須同心協力俟大兵到齊夾攻",
                    "date": "1787/01/03"
                  },
                  {
                    "doc_id": "硃31",
