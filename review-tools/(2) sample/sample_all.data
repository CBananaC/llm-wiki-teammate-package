      {
        "at": "2026-07-26 16:26",
        "model": "local skill output",
        "kind": "edictmatch",
        "combinedEmperor": true,
        "marker": "既有配對",
        "memDoc": "硃94",
        "memTitle": "為恭摺覆奏督催官兵放洋及巡查海口等緣由事",
        "items": [
          {
            "edict_id": "諭62",
            "title": "諭欽差湖廣總督李侍堯等徐嗣曾離省往閩安著傳旨申飭",
            "date": "1787/01/22",
            "memDoc": "硃94",
            "memTitle": "為恭摺覆奏督催官兵放洋及巡查海口等緣由事",
            "summary": "只保留皇帝自己的評論、答覆或命令；同義硃批與上諭合為一項。",
            "points": [
              {
                "title": "嚴厲申飭福建巡撫徐嗣曾輕離省城前往閩安督催巡查之舉並指其不計輕重",
                "aspect": "blame",
                "action_type": "blame",
                "how": "乾隆帝針對福建巡撫徐嗣曾奏報親赴閩安督催官兵放洋及巡查沿海口岸一事，嚴厲批評其身為巡撫不應擅離省城，指出此舉係不計事理輕重之錯誤舉動，極易致使人心疑駭，故不予嘉獎並下旨傳旨申飭。",
                "description": "乾隆帝針對福建巡撫徐嗣曾奏報親赴閩安督催官兵放洋及巡查沿海口岸一事，嚴厲批評其身為巡撫不應擅離省城，指出此舉係不計事理輕重之錯誤舉動，極易致使人心疑駭，故不予嘉獎並下旨傳旨申飭。",
                "whenCh": "乾隆五十二年正月二十二日",
                "whenAr": "1787/01/22",
                "where": "北京",
                "who": [
                  "乾隆帝",
                  "徐嗣曾"
                ],
                "whoLoc": {
                  "乾隆帝": "北京",
                  "徐嗣曾": "福州"
                },
                "relations": [],
                "origin_doc_id": "",
                "origin_type": "",
                "origin_quote": "",
                "origin_date": "",
                "same_as_event_id": "evmrdeiv398gh",
                "sources": [
                  {
                    "doc_id": "硃94",
                    "source_type": "硃批",
                    "quote": "汝不應離省，錯了，但知急公出力，而不計及輕重，可鄙而矣，不嘉汝不辭勞苦急公他",
                    "title": "為恭摺覆奏督催官兵放洋及巡查海口等緣由事",
                    "date": "1787/01/22",
                    "position": "夾批",
                    "context_quote": "閩安等處地方緊要"
                  },
                  {
                    "doc_id": "諭62",
                    "source_type": "上諭",
                    "quote": "據徐嗣曾奏，副將徐鼎士等所帶兵丁，因阻風未渡。該於初八日親赴督催，並順道將沿海各口岸逐一看，於初十日回署等語。所辦錯誤，已於折內詳悉批示。地方偶有聚衆滋事之處，總督既經前往，巡撫自當在省鎮靜，不應輕離會城，以致人心疑駭，昨因孫士毅奏親赴潮州彈壓，已降旨嚴行申飭，並與沿海各督撫，務宜益加鎮定。今徐嗣曾復有前往閩安之奏，外省督撫一遇此等事件，輒奏請前往者，不過以無此奏，恐朕怪其安坐省垣，惟知出力急公，而不權事理之輕重緩急。似此輕於舉動，朕並不嘉其不辭勞苦，轉爲朕所鄙矣，徐嗣曾着傳旨申飭。",
                    "title": "諭欽差湖廣總督李侍堯等徐嗣曾離省往閩安著傳旨申飭",
                    "date": "1787/01/22"
                  }
                ],
                "__pendingResponses": [
                  {
                    "action_quote": "今徐嗣曾復有前往閩安之奏，外省督撫一遇此等事件，輒奏請前往者，不過以無此奏，恐朕怪其安坐省垣，惟知出力急公，而不權事理之輕重緩急。似此輕於舉動，朕並不嘉其不辭勞苦，轉爲朕所鄙矣，徐嗣曾着傳旨申飭。",
                    "doc_id": "硃172",
                    "how": "福建巡撫徐嗣曾接准正月二十二日嚴飭上諭後恭摺具奏。徐嗣曾伏罪自責因官兵阻風未渡即親赴閩安查催，實屬知識短淺且不權事理輕重緩急，深感愧懼無地自容。徐嗣曾表示定將凜遵聖訓，鎮靜妥辦省垣防務以圖蓋前愆，並隨摺陳報水陸兩提臣抵臺會剿戰況，以及沿海口岸嚴加防範與盤獲從逆匪犯陳榜之情形。",
                    "receive_date": "1787/02/04",
                    "relations": [
                      {
                        "evidence": "並經督臣前赴泉州駐紮調度。省垣重地，臣應坐鎮彈壓",
                        "relation": "駐紮調度",
                        "relation_type": "command",
                        "source": "常青",
                        "target": "徐嗣曾"
                      }
                    ],
                    "response_date": "1787/02/04",
                    "response_quote": "臣跪讀之下，不勝惶悚。伏思海外匪徒聚眾滋事，水、陸二提臣渡臺會剿，並經督臣前赴泉州駐紮調度。省垣重地，臣應坐鎮彈壓，乃臣徒見官兵阻風未渡，輒親赴閩安查催，實屬知識短淺，不權事理輕重緩急。上廑皇上聖懷，於數千里外，諄切訓誡，臣自悔錯誤，愧迫恐懼，無地自容。惟有凜遵聖訓，一切鎮靜妥辦，凡分內應行事宜，益加奮勉，圖蓋前愆，仰報高厚。",
                    "subtitle": "徐嗣曾伏罪自責輕離省垣前往閩安，並表示將凜遵聖訓鎮靜妥辦。",
                    "where": "閩安",
                    "who": [
                      "徐嗣曾",
                      "常青",
                      "黃仕簡",
                      "任承恩",
                      "徐鼎士"
                    ],
