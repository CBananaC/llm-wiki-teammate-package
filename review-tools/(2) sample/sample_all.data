                "same_as_event_id": "evmr204g8786x",
                "sources": [
                  {
                    "doc_id": "諭13",
                    "source_type": "上諭",
                    "quote": "但恐餘黨四散逸，或偷越內渡。常青、任承恩現住蚶江一帶，著嚴飭沿海口岸地方文武員，實力巡防。如有竄逸餘匪，即行擒獲審辦，最爲緊要。",
                    "title": "諭閩浙總督常青等嚴行殲戮林爽文等並防餘衆四散內渡",
                    "date": "1786/12/27"
                  },
                  {
                    "doc_id": "硃24",
                    "source_type": "奏摺",
                    "quote": "臣現在嚴飭沿海口岸，實力徼巡，防其竄逸",
                    "title": "為奏接鎮道文報並派遣省兵赴臺事",
                    "date": "1786/12/27"
                  }
                ],
                "__pendingResponses": [
                  {
                    "action_quote": "著嚴飭沿海口岸地方文武員，實力巡防。如有竄逸餘匪，即行擒獲審辦，最爲緊要。",
                    "doc_id": "硃94",
                    "how": "徐嗣曾親自履看沿海口岸，於汛兵單少之處增派兵丁駐守截捕，並嚴諭地方文武官弁若疏漏一名即罪同縱賊。同時因漳州為賊匪原籍，密札漳州道朱芫會與知府黃彬不動聲色妥為防範，懸賞緝拿潛逃回籍之賊匪。",
                    "receive_date": "乾隆五十二年正月初十日",
                    "relations": [
                      {
                        "evidence": "臣密札該道朱芫會",
                        "relation": "密札",
                        "relation_type": "command",
                        "source": "徐嗣曾",
                        "target": "朱芫會"
                      },
                      {
                        "evidence": "臣密札該道朱芫會、知府黃彬，不動聲色，妥為防範",
                        "relation": "密札",
                        "relation_type": "command",
                        "source": "徐嗣曾",
                        "target": "黃彬"
                      }
                    ],
                    "response_date": "乾隆五十二年正月初十日",
                    "response_quote": "臣順道將沿海各口岸，逐一履看。其汛兵單少之處，先經臣於省標內派兵二百名，前赴增駐，以資截拿，現在巡防甚為嚴密。……至內地沿海口岸，先已添撥兵丁，協同截捕。臣發諭地方官弁，以疏漏一名，罪同縱賊，使各屬共知警惕。而漳州一屬，係賊匪原籍，誠慮有勾串連結情事。臣密札該道朱芫會、知府黃彬，不動聲色，妥為防範。",
                    "subtitle": "徐嗣曾履看沿海口岸並添兵嚴防臺匪偷越內渡",
