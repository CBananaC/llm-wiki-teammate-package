        {
          "evidence": "搜剿林爽文賊巢淨盡後",
          "relation": "進剿",
          "relation_type": "conflict",
          "source": "任承恩",
          "target": "林爽文"
        }
      ],
      "provenance": [],
      "whenCh": "",
      "dateAr": "1787/01/14",
      "sources": [
        {
          "doc_id": "奏80",
          "quote": "奴才隨即統領官兵二千名，配船二十五號於十二月十七日開行...奴才仍嚴督帶兵將備，將虎仔坑一帶賊莊剋日剿平，陳泮、吳領二犯務期拏獲。再將官兵調赴大里杙一帶，搜剿林爽文賊巢淨盡後，奴才即當親統官兵南下，會同水師提臣黃仕簡商酌機宜，同心併力，迅擒首逆，盡殲匪黨，以伸國法，以快人心。",
          "label": "回應",
          "howKnown": ""
        }
      ],
      "hidden": false,
      "respondsToEventId": "evmrx79kclhz6",
      "respondsToQuote": "常青、黃仕簡、任承恩，俱著傳旨申飭。",
      "receiveDate": ""
    },
