              "date_note": "奏摺上奏於乾隆五十二年正月十四日，文中「十四日子刻」指正月十四日。"
            },
            "yu": {
              "id": "諭28",
              "title": "諭閩浙總督常青等務須同心協力俟大兵到齊夾攻",
              "type": "shangyu",
              "doc_type": "上諭",
              "author": "常青",
              "recipients": [
