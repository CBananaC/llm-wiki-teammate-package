  "硃23": {
    "overallAdj": "乾隆五十一年十二月初十日，任承恩上奏呈報接獲福建水師提督黃仕簡之會札。札中指出臺灣發生叛亂且彰化縣城已被攻破，黃仕簡正積極調備兵船，擬於接獲確訊後親自渡臺處置，並請任承恩一同留心防範。任承恩遂將此軍情彙報朝廷，乾隆皇帝對此批覆「覽」。",
    "divisions": [
      {
        "label": "奏報警訊與調兵狀況",
        "summary": "閩浙總督任承恩奏報接獲水師提督黃仕簡札會，得知臺灣彰化縣城陷落，黃仕簡正整備兵船準備赴臺辦理。",
        "start": 0,
        "end": 81,
        "n": 1
      },
      {
        "label": "皇帝硃批",
        "summary": "乾隆皇帝於十二月初十日下達「覽」之硃批。",
        "start": 81,
        "end": 114,
        "n": 2
      }
    ],
