                "doc_id": "硃31",
                "quote": "賊匪眾多，抵敵不住，我父親存亡不知。",
                "howKnown": "",
                "whenKnown": ""
              }
            ],
            "__traceChains": [
              {
                "events": [
                  {
                    "quote": "賊匪眾多，抵敵不住，我父親存亡不知。",
                    "reporter": "程必大",
                    "subtitle": "賊匪於中港擊潰清軍",
                    "whenCh": "十二月初七日前",
