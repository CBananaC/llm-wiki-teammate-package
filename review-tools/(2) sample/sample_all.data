      {
        "at": "2026-07-26 15:59",
        "model": "local skill output",
        "kind": "officialresponse",
        "evTitle": "指示常青暫緩查辦漳州籍要犯在內地之家屬以免引起民心疑駭",
        "addressee": "常青",
        "action_doc_ids": [
          "諭51",
          "諭52",
          "硃83"
        ],
        "source_doc_ids": [
          "諭51",
          "諭52",
          "硃83"
        ],
        "confirmedPairsOnly": true,
        "prompt": "（本機技能輸出：outputs/official-response.json）",
        "items": [
          {
            "action_quote": "若此時遽行查辦，恐內地漳民聞而生駭，轉多未便。著傳諭常青……訊明各要犯家屬下落，密爲存記。黃仕簡等在臺搜捕賊匪事竣，大兵撤回廈門、蚶江等處時，督提聚在一處，將賊犯家屬按名查拿辦理",
            "doc_id": "硃146",
            "how": "常青覆奏已奉到正月十五日上諭，說明楊振國等要犯係生長臺灣，家屬多在彰化，已諮會提臣嚴搜。至原籍內地之要犯家屬，臣恪遵聖訓密為存記，統俟剿匪事竣後再會同提臣查拿，一切處以鎮靜，以免致滋驚駭。",
            "receive_date": "乾隆五十二年正月二十八日",
            "relations": [
              {
                "evidence": "陳邦光拿獲賊目楊振國等四犯",
                "relation": "拿獲",
                "relation_type": "conflict",
