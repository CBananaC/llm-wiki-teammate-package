            "actor": "lin",
            "category": "done",
            "subtitle": "賊匪於中港擊潰清軍",
            "description": "賊匪於中港地方聚集，與淡防同知程峻及守備董得魁等帶領之官兵鄉勇交戰，因賊匪眾多，清軍抵敵不住潰敗。",
            "where": "中港",
            "whenCh": "十二月初七日前",
            "whenAr": "1786/12/07",
            "who": [
              "賊匪",
              "程峻",
              "董得魁"
            ],
            "whoLoc": {
              "程峻": "中港",
              "董得魁": "中港",
              "賊匪": "中港"
            },
