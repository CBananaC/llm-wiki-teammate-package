            "points": [
              {
                "title": "嘉獎署都司易連迅速擒斬借道賊夥吳異人以安民心並命於事竣後送部引見",
                "aspect": "praise",
                "action_type": "praise",
                "how": "乾隆帝讚許署淡水營都司易連於賊匪借道時果斷將賊夥貢生吳異人等四人擒拿斬梟以安民心，辦理甚好，指示於事竣後給諮送部引見。",
                "description": "乾隆帝讚許署淡水營都司易連於賊匪借道時果斷將賊夥貢生吳異人等四人擒拿斬梟以安民心，辦理甚好，指示於事竣後給諮送部引見。",
                "whenCh": "乾隆五十二年正月初十日",
                "whenAr": "1787/01/10",
                "where": "北京",
                "who": [
