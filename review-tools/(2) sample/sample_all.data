    {
      "id": "evms02jiz9ewr",
      "actor": "qing",
      "subtitle": "徐嗣曾履看沿海口岸並添兵嚴防臺匪偷越內渡",
      "description": "徐嗣曾親自履看沿海口岸，於汛兵單少之處增派兵丁駐守截捕，並嚴諭地方文武官弁若疏漏一名即罪同縱賊。同時因漳州為賊匪原籍，密札漳州道朱芫會與知府黃彬不動聲色妥為防範，懸賞緝拿潛逃回籍之賊匪。",
      "what": "徐嗣曾履看沿海口岸並添兵嚴防臺匪偷越內渡",
      "where": "福建沿海口岸",
      "who": [
        "徐嗣曾",
        "朱芫會",
        "黃彬"
      ],
      "whoLoc": {
        "徐嗣曾": "福州",
        "朱芫會": "漳州",
        "黃彬": "漳州"
      },
      "relations": [
        {
          "evidence": "臣密札該道朱芫會",
          "relation": "密札",
          "relation_type": "command",
          "source": "徐嗣曾",
          "target": "朱芫會"
        },
        {
          "evidence": "臣密札該道朱芫會、知府黃彬，不動聲色，妥為防範",
          "relation": "密札",
          "relation_type": "command",
          "source": "徐嗣曾",
          "target": "黃彬"
        }
      ],
      "provenance": [],
      "whenCh": "",
      "dateAr": "1787/01/10",
      "sources": [
        {
          "doc_id": "硃94",
          "quote": "臣順道將沿海各口岸，逐一履看。其汛兵單少之處，先經臣於省標內派兵二百名，前赴增駐，以資截拿，現在巡防甚為嚴密。……至內地沿海口岸，先已添撥兵丁，協同截捕。臣發諭地方官弁，以疏漏一名，罪同縱賊，使各屬共知警惕。而漳州一屬，係賊匪原籍，誠慮有勾串連結情事。臣密札該道朱芫會、知府黃彬，不動聲色，妥為防範。",
          "label": "回應",
          "howKnown": ""
        }
      ],
