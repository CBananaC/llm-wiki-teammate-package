        }
      ],
      "hidden": false,
      "aiFilterLabel": "相關上諭",
      "emperorDetail": {
        "kind": "edict",
        "combined": true,
        "action_type": "comment",
        "sources": [
          {
            "doc_id": "硃82",
            "source_type": "硃批",
            "quote": "看來府城無事，紙盼黃仕簡到臺灣之信耳。欽此。",
            "title": "為奏聞守備陳邦光攻打彰化擒獲楊振國等緣由事",
