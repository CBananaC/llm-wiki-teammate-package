  "硃58": {
    "overallAdj": "乾隆五十一年十二月，閩浙總督常青與福建巡撫徐嗣曾聯名上奏，指原臺灣諸羅知縣黃嘉訓因涉案遭降級調用，致使該缺懸空。考量諸羅地處海外且政務繁雜，督撫等遴選熟稔海疆風土、辦事勤練的長汀縣知縣王悳齡調補諸羅縣令。乾隆五十二年正月初七日，乾隆帝硃批下旨「該部議奏」，將此人事調動交由吏部討論辦理。",
    "divisions": [
      {
        "label": "事由與缺員緣由",
        "summary": "閩浙總督常青與福建巡撫徐嗣曾奏報諸羅縣知縣黃嘉訓因案降調，急需遴員填補。",
        "start": 0,
        "end": 104,
        "n": 1
      },
      {
        "label": "遴選人選與資歷",
        "summary": "說明諸羅地方政務繁重，經過遴選後，認定長汀縣知縣王悳齡經驗豐富、能力稱職。",
        "start": 104,
        "end": 318,
        "n": 2
      },
      {
        "label": "請旨與遺缺擬辦",
        "summary": "請求將王悳齡調補諸羅知縣且免送部引見，並說明長汀知縣遺缺之處置與檢附處分清單呈覽。",
        "start": 318,
        "end": 457,
        "n": 3
      },
      {
        "label": "奏報日期與硃批",
        "summary": "記錄具奏日期及皇帝下達「該部議奏」之硃批指示。",
        "start": 457,
        "end": 503,
        "n": 4
      }
    ],
