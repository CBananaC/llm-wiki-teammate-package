                "sources": [
                  {
                    "doc_id": "諭13",
                    "source_type": "上諭",
                    "quote": "常青、徐嗣曾等，總須不動聲色，妥協辦理。若因外洋遇有此等案件，該督撫等紛紛調遣，跡涉張皇，轉致內地民人心生疑駭，殊有關係，該督撫不可不處以鎮定也。",
                    "title": "諭閩浙總督常青等嚴行殲戮林爽文等並防餘衆四散內渡",
                    "date": "1786/12/27"
                  }
                ],
                "__pendingResponses": [
                  {
                    "action_quote": "常青、徐嗣曾等，總須不動聲色，妥協辦理。若因外洋遇有此等案件，該督撫等紛紛調遣，跡涉張皇，轉致內地民人心生疑駭，殊有關係，該督撫不可不處以鎮定也。",
                    "doc_id": "硃94",
                    "how": "福建巡撫徐嗣曾於正月初十日接獲十二月二十七日上諭後具奏，說明其已密札漳州道府不動聲色妥為防範內地匪犯親屬與逃匪勾串。同時強調自己辦理調兵渡臺及巡防口岸等一切事宜，皆謹遵聖訓處以鎮定，絕不敢稍涉張皇以滋內地人心疑駭。",
                    "receive_date": "1787/01/10",
                    "relations": [
                      {
                        "evidence": "臣密札該道朱芫會",
                        "relation": "密札",
                        "relation_type": "command",
                        "source": "徐嗣曾",
                        "target": "朱芫會"
                      },
                      {
                        "evidence": "臣密札該道朱芫會、知府黃彬",
                        "relation": "密札",
                        "relation_type": "command",
                        "source": "徐嗣曾",
                        "target": "黃彬"
                      }
                    ],
                    "response_date": "1787/01/10",
                    "response_quote": "臣密札該道朱芫會、知府黃彬，不動聲色，妥為防範。復會同督臣出示曉諭，以賊匪雖係漳人，其在臺滋事，與原籍親屬毫無干涉。……臣仰承訓示，辦理一切，惟有事事出以鎮定，不敢稍存疏忽，亦斷不敢稍涉張皇，轉滋疑駭一俟報有剿賊實情，另行飛摺恭奏外，所有臣近日辦理情形，謹由驛恭摺具奏，伏乞皇上睿鑒。",
                    "subtitle": "徐嗣曾覆奏遵旨鎮定辦理軍務並密飭地方官不動聲色妥協防範",
                    "where": "福建省城",
                    "who": [
                      "徐嗣曾",
                      "朱芫會",
                      "黃彬"
                    ],
                    "who_loc": {
                      "徐嗣曾": "福建省城",
                      "朱芫會": "漳州",
                      "黃彬": "漳州"
                    }
                  },
