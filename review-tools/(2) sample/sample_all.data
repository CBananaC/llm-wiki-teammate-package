        "confirmedPairsOnly": true,
        "prompt": "（本機技能輸出：outputs/official-response.json）",
        "items": [
          {
            "action_quote": "著傳諭常青，楊振國等四犯解到時，即訊明起事根由，由六百里加緊據實復奏，並訊明各要犯家屬下落，密爲存記。",
            "doc_id": "硃146",
            "how": "閩浙總督常青覆奏，楊振國等四犯解到泉州時已訊明起事根由，並於正月初六日將供詞由六百里馳奏解交刑部。至要犯家屬因多在彰化及原籍，已抄摺密會提臣嚴搜密記，恪遵旨意俟剿匪事竣大兵撤回後，再行會同按名查拿辦理。",
            "receive_date": "乾隆五十二年正月二十八日",
            "relations": [
              {
                "evidence": "陳邦光拿獲賊目楊振國等四犯",
                "relation": "擒獲",
                "relation_type": "conflict",
                "source": "陳邦光",
                "target": "楊振國"
              },
              {
                "evidence": "經臣督同司、道訊明起事根由，因案關重大，即將該犯等解交刑部",
                "relation": "訊明解交",
                "relation_type": "command",
                "source": "常青",
                "target": "楊振國"
              },
              {
                "evidence": "據柴大紀稟報：瑚圖里已馳赴軍前，飭令前往桶盤棧營盤，協同遊擊蔡攀龍堵禦賊匪",
                "relation": "飭令前往協同堵禦",
                "relation_type": "command",
                "source": "柴大紀",
                "target": "瑚圖里"
              }
            ],
            "response_date": "1787/01/28",
            "response_quote": "伏查陳邦光拿獲賊目楊振國等四犯，先據解送來泉，經臣督同司、道訊明起事根由，因案關重大，即將該犯等解交刑部，再行確審，業於正月初六日繕摺錄供由六百里馳奏在案。至各犯均係生長臺灣，應坐家屬俱在彰化。臣已抄摺諮會提臣，嚴行搜捕。嗣後如有續獲要犯，其家屬住居原籍者，臣恪遵訓示，密爲存記，統俟剿匪事竣，會同提臣查拿究辦。",
            "subtitle": "常青覆奏已訊明楊振國等起事根由並遵旨密記犯屬下落俟撤兵查辦",
            "where": "泉州",
