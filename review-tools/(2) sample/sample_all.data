            "whenCh": "十二月初七日至十二月初十日",
            "whenAr": "1786/12/07",
            "who": [],
            "whoLoc": {},
            "relations": [],
            "sources": [
              {
                "doc_id": "硃78",
                "quote": "海邊一帶，已有小船數百隻浮水而來，俱係賊匪...又見遍野賊匪，竟有萬餘。黑衣黑布包頭，多執長刀，亦有槍炮，蜂擁而至。",
                "howKnown": "",
                "whenKnown": ""
              }
            ],
            "__traceChains": [
