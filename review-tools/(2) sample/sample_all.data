        "items": [
          {
            "edict_id": "諭31",
            "title": "諭閩浙總督常青等務宜鎮定妥辦不可張大其事",
            "date": "1787/01/07",
            "memDoc": "硃56",
            "memTitle": "為請酌籌加調官兵協力進剿事",
            "summary": "只保留皇帝自己的評論、答覆或命令；同義硃批與上諭合為一項。",
            "points": [
              {
                "title": "申飭閩浙總督常青等官員加調官兵過度且張皇失措並指示務宜鎮定妥辦",
                "aspect": "blame",
                "action_type": "blame",
                "how": "乾隆帝針對常青奏報加調督撫二標及福寧等營官兵共二千名渡臺、並預為挑備隨時策應等事，嚴厲申飭常青等地方大員辦理此案過於張皇失措，指出豈有因一匪犯而使全省及鄰疆皆懷恐懼之理，命令其務宜鎮定妥辦、不可張大其事。",
                "description": "乾隆帝針對常青奏報加調督撫二標及福寧等營官兵共二千名渡臺、並預為挑備隨時策應等事，嚴厲申飭常青等地方大員辦理此案過於張皇失措，指出豈有因一匪犯而使全省及鄰疆皆懷恐懼之理，命令其務宜鎮定妥辦、不可張大其事。",
                "whenCh": "乾隆五十一年十二月二十日 / 乾隆五十二年正月初七日",
                "whenAr": "1787/01/07",
                "where": "北京 / 泉州",
                "who": [
                  "乾隆帝",
                  "常青"
                ],
                "whoLoc": {
                  "乾隆帝": "北京",
                  "常青": "泉州"
                },
                "relations": [],
                "origin_doc_id": "",
                "origin_type": "",
                "origin_quote": "",
                "origin_date": "",
                "same_as_event_id": "evmr4hi2x4whu",
                "sources": [
                  {
                    "doc_id": "硃56",
                    "source_type": "硃批",
                    "quote": "看來爾等皆過於張皇矣。豈有因一匪犯，使全省以及鄰疆皆懷恐惶之理。欽此。",
                    "title": "為請酌籌加調官兵協力進剿事",
                    "date": "1787/01/07",
                    "position": "尾批"
                  }
                ],
                "__repeatId": "硃56#emperor#candidate"
              },
              {
                "title": "研判臺灣郡城防守嚴密尚無大虞並指示黃仕簡等俟官兵齊集後併力夾攻",
                "aspect": "command",
                "action_type": "command",
                "how": "乾隆帝根據常青探報澎湖兵與安平兵均已抵達臺灣府城且賊勢稍退，研判府城防守嚴密尚無大虞，指示水師提督黃仕簡等人務須等候各路官兵到齊後，約定日期同時併力夾攻以期速剿。",
                "description": "乾隆帝根據常青探報澎湖兵與安平兵均已抵達臺灣府城且賊勢稍退，研判府城防守嚴密尚無大虞，指示水師提督黃仕簡等人務須等候各路官兵到齊後，約定日期同時併力夾攻以期速剿。",
                "whenCh": "乾隆五十一年十二月二十日 / 乾隆五十二年正月初七日",
                "whenAr": "1787/01/07",
                "where": "北京 / 臺灣府城",
                "who": [
                  "乾隆帝",
                  "黃仕簡",
                  "常青"
                ],
                "whoLoc": {
                  "乾隆帝": "北京",
                  "常青": "泉州",
                  "黃仕簡": "臺灣府城"
                },
                "relations": [],
                "origin_doc_id": "",
                "origin_type": "",
                "origin_quote": "",
                "origin_date": "",
                "same_as_event_id": "evmr4hj1vaiou",
                "sources": [
                  {
                    "doc_id": "諭31",
                    "source_type": "上諭",
                    "quote": "至常青折內稱探得澎湖兵於十四日到臺郡，安平林遊擊亦帶兵赴援，現在賊勢稍退等語。郡城防守嚴密，全臺根本尚不致有他虞。黃仕簡等務須俟各路官兵到齊，約會日期，同時併力夾攻，自無難一舉蕆事，剿捕淨盡，不使惡逆竄漏網。",
                    "title": "諭閩浙總督常青等務宜鎮定妥辦不可張大其事",
                    "date": "1787/01/07"
                  },
                  {
                    "doc_id": "硃56",
                    "source_type": "奏摺",
                    "quote": "惟據差往探聽之守備林登雲稟稱：探得澎湖陳副將差蔡遊擊領兵於十四日到郡，安平林遊擊亦帶兵赴援，現在賊勢稍退。",
                    "title": "為請酌籌加調官兵協力進剿事",
                    "date": "1787/01/07"
                  }
                ],
                "__pendingResponses": [
                  {
                    "action_quote": "黃仕簡等務須俟各路官兵到齊，約會日期，同時併力夾攻，自無難一舉蕆事，剿捕淨盡，不使惡逆竄漏網。",
                    "doc_id": "硃130",
                    "how": "常青於正月十九日接奉正月初七日上諭後，於次日具摺覆奏。報告水師提督黃仕簡與陸路提督任承恩已分別於正月初四日及初六日抵臺，水陸官兵正會齊並約定於十二、十三等日長驅會剿，符合皇帝切勿零星打仗、應併力夾攻之指示；同時稟報郡城防守穩固、民情安堵。",
                    "receive_date": "乾隆五十二年正月十九日",
