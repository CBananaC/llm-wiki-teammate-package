            "actor": "qing",
            "category": "nonmil",
            "subtitle": "程必大攜帶關防至泉州求救",
            "description": "署淡水同知程峻之子程必大於十二日攜帶淡防同知關防改裝內渡，抵達泉州向官方求救。",
            "where": "泉州",
            "whenCh": "十二月十二日",
            "whenAr": "1786/12/12",
            "who": [
              "程必大"
            ],
            "whoLoc": {
              "程必大": "泉州"
