            "points": [
              {
                "title": "認可徐嗣曾嚴飭沿海口岸巡防之舉並命督撫嚴防賊匪偷越內渡",
                "aspect": "command",
                "action_type": "command",
                "how": "乾隆帝高度肯定徐嗣曾嚴飭沿海口岸巡防以防賊匪竄逸之部署，於奏摺相關處批示「此為最要」，並於上諭中指示常青等督撫嚴飭沿海口岸地方文武官員實力巡防，防範餘匪偷越內渡。",
                "description": "乾隆帝高度肯定徐嗣曾嚴飭沿海口岸巡防以防賊匪竄逸之部署，於奏摺相關處批示「此為最要」，並於上諭中指示常青等督撫嚴飭沿海口岸地方文武官員實力巡防，防範餘匪偷越內渡。",
                "whenCh": "乾隆五十一年十二月二十七日",
                "whenAr": "1786/12/27",
                "where": "北京",
                "who": [
                  "乾隆帝",
                  "徐嗣曾",
                  "常青",
                  "任承恩"
                ],
                "whoLoc": {
                  "任承恩": "蚶江",
                  "常青": "蚶江",
                  "徐嗣曾": "福州"
                },
                "relations": [],
                "origin_doc_id": "",
                "origin_type": "",
                "origin_quote": "",
                "origin_date": "",
                "same_as_event_id": "evmr204g8786x",
                "sources": [
                  {
                    "doc_id": "諭13",
                    "source_type": "上諭",
                    "quote": "但恐餘黨四散逸，或偷越內渡。常青、任承恩現住蚶江一帶，著嚴飭沿海口岸地方文武員，實力巡防。如有竄逸餘匪，即行擒獲審辦，最爲緊要。",
                    "title": "諭閩浙總督常青等嚴行殲戮林爽文等並防餘衆四散內渡",
                    "date": "1786/12/27"
                  },
                  {
                    "doc_id": "硃24",
                    "source_type": "奏摺",
                    "quote": "臣現在嚴飭沿海口岸，實力徼巡，防其竄逸",
                    "title": "為奏接鎮道文報並派遣省兵赴臺事",
                    "date": "1786/12/27"
                  }
                ],
                "__repeatId": "諭13#emperor#candidate",
                "__added": true,
                "__evId": "evms02iv4sy3j"
              },
              {
                "title": "指示黃仕簡查明諸羅官兵剿殺二千餘賊傳聞並核實加恩獎勵",
                "aspect": "command",
                "action_type": "command",
                "how": "乾隆帝針對徐嗣曾奏報傳聞官兵於諸羅殺死二千餘賊一事，讚許該地方文武辦理尚好，並命令黃仕簡赴臺後立即查明實情，若屬實應分析帶兵及出力官兵名單具奏以備加恩獎勵。",
                "description": "乾隆帝針對徐嗣曾奏報傳聞官兵於諸羅殺死二千餘賊一事，讚許該地方文武辦理尚好，並命令黃仕簡赴臺後立即查明實情，若屬實應分析帶兵及出力官兵名單具奏以備加恩獎勵。",
                "whenCh": "乾隆五十一年十二月二十七日",
                "whenAr": "1786/12/27",
                "where": "北京",
                "who": [
                  "乾隆帝",
                  "黃仕簡",
                  "徐嗣曾"
                ],
                "whoLoc": {
                  "徐嗣曾": "福州",
                  "黃仕簡": "臺灣"
                },
                "relations": [],
                "origin_doc_id": "",
                "origin_type": "",
                "origin_quote": "",
                "origin_date": "",
                "same_as_event_id": "",
                "sources": [
                  {
                    "doc_id": "諭13",
                    "source_type": "上諭",
                    "quote": "賊匪率衆擾諸羅，即被官兵殺死二千餘名。該地方文武，所辦尚好，著黃仕簡前往該處，即行查明。如果屬實，將帶兵剿殺賊匪者系屬何人，並首先出力之員及兵丁，分析具，候朕酌量加恩，以示獎勵。",
                    "title": "諭閩浙總督常青等嚴行殲戮林爽文等並防餘衆四散內渡",
                    "date": "1786/12/27"
                  },
                  {
                    "doc_id": "硃24",
                    "source_type": "奏摺",
                    "quote": "又聽人傳說，賊人赴諸羅縣攻城，被官兵殺死二千餘人。",
                    "title": "為奏接鎮道文報並派遣省兵赴臺事",
                    "date": "1786/12/27"
                  }
                ],
                "__repeatId": "諭13#emperor#candidate",
                "__added": true,
                "__evId": "evms02j4uyaz5"
              },
              {
                "title": "定性彰化知縣俞峻在大墩搜捕賊匪係因公被害並交部議恤",
                "aspect": "command",
                "action_type": "command",
                "how": "乾隆帝就徐嗣曾奏報彰化知縣俞峻帶兵搜捕遇害事宜進行批示，指出俞峻雖防範疏懈，但屬因公倉猝被害，命令督撫查明其平日無劣跡後據實奏聞交部議恤。",
                "description": "乾隆帝就徐嗣曾奏報彰化知縣俞峻帶兵搜捕遇害事宜進行批示，指出俞峻雖防範疏懈，但屬因公倉猝被害，命令督撫查明其平日無劣跡後據實奏聞交部議恤。",
                "whenCh": "乾隆五十一年十二月二十七日",
                "whenAr": "1786/12/27",
                "where": "北京",
                "who": [
                  "乾隆帝",
                  "俞峻",
                  "常青",
                  "徐嗣曾"
                ],
                "whoLoc": {
                  "俞峻": "彰化",
                  "常青": "蚶江",
                  "徐嗣曾": "福州"
                },
                "relations": [],
                "origin_doc_id": "",
                "origin_type": "",
                "origin_quote": "",
                "origin_date": "",
                "same_as_event_id": "evmrbqyiq48b3",
                "sources": [
                  {
                    "doc_id": "諭13",
                    "source_type": "上諭",
                    "quote": "再，彰化知縣會同副將前往各莊搜捕，賊匪俱已逃竄。嗣又散而復聚，竟有數千人，已致被害。該縣於搜捕賊匪後，不能嚴密防範，雖失之疏懈，但帶兵緝犯，事屬因公，倉猝被害，尚非激變者可比。並著該督撫查明該縣，如平日並無別項劣跡及激變情事，即據實奏聞，候朕降旨交部議恤。",
                    "title": "諭閩浙總督常青等嚴行殲戮林爽文等並防餘衆四散內渡",
                    "date": "1786/12/27"
                  },
                  {
                    "doc_id": "硃24",
                    "source_type": "奏摺",
                    "quote": "俞知縣同赫副將、耿遊擊帶兵駐扎離縣城三十里之大墩汛地，前往各莊搜捕，賊匪俱已逃竄。二十八日辰刻，忽聞二十七日夜四更時候，賊匪散而復聚，竟有數千人往劫大墩營盤。",
                    "title": "為奏接鎮道文報並派遣省兵赴臺事",
                    "date": "1786/12/27"
                  }
                ],
                "__repeatId": "諭13#emperor#candidate"
