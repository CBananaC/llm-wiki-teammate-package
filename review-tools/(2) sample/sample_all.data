                "sources": [
                  {
                    "doc_id": "硃64",
                    "source_type": "硃批",
                    "quote": "皆當優獎",
                    "title": "為招募義民實力防守及發兵渡臺情形事",
                    "date": "1787/01/10",
                    "position": "夾批",
                    "context_quote": "守備董得魁、把總蘇升等帶領義民五百名，由艋舺渡河，直攻下莊，至草店尾大街；都司同千總席榮等，帶兵三百名，由草店尾河坡先斷浮橋，進攻國王廟邊；李因、鄭追、李明、黃挽等督率義民五百名，由武朥灣進攻中港厝；監生黃朝陽、林講、徐修等"
                  },
                  {
                    "doc_id": "硃64",
                    "source_type": "硃批",
                    "quote": "亦當旌賞",
                    "title": "為招募義民實力防守及發兵渡臺情形事",
                    "date": "1787/01/10",
                    "position": "夾批",
                    "context_quote": "又廣省義民邱龍四、林貴陽等"
                  },
                  {
                    "doc_id": "硃64",
                    "source_type": "硃批",
                    "quote": "皆應賞恤",
                    "title": "為招募義民實力防守及發兵渡臺情形事",
                    "date": "1787/01/10",
                    "position": "夾批",
                    "context_quote": "埋伏彭厝莊，四面攻殺，槍炮齊發，殺死賊匪五十餘人，奪得大旗兩杆，小旗一枝，黃彩一匹，並起告白、告示各一紙，義民亦被害數十人"
                  },
                  {
                    "doc_id": "諭38",
                    "source_type": "上諭",
                    "quote": "至該處生監及本處並廣東商民，激發公義，志切同仇，共相糾衆，攻殺賊匪，保護地方，實堪嘉獎。著該督等查明，分別連賞，以示優獎。其義民內有被賊傷害者，並著該督等於事竣後，查明具奏，照陣亡兵丁之例，一體議恤。",
                    "title": "諭內閣嘉獎捕殺吳異人等出力人員",
                    "date": "1787/01/10"
                  }
                ],
                "__repeatId": "硃64#emperor#candidate"
              },
              {
                "title": "體諒黃仕簡與任承恩因風浪受阻未能遄渡並指示不可涉險輕進",
                "aspect": "command",
                "action_type": "command",
                "how": "乾隆帝針對常青奏報水陸兩提督因風暴受阻無法開駕渡海一事，指出此屬無可奈何，指示切不可涉險輕進，俟風順後再行飛渡。",
                "description": "乾隆帝針對常青奏報水陸兩提督因風暴受阻無法開駕渡海一事，指出此屬無可奈何，指示切不可涉險輕進，俟風順後再行飛渡。",
                "whenCh": "乾隆五十二年正月初十日",
                "whenAr": "1787/01/10",
                "where": "北京",
                "who": [
                  "乾隆帝",
                  "黃仕簡",
                  "任承恩",
                  "常青"
                ],
                "whoLoc": {
                  "乾隆帝": "北京",
                  "任承恩": "蚶江",
                  "常青": "泉州",
                  "黃仕簡": "金門"
                },
                "relations": [],
                "origin_doc_id": "",
                "origin_type": "",
                "origin_quote": "",
                "origin_date": "",
                "same_as_event_id": "",
                "sources": [
                  {
                    "doc_id": "硃64",
                    "source_type": "硃批",
                    "quote": "此亦無可奈何，不可涉險",
                    "title": "為招募義民實力防守及發兵渡臺情形事",
                    "date": "1787/01/10",
                    "position": "夾批",
                    "context_quote": "等因"
                  },
                  {
                    "doc_id": "諭40",
                    "source_type": "上諭",
                    "quote": "黃仕簡、任承恩所帶之兵，因守風未能遄渡，此亦無可如何，不可涉險輕進。",
                    "title": "諭閩浙總督常青不可泄漏調任消息並勿稍存觀望",
                    "date": "1787/01/10"
                  },
                  {
                    "doc_id": "硃64",
                    "source_type": "奏摺",
                    "quote": "二十日復起風暴，連日猛烈，難以放洋。一俟風定，立即飛渡，不敢耽延時日，致誤軍務。等因",
                    "title": "為招募義民實力防守及發兵渡臺情形事",
                    "date": "1787/01/10"
                  }
                ],
                "__repeatId": "硃64#emperor#candidate"
              },
              {
                "title": "否決常青密為挑備後續策應兵力之請並指示大兵會剿已足無須另行辦理",
                "aspect": "reject",
                "action_type": "reject",
                "how": "乾隆帝認為大兵渡臺會剿足以平定烏合之眾，對常青提出密為挑備兵力以資策應之建議，明確批示可以無需辦理。",
                "description": "乾隆帝認為大兵渡臺會剿足以平定烏合之眾，對常青提出密為挑備兵力以資策應之建議，明確批示可以無需辦理。",
                "whenCh": "乾隆五十二年正月初十日",
                "whenAr": "1787/01/10",
                "where": "北京",
                "who": [
