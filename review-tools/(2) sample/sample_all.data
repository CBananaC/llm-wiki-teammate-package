                "relations": [],
                "same_as_event_id": "",
                "target": [
                  "常青"
                ],
                "quote": "看來常青此次所奏派兵剿捕各事宜，較從前稍有主見，略知鎮定，朕始覺稍紓廑念。",
                "sources": [
                  {
                    "doc_id": "諭24",
                    "source_type": "上諭",
                    "quote": "看來常青此次所奏派兵剿捕各事宜，較從前稍有主見，略知鎮定，朕始覺稍紓廑念。",
                    "title": "諭閩浙總督常青等總須鎮定持重並俟兵丁到齊約期夾攻",
