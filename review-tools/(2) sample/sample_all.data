                "__pendingResponses": [
                  {
                    "action_quote": "但恐餘黨四散逸，或偷越內渡。常青、任承恩現住蚶江一帶，著嚴飭沿海口岸地方文武員，實力巡防。",
                    "doc_id": "硃94",
                    "how": "福建巡撫徐嗣曾親自前往五虎門等沿海口岸履勘，並在汛兵單少之處增派省標兵二百名駐防。同時，他飛咨水陸提臣於沿海汊港搜捕並燒毀賊船，並密札漳州道府官員妥為防範，嚴防賊匪潛逃回籍。",
                    "receive_date": "1787/01/10",
                    "relations": [
                      {
                        "evidence": "臣密札該道朱芫會、知府黃彬，不動聲色，妥為防範",
                        "relation": "密札",
                        "relation_type": "command",
                        "source": "徐嗣曾",
                        "target": "朱芫會"
                      },
                      {
                        "evidence": "臣密札該道朱芫會、知府黃彬，不動聲色，妥為防範",
                        "relation": "密札",
                        "relation_type": "command",
                        "source": "徐嗣曾",
                        "target": "黃彬"
                      }
                    ],
                    "response_date": "1787/01/10",
                    "response_quote": "特恐剿捕之時，竄匿亡命，勢所必有。若逃入臺地內山，官兵長圍攻逼，搜拿不悉不淨。惟海洋瞬息千里，倘賊匪竄逸內渡，防緝稍有未周，或恐漏網。……臣現已飛咨水陸提臣及領兵鎮將，一面剿殺賊匪，一面即於沿海汊港搜拿賊船，先行燒沉淨盡。至內地沿海口岸，先已添撥兵丁，協同截捕。臣發諭地方官弁，以疏漏一名，罪同縱賊，使各屬共知警惕。",
                    "subtitle": "徐嗣曾巡視沿海口岸並增兵嚴防賊匪內渡",
                    "where": "五虎門",
                    "who": [
                      "徐嗣曾",
                      "朱芫會",
                      "黃彬"
                    ],
                    "who_loc": {
                      "徐嗣曾": "省城",
                      "朱芫會": "漳州",
                      "黃彬": "漳州"
                    }
                  },
                  {
                    "action_quote": "常青、任承恩現住蚶江一帶，著嚴飭沿海口岸地方文武員，實力巡防。如有竄逸餘匪，即行擒獲審辦，最爲緊要。",
                    "doc_id": "硃105",
                    "how": "閩浙總督常青遵旨嚴飭沿海口岸文武員弁實力巡查，以防賊匪偷越內渡。隨後接獲漳浦縣知縣羅澤坤稟報，已成功盤獲匪犯陳樵一名，現正飭令提解確鑿審究。",
                    "receive_date": "1787/01/11",
                    "relations": [
                      {
                        "evidence": "已據漳浦縣羅澤坤稟報，盤獲匪犯陳樵一名",
