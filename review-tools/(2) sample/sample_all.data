    {
      "id": "evmrx9splil85",
      "actor": "emperor",
      "subtitle": "皇帝嚴厲申飭總督常青等官員在面對臺灣林爽文起事時張皇失措、過度畏懼",
      "description": "皇帝嚴厲申飭總督常青等官員在面對臺灣林爽文起事時張皇失措、過度畏懼，並指示常青應以鎮靜內地為要，駐紮蚶江、廈門一帶調度策應。\n只保留皇帝自己的評論、答覆或命令；同義硃批與上諭合為一項。",
      "what": "皇帝嚴厲申飭總督常青等官員在面對臺灣林爽文起事時張皇失措、過度畏懼",
      "where": "北京",
      "who": [
        "常青",
        "黃仕簡",
        "任承恩"
      ],
      "whoLoc": {},
      "relations": [
        "常青",
        "黃仕簡",
        "任承恩"
      ],
      "provenance": [],
      "whenCh": "乾隆五十一年十二月二十九日",
      "dateAr": "1786/12/29",
      "sources": [
        {
          "doc_id": "硃35",
          "quote": "總以鎮靜內地為要。看爾等俱屬張皇失措，為此朕卻牽念，臺灣常有此等事。此次何致爾等如是張皇畏懼",
          "label": "皇帝嚴厲申飭總督常青等官員在面對臺灣林爽文起事時張皇失措、過度畏懼",
          "howKnown": "硃批"
        }
      ],
      "hidden": false,
      "emperorDetail": {
        "kind": "edict",
        "aspect": "blame",
        "edict_title": "為奏臺灣北路形勢及酌籌防護郡城事",
        "edict_id": "",
        "date": "1786/12/29",
        "memorial_quote": "總以鎮靜內地為要。看爾等俱屬張皇失措，為此朕卻牽念，臺灣常有此等事。此次何致爾等如是張皇畏懼",
        "memorial_position": "夾批",
        "memorial_context_quote": "臣於泉州、蚶江、廈門等處，往來督察，相機調度",
        "edict_quote": "",
        "how": "皇帝嚴厲申飭總督常青等官員在面對臺灣林爽文起事時張皇失措、過度畏懼，並指示常青應以鎮靜內地為要，駐紮蚶江、廈門一帶調度策應。",
        "memDoc": "硃35",
        "memTitle": "為奏臺灣北路形勢及酌籌防護郡城事"
      }
    },
    {
      "id": "evmrx9stpt2g8",
      "actor": "emperor",
      "subtitle": "指示任承恩既已渡臺須實力勇往速擒凶匪",
      "description": "皇帝指出陸路提督任承恩本不應親自渡臺，但既然已經前往，便不須拘泥回任，務必實力勇往、速擒凶匪。\n只保留皇帝自己的評論、答覆或命令；同義硃批與上諭合為一項。",
      "what": "指示任承恩既已渡臺須實力勇往速擒凶匪",
      "where": "北京",
      "who": [
