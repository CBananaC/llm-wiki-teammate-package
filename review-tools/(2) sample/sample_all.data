        "items": [
          {
            "actor": "lin",
            "category": "done",
            "subtitle": "賊匪以濕棉被遮牛車攻打大營",
            "description": "十二月十一日，叛軍數萬人復來進攻清軍大營，將透濕棉被遮蓋於牛車上遮擋槍炮，持長槍半截刀隨後推進，經清軍重炮擊破後始散退。",
            "where": "鹽埕橋大營",
            "whenCh": "十二月十一日",
            "whenAr": "1786/12/11",
            "who": [],
            "whoLoc": {},
            "relations": [],
            "sources": [
              {
                "doc_id": "硃78",
                "quote": "於十一日卯刻，復來攻大營...賊以棉被透濕，遮牛車上，向前當我槍炮，長槍、半截刀在後...數萬蜂擁復來",
                "howKnown": "",
                "whenKnown": ""
              }
            ],
            "__traceChains": [
              {
                "events": [
                  {
                    "quote": "於十一日卯刻，復來攻大營，即率弁兵，與賊再戰。賊以棉被透濕，遮牛車上，向前當我槍炮，長槍、半截刀在後，牌槍鉛子不能入，施放大炮，始能打透，牛車不能抵當。",
                    "reporter": "柴大紀",
                    "subtitle": "賊匪以濕棉被遮牛車攻打大營",
                    "whenCh": "十二月十一日",
                    "where": "鹽埕橋大營"
                  }
                ],
                "hops": [
                  {
                    "doc_id": "硃78",
                    "from_person": "柴大紀",
                    "how": "奏聞",
                    "inferred": false,
                    "layer": 1,
                    "place": "",
                    "quote": "奴才柴大紀謹奏，為鹽埕打仗連日得勝，恭摺奏聞事。本年十一月二十七、八等日，彰化縣屬大里杙奸民林爽文、王芬等，猝起劫營，攻破彰城。",
                    "to_person": "皇上",
                    "whenAr": "1786/12/14",
                    "whenCh": "十二月十四日"
                  }
                ]
              }
            ],
            "__repeatId": "硃78#lin#candidate"
          }
        ],
