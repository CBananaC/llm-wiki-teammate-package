        "items": [
          {
            "edict_id": "諭24",
            "title": "諭閩浙總督常青等總須鎮定持重並俟兵丁到齊約期夾攻",
            "date": "1787/01/02",
            "summary": "只保留皇帝自己的評論、答覆或命令；同義硃批與上諭合為一項。",
            "memDoc": "硃41",
            "memTitle": "為臺灣鎮道稟報彰化淡水失陷及增派援兵事",
            "sourceKind": "上諭",
            "points": [
              {
                "title": "乾隆皇帝對常青所奏的派兵部署表示肯定，認為其較以往稍有主見",
                "aspect": "command",
                "action_type": "command",
                "how": "乾隆皇帝對常青所奏的派兵部署表示肯定，認為其較以往稍有主見，並針對漳泉民人的對待方式、水陸提督的進剿策略、柴大紀的防守勉勵以及事後追責時機等進行了具體指示。",
                "description": "乾隆皇帝對常青所奏的派兵部署表示肯定，認為其較以往稍有主見，並針對漳泉民人的對待方式、水陸提督的進剿策略、柴大紀的防守勉勵以及事後追責時機等進行了具體指示。",
                "whenCh": "乾隆五十二年正月初二日",
                "whenAr": "1787/01/02",
                "where": "北京",
                "who": [
                  "乾隆帝"
                ],
                "whoLoc": {
                  "乾隆帝": "北京"
                },
                "relations": [],
                "memorial_relation": "direct",
                "relevance_reason": "本奏摺中常青報告了其派兵進剿、防範等部署，乾隆帝對此表示肯定，但仍告誡其必須鎮定持重。",
                "memorial_anchor": "",
                "memorial_quote": "",
                "memorial_position": "",
                "memorial_context_quote": "",
                "edict_quote": "看來常青此次所奏派兵剿捕各事宜，較從前稍有主見，略知鎮定，朕始覺稍紓廑念。",
                "sources": [
                  {
                    "doc_id": "諭24",
                    "source_type": "上諭",
                    "position": "",
                    "quote": "看來常青此次所奏派兵剿捕各事宜，較從前稍有主見，略知鎮定，朕始覺稍紓廑念。",
                    "context_quote": "",
                    "title": "諭閩浙總督常青等總須鎮定持重並俟兵丁到齊約期夾攻",
                    "date": "1787/01/02"
                  },
                  {
                    "doc_id": "諭24",
                    "source_type": "上諭",
                    "position": "",
                    "quote": "該督等總須鎮定持重，不可稍涉張皇。",
                    "context_quote": "",
                    "title": "諭閩浙總督常青等總須鎮定持重並俟兵丁到齊約期夾攻",
                    "date": "1787/01/02"
                  }
                ],
                "doc_id": "硃41",
                "card_id": "硃41#emperor#30",
