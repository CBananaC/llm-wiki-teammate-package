                    "actor": "qing"
                  }
                ],
                "hops": [
                  {
                    "doc_id": "硃35",
                    "from_person": "泉州府知府王右弼、晉江縣知縣徐夢麟",
                    "how": "稟報",
                    "inferred": false,
                    "layer": 1,
                    "place": "泉州",
                    "quote": "十二月十三日夜，自涂嶺拜摺後，旋於惠安途次接據泉州府知府王右弼、晉江縣知縣徐夢麟稟稱...理合稟報。等由到臣。",
                    "to_person": "閩浙總督常青",
                    "whenAr": "",
                    "whenCh": ""
                  },
                  {
                    "doc_id": "硃35",
                    "from_person": "程必大",
                    "how": "口述",
                    "inferred": false,
                    "layer": 2,
                    "place": "泉州",
                    "quote": "十二日有署淡水同知程峻之子程必大，懷取淡防同知關防，赴泉求救...當即隨同陸路提督傳詢。據程必大供稱：父親程峻現署淡水同知，駐紮竹塹。因彰化賊匪滋事，我父親會同董守備，帶領兵役鄉勇，赴中港地方堵禦。賊匪眾多，抵敵不住，我父親存亡不知。賊匪于十初七日已到竹塹，四行搶擄，我恐印信被他搶去，又因彰化地方已被賊踞，不能前往府城，只得帶印改裝，跑到八里坌內渡求救的。",
                    "to_person": "泉州府知府王右弼、晉江縣知縣徐夢麟、陸路提督",
                    "whenAr": "1786/12/12",
                    "whenCh": "十二月十二日"
                  }
                ]
              },
              {
                "events": [
                  {
                    "quote": "竹塹程同知、董守備，帶兵並鄉勇往中港堵禦",
                    "reporter": "守備林登雲",
                    "subtitle": "程峻等帶兵防禦中港",
                    "whenCh": "十一月至十二月初七日以前",
                    "where": "中港",
                    "actor": "qing"
                  }
                ],
                "hops": [
                  {
                    "doc_id": "硃35",
                    "from_person": "守備林登雲",
                    "how": "稟報",
                    "inferred": false,
                    "layer": 1,
                    "place": "",
                    "quote": "又接據臣差往探信之守備林登雲稟報：探得十一月二十七夜，彰化俞知縣同北協赫副將、臺鎮中營耿遊擊，被匪徒攔路截殺，攻破彰化縣，踞住城池。又聞得竹塹程同知、董守備，帶兵並鄉勇往中港堵禦，於本月初七日亦被賊殺散。等語。",
                    "to_person": "閩浙總督常青",
                    "whenAr": "",
                    "whenCh": ""
                  }
                ]
              },
