              }
            ],
            "sources": [
              {
                "doc_id": "硃82",
                "quote": "二十九日即劫彰化縣城。因存兵無多，被賊攻入。孫知府並理番同知長庚、前署彰化縣事俸滿臺防同知劉亨基、署典史事鹿港巡檢馮啟宗、北協中營王都司及弁兵數十人，俱被殺害。",
                "howKnown": "",
                "whenKnown": ""
              }
            ],
            "__traceChains": [
              {
                "events": [
                  {
                    "quote": "二十九日即劫彰化縣城。因存兵無多，被賊攻入。孫知府並理番同知長庚、前署彰化縣事俸滿臺防同知劉亨基、署典史事鹿港巡檢馮啟宗、北協中營王都司及弁兵數十人，俱被殺害。",
                    "reporter": "署鹿仔港守備陳邦光",
                    "subtitle": "匪徒攻陷彰化縣城",
                    "whenCh": "十一月二十九日",
                    "where": "彰化縣城"
