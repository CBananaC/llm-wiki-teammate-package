                    "quote": "其沿海一帶，飭臺協中營守備林球帶兵二百名，把守三鯤身。右營署備千總張時泰，駕船把守港口，並提標、金門等標，載班兵哨船六隻，俱飭駛至大港協守",
                    "reporter": "柴大紀",
                    "subtitle": "柴大紀部署沿海港口水師",
                    "whenCh": "",
                    "where": "三鯤身"
                  }
                ],
                "hops": [
                  {
                    "doc_id": "硃128",
                    "from_person": "柴大紀",
                    "how": "奏聞",
                    "inferred": false,
                    "layer": 1,
                    "place": "郡城",
                    "quote": "福建臺灣鎮總兵官奴才柴大紀謹奏，為調度水陸官兵四面守禦，力保郡城，待應援以圖恢復，恭摺奏聞事...自本月初九至十三等日，與賊大戰，連日得勝，殺退賊匪數萬...謹奏。乾隆五十一年十二月二十一日",
                    "to_person": "乾隆帝",
                    "whenAr": "1786/12/21",
                    "whenCh": "乾隆五十一年十二月二十一日"
                  }
                ]
              }
            ],
            "__repeatId": "硃128#qing#candidate"
          }
