                "same_as_event_id": "",
                "sources": [
                  {
                    "doc_id": "硃35",
                    "source_type": "硃批",
                    "quote": "任承恩本不應去，今既已親往，須實力勇往，速擒獲凶匪，勉之毋忽",
                    "title": "為奏臺灣北路形勢及酌籌防護郡城事",
                    "date": "1786/12/29",
                    "position": "夾批",
                    "context_quote": "隨與提臣任承恩悉心籌劃，即將提標挑出精兵一千二百名，先由該提臣統領"
                  },
                  {
                    "doc_id": "諭20",
                    "source_type": "上諭",
                    "quote": "任承恩本不應前往，今既已渡臺，亦不須拘泥回任，務須實力勇往，會同黃仕簡分路夾攻，速擒兇匪，以期剋日功速回。",
                    "title": "諭閩浙總督常青等鎮定妥辦不必紛紛赴臺",
                    "date": "1786/12/29"
                  },
                  {
                    "doc_id": "硃35",
                    "source_type": "奏摺",
                    "quote": "隨與提臣任承恩悉心籌劃，即將提標挑出精兵一千二百名，先由該提臣統領",
                    "title": "為奏臺灣北路形勢及酌籌防護郡城事",
                    "date": "1786/12/29"
                  }
                ],
                "__pendingResponses": [
                  {
                    "action_quote": "任承恩本不應前往，今既已渡臺，亦不須拘泥回任，務須實力勇往，會同黃仕簡分路夾攻，速擒兇匪，以期剋日功速回。",
                    "doc_id": "硃110",
                    "how": "閩浙總督常青奉旨後自責罔識遵循、未審輕重致任承恩親自渡臺。常青表示遵照諭旨，待任承恩會同水師提督黃仕簡殲滅逆匪蕆事後，即督令其迅速返回內地防守，自己則留駐蚶江、廈門一帶鎮靜調度。",
                    "receive_date": "乾隆五十二年正月十二日",
                    "relations": [
                      {
                        "evidence": "今任承恩既已渡臺，即遵旨俟其同黃仕簡殲匪蕆事，即行速回",
                        "relation": "遵旨飭令",
                        "relation_type": "command",
                        "source": "常青",
                        "target": "任承恩"
                      },
                      {
                        "evidence": "同黃仕簡殲匪蕆事",
                        "relation": "會同",
                        "relation_type": "ally",
                        "source": "任承恩",
                        "target": "黃仕簡"
                      }
                    ],
                    "response_date": "乾隆五十二年正月十三日",
                    "response_quote": "既有提臣黃仕簡帶兵，而任承恩又復親往，殊失事理之輕重。況從前臺匪朱一貴滋擾一案，辦理迅速，成效可稽。臣罔識遵循，未得肯綮，一經聖明指示周詳，不勝愧悚之至。今任承恩既已渡臺，即遵旨俟其同黃仕簡殲匪蕆事，即行速回，總以內地為緊要。",
                    "subtitle": "常青遵旨自責失察任承恩渡臺並命其會同黃仕簡速平臺匪後即刻回內地",
