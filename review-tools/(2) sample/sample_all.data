        "items": [
          {
            "edict_id": "諭36",
            "title": "諭閩浙總督常青等巡撫徐嗣曾越制徵調殊屬矜張著傳旨申飭",
            "date": "1787/01/08",
            "memDoc": "硃59",
            "memTitle": "為准咨奏明調撥各路兵丁情形事",
            "summary": "只保留皇帝自己的評論、答覆或命令；同義硃批與上諭合為一項。",
            "points": [
              {
                "title": "批評常青與徐嗣曾因溝通不及重複調派副將徐鼎士致使兵無所適從，並申飭徐嗣曾越權發兵",
                "aspect": "blame",
                "action_type": "blame",
                "how": "乾隆帝指責閩浙總督常青與福建巡撫徐嗣曾因距離遙遠、關會不及，同時調派副將徐鼎士帶兵渡臺，致使軍隊無所適從，辦理過涉張皇；並申飭徐嗣曾未先會商總督即擅自調動省城兵力赴援，屬於越權之舉。",
                "description": "乾隆帝指責閩浙總督常青與福建巡撫徐嗣曾因距離遙遠、關會不及，同時調派副將徐鼎士帶兵渡臺，致使軍隊無所適從，辦理過涉張皇；並申飭徐嗣曾未先會商總督即擅自調動省城兵力赴援，屬於越權之舉。",
                "whenCh": "乾隆五十二年正月初八日",
                "whenAr": "1787/01/08",
                "where": "",
                "who": [
                  "常青",
                  "徐嗣曾",
                  "徐鼎士"
                ],
                "whoLoc": {
                  "常青": "泉州",
                  "徐嗣曾": "福州",
                  "徐鼎士": "福建"
                },
                "relations": [
                  "常青與徐嗣曾同時調派徐鼎士"
                ],
                "origin_doc_id": "",
                "origin_type": "",
                "origin_quote": "",
                "origin_date": "",
                "same_as_event_id": "evmr4m4u9pu7k",
                "sources": [
                  {
                    "doc_id": "硃59",
                    "source_type": "硃批",
                    "quote": "已有旨了。欽此。",
                    "title": "為准咨奏明調撥各路兵丁情形事",
                    "date": "1787/01/08",
                    "position": "尾批"
                  },
                  {
                    "doc_id": "諭36",
                    "source_type": "上諭",
                    "quote": "看來伊等辦理此事，皆不免過涉張皇。而徐嗣曾於未接督臣會之先，即行調發，固屬急公，略近越俎，已於折內批示。",
                    "title": "諭閩浙總督常青等巡撫徐嗣曾越制徵調殊屬矜張著傳旨申飭",
                    "date": "1787/01/08"
                  },
                  {
                    "doc_id": "硃59",
                    "source_type": "奏摺",
                    "quote": "惟是臣續調之督、撫二標兵一千名，已派令副將徐鼎士帶領，而撫臣所調之督、撫二標兵一千五百名，據稱亦派該將帶領，實緣省城距泉相隔數百里，同時調派，以致關會不及。",
                    "title": "為准咨奏明調撥各路兵丁情形事",
                    "date": "1787/01/08"
                  }
                ],
                "__repeatId": "硃59#emperor#candidate",
                "__added": true,
                "__evId": "evms048q9wmhf"
              },
              {
                "title": "重申全省兵力調遣應由總督主政之國家體制，命令巡撫徐嗣曾鎮靜地方並專力籌辦軍需糧餉",
                "aspect": "command",
                "action_type": "command",
                "how": "乾隆帝嚴正強調國家體制不可紊越，全省兵力調遣屬於總督權責，巡撫遇有事變應鎮靜地方、妥籌軍需糧餉以資接濟，不得一聞稟報即擅自動用各營兵丁。",
                "description": "乾隆帝嚴正強調國家體制不可紊越，全省兵力調遣屬於總督權責，巡撫遇有事變應鎮靜地方、妥籌軍需糧餉以資接濟，不得一聞稟報即擅自動用各營兵丁。",
                "whenCh": "乾隆五十二年正月初八日",
                "whenAr": "1787/01/08",
                "where": "",
                "who": [
                  "常青",
                  "徐嗣曾"
                ],
                "whoLoc": {
                  "常青": "泉州",
                  "徐嗣曾": "福州"
                },
                "relations": [
                  "總督統轄營制主政調兵"
                ],
                "origin_doc_id": "",
                "origin_type": "",
                "origin_quote": "",
                "origin_date": "",
                "same_as_event_id": "evmr4i9uovo3k",
                "sources": [
                  {
                    "doc_id": "諭36",
                    "source_type": "上諭",
                    "quote": "總督統轄營制，全省兵棄，凡有調遣，自應聽督臣主政。至巡撫遇有此等事件，理應鎮靜地方，將軍需糧餉等務，妥爲籌備，以資接濟。若一聞稟報，即行調動各營兵丁，而派出帶兵之員，督臣又經檄調，轉致兵無所適從。雖巡撫有封疆之責，原不得稍存膜視，但調發兵棄，自應札商督臣，公同檄調，況無迫不及待之情形也。此乃國家體制，不可紊越。",
                    "title": "諭閩浙總督常青等巡撫徐嗣曾越制徵調殊屬矜張著傳旨申飭",
                    "date": "1787/01/08"
                  },
                  {
                    "doc_id": "硃59",
                    "source_type": "奏摺",
                    "quote": "該撫臣就省撥兵前往淡北赴援，並諮浙江、廣東二省預備策應，籌劃極為周密。",
                    "title": "為准咨奏明調撥各路兵丁情形事",
                    "date": "1787/01/08"
                  }
                ],
                "__repeatId": "諭36#emperor#candidate",
                "__added": true,
                "__evId": "evms049j1npux"
              },
              {
                "title": "申飭福建巡撫徐嗣曾跨省諮會廣東浙江挑備戰兵係屬過度張皇，指示應維持軍令統一",
                "aspect": "blame",
                "action_type": "blame",
                "how": "乾隆帝斥責福建巡撫徐嗣曾因恐被指推諉而紛紛徵發，並跨省諮會浙江、廣東兩省挑備戰兵，實屬過度張皇且使本省兵弁號令兩歧、事權不一，特傳旨予以申飭。",
                "description": "乾隆帝斥責福建巡撫徐嗣曾因恐被指推諉而紛紛徵發，並跨省諮會浙江、廣東兩省挑備戰兵，實屬過度張皇且使本省兵弁號令兩歧、事權不一，特傳旨予以申飭。",
                "whenCh": "乾隆五十二年正月初八日",
                "whenAr": "1787/01/08",
                "where": "",
                "who": [
                  "徐嗣曾"
                ],
                "whoLoc": {
                  "徐嗣曾": "福州"
                },
                "relations": [],
                "origin_doc_id": "",
                "origin_type": "",
                "origin_quote": "",
