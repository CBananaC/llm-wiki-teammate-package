        "items": [
          {
            "actor": "lin",
            "category": "done",
            "subtitle": "賊匪數萬三面合圍鹽埕營盤",
            "description": "十二月十二日早，叛軍數萬人散漫滿野，自三面包圍清軍營盤，戰至未時不退，後遭清軍及義民竭力擊退。",
            "where": "鹽埕橋",
            "whenCh": "十二月十二日",
            "whenAr": "1786/12/12",
            "who": [],
            "whoLoc": {},
            "relations": [],
            "sources": [
              {
                "doc_id": "硃78",
                "quote": "十二日早...乃賊眾數萬，散漫滿野，三面擁至。奴才督率官兵，協力施放槍炮...自卯至未，賊尚不退",
                "howKnown": "",
                "whenKnown": ""
              }
            ],
            "__traceChains": [
              {
                "events": [
                  {
                    "quote": "十二日早，正在點齊兵丁，欲往各莊搜賊，乃賊眾數萬，散漫滿野，三面擁至。奴才督率官兵，協力施放槍炮，打裂大炮三門，用麻繩捆好復放，母子炮隨損隨修。槍炮打死賊匪約有一百餘名，殺死者十數名。自卯至未，賊尚不退",
                    "reporter": "柴大紀",
                    "subtitle": "賊匪數萬三面合圍鹽埕營盤",
                    "whenCh": "十二月十二日",
                    "where": "鹽埕橋"
                  }
                ],
                "hops": [
                  {
                    "doc_id": "硃78",
                    "from_person": "柴大紀",
                    "how": "親見",
                    "inferred": false,
                    "layer": 1,
                    "place": "鹽埕橋",
                    "quote": "奴才即督率官兵飛馳鹽埕察看，海邊一帶，已有小船數百隻浮水而來，俱係賊匪，飭令弁兵施放槍炮，被子母炮打沉小船數十隻，餘船遠逃。正欲覓船往擒，又見遍野賊匪，竟有萬餘。黑衣黑布包頭，多執長刀，亦有槍炮，蜂擁而至。",
                    "to_person": "柴大紀",
                    "whenAr": "1786/12/07",
                    "whenCh": "十二月初七日"
                  }
                ]
              }
            ],
            "__repeatId": "硃78#lin#candidate"
          }
        ],
