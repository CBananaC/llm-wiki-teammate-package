                    "doc_id": "硃31",
                    "from_person": "程必大",
                    "how": "口述",
                    "inferred": false,
                    "layer": 1,
                    "place": "轅門",
                    "quote": "茲于十二日有該廳程峻之子程必大，奔赴奴才轅門求見，奴才立即傳進。據程必大懷取淡防同知關防，請求救援。……奴才率同地方官詢問，據程必大供：我父親程峻，現署淡水同知，駐紮竹塹。因彰化賊匪滋事，我父親會同董守備帶領兵役鄉勇，前赴中港地方堵禦。賊匪眾多，抵敵不住，我父親存亡不知。",
                    "to_person": "任承恩",
                    "whenAr": "1786/12/12",
                    "whenCh": "十二月十二日"
                  }
                ]
              }
            ],
            "__repeatId": "硃31#lin#candidate"
          }
