    {
      "id": "evmrx8fqvq5z9",
      "actor": "emperor",
      "subtitle": "嚴厲斥責陸路任承恩任承恩計畫渡台與水師提督黃仕簡會剿的想法",
      "description": "皇帝嚴厲斥責陸路提督任承恩計畫渡台與水師提督黃仕簡會剿的想法，認為對付區區叛匪不應同時動用兩位提督，直指任承恩此舉若非奸詐投機，就是極其愚蠢。\n只保留皇帝自己的評論、答覆或命令；同義硃批與上諭合為一項。",
      "what": "嚴厲斥責陸路任承恩任承恩計畫渡台與水師提督黃仕簡會剿的想法",
      "where": "北京",
      "who": [
        "乾隆帝"
      ],
      "whoLoc": {},
      "relations": [
        "任承恩",
        "黃仕簡"
      ],
      "provenance": [],
      "whenCh": "乾隆五十一年十二月二十九日",
      "dateAr": "1786/12/29",
      "sources": [
        {
          "doc_id": "諭20",
          "quote": "乃任承恩竟欲親往，豈有水陸兩提督俱遠渡重洋，內地於不顧，辦一匪類之理？",
          "label": "嚴厲斥責陸路任承恩任承恩計畫渡台與水師提督黃仕簡會剿的想法",
          "howKnown": "上諭"
        }
      ],
      "hidden": false,
      "emperorDetail": {
        "kind": "edict",
        "aspect": "blame",
        "edict_title": "諭閩浙總督常青等鎮定妥辦不必紛紛赴臺",
        "edict_id": "諭20",
        "date": "1786/12/29",
        "memorial_quote": "豈有兩提督往辦一匪類之理。若不誠是巧詐，若誠是至愚。欽此。",
        "memorial_position": "尾批",
        "memorial_context_quote": "",
        "edict_quote": "乃任承恩竟欲親往，豈有水陸兩提督俱遠渡重洋，內地於不顧，辦一匪類之理？",
        "how": "皇帝嚴厲斥責陸路提督任承恩計畫渡台與水師提督黃仕簡會剿的想法，認為對付區區叛匪不應同時動用兩位提督，直指任承恩此舉若非奸詐投機，就是極其愚蠢。",
        "memDoc": "硃31",
        "memTitle": "為奏臺灣地方官求救及統兵會剿事"
      }
    },
    {
      "id": "evmrx8gc0sgvj",
      "actor": "emperor",
      "subtitle": "嚴詞駁斥任承恩請求簡派重臣督辦的提議，指出地方督撫提鎮本有綏靖之責",
      "description": "乾隆帝嚴詞駁斥任承恩請求簡派重臣督辦的提議，指出地方督撫提鎮本有綏靖之責，不應一遇事就請求欽派大臣。\n只保留皇帝自己的評論、答覆或命令；同義硃批與上諭合為一項。",
      "what": "嚴詞駁斥任承恩請求簡派重臣督辦的提議，指出地方督撫提鎮本有綏靖之責",
