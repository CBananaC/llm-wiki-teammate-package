        "prompt": "（本機技能輸出：outputs/official-response.json）",
        "items": [
          {
            "action_quote": "嚴煙籍隸漳州，不難即時擒獲。並著常於拿該犯後，一併妥速解京。",
            "doc_id": "硃173",
            "how": "福建巡撫徐嗣曾奏報，遵旨密飭所屬嚴加訪緝起會根源嚴煙（即莊煙）。因嚴煙籍隸漳州平和縣，恐其已回原籍藏匿，已密飭水師提督及汀漳道留心緝捕，一俟拿獲即會商督臣常青妥速解京。",
            "receive_date": "乾隆五十二年二月初二日",
            "relations": [
              {
                "evidence": "一俟拿獲，即便會商督臣妥速解京",
                "relation": "會商",
                "relation_type": "ally",
                "source": "徐嗣曾",
                "target": "常青"
              },
              {
                "evidence": "當即密飭查拿，尚未報獲。臣現又嚴飭密速訪緝",
                "relation": "密飭查拿",
                "relation_type": "conflict",
                "source": "徐嗣曾",
                "target": "嚴煙"
              }
            ],
            "response_date": "乾隆五十二年二月初四日",
            "response_quote": "至臣前准督臣札會審辦逆匪高文麟等犯，究出起會根由，係平和人嚴煙，即莊煙，過臺來興起。等語，現已飛咨水師提臣追究下落，囑臣一體留心密查。等情。查嚴煙籍隸漳州，恐其已回原籍，當即密飭查拿，尚未報獲。臣現又嚴飭密速訪緝，仍令不動聲色，妥協辦理，毌得稍涉張皇。轉致該犯聞風遠颺，一俟拿獲，即便會商督臣妥速解京。",
            "subtitle": "徐嗣曾密飭查拿起會根源嚴煙並表明一俟拿獲即會商督臣妥速解京",
            "where": "漳州",
            "who": [
              "徐嗣曾",
              "常青",
              "嚴煙"
            ],
            "who_loc": {
              "嚴煙": "漳州",
              "常青": "鹿仔港",
              "徐嗣曾": "福州"
            }
          }
        ],
