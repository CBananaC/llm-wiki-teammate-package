        },
        {
          "doc_id": "硃40",
          "quote": "奴才等聞信，親率官兵於十二月初二日起程，飛馳剿捕",
          "howKnown": "",
          "whenKnown": "",
          "label": "柴大紀等率兵飛赴諸彰剿捕",
          "ownSubtitle": "柴大紀等率兵起程剿捕",
          "ownDescription": "臺灣鎮總兵柴大紀、臺灣道永福聞知林爽文等聚匪攻劫，於十二月初二日親率官兵起程飛馳剿捕。",
          "ownWhere": "臺灣",
          "ownWhenAr": "1786/12/02",
          "ownWhenCh": "十二月初二日",
          "ownWho": [
            "柴大紀",
            "永福"
          ],
          "ownWhoLoc": {},
          "ownRelations": []
        },
        {
          "doc_id": "硃34",
          "quote": "本鎮會同本道率鎮標左營遊擊李中揚，護臺灣水師協務左營遊擊林光玉，中營遊擊楊起麟，帶領弁兵即於初二早，飛赴諸彰要處，分路剿捕。",
          "howKnown": "",
          "whenKnown": "",
          "label": "柴大紀等率兵飛赴諸彰剿捕",
          "ownSubtitle": "柴大紀等率兵赴諸彰剿捕",
          "ownDescription": "臺灣鎮總兵柴大紀會同臺灣道永福，率領遊擊李中揚、林光玉、楊起麟等官兵，於十二月初二日每日清晨前往諸羅、彰化等要地分路剿捕。",
          "ownWhere": "諸彰要處",
          "ownWhenAr": "1786/12/02",
          "ownWhenCh": "十二月初二日",
          "ownWho": [
            "柴大紀",
            "永福",
            "李中揚",
            "林光玉",
            "楊起麟"
          ],
          "ownWhoLoc": {},
          "ownRelations": []
        },
        {
          "doc_id": "硃33",
          "quote": "本職柴大紀會同職道，率營遊擊李中揚、臺灣水師遊擊林光玉、楊起麟帶領弁兵，即於初二日早，飛赴諸彰要處，分路剿捕。",
