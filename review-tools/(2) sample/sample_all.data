                "same_as_event_id": "evmr4nv89hd6n",
                "sources": [
                  {
                    "doc_id": "硃82",
                    "source_type": "硃批",
                    "quote": "看來府城無事，紙盼黃仕簡到臺灣之信耳。欽此。",
                    "title": "為奏聞守備陳邦光攻打彰化擒獲楊振國等緣由事",
                    "date": "1787/01/15",
                    "position": "尾批"
                  },
                  {
                    "doc_id": "諭51",
                    "source_type": "上諭",
                    "quote": "看來臺灣府城可以無事。黃仕簡等所帶之兵一到，賊匪無難立時撲滅。",
                    "title": "諭閩浙總督常青審辦楊振國等其首要家屬容後拿辦",
                    "date": "1787/01/15"
                  }
                ],
                "__repeatId": "硃82#emperor#candidate",
                "__added": true,
                "__evId": "evms07e2wc886"
              },
              {
                "title": "乾隆帝嘉獎署守備陳邦光率兵民擊賊之功並命令事平後送部引見及旌賞義民",
                "aspect": "praise",
                "action_type": "praise",
                "how": "乾隆帝肯定署鹿仔港守備陳邦光率同義民多次擊退叛軍、生擒偽官楊振國等四人之奮勇戰績，指示常青於事平之後將陳邦光送部引見，並對出力義民鄉勇分別獎勵。",
                "description": "乾隆帝肯定署鹿仔港守備陳邦光率同義民多次擊退叛軍、生擒偽官楊振國等四人之奮勇戰績，指示常青於事平之後將陳邦光送部引見，並對出力義民鄉勇分別獎勵。",
                "whenCh": "乾隆五十二年正月十五日",
                "whenAr": "1787/01/15",
                "where": "北京",
                "who": [
                  "乾隆帝",
                  "陳邦光",
                  "常青"
                ],
                "whoLoc": {
                  "乾隆帝": "北京",
                  "常青": "泉州",
                  "陳邦光": "鹿港"
                },
                "relations": [
                  {
                    "from": "常青",
                    "to": "陳邦光",
                    "type": "轉奏其戰功"
                  },
                  {
                    "from": "乾隆帝",
                    "to": "陳邦光",
                    "type": "嘉獎與賞賜指令"
                  }
                ],
                "origin_doc_id": "",
                "origin_type": "",
                "origin_quote": "",
                "origin_date": "",
                "same_as_event_id": "",
                "sources": [
                  {
                    "doc_id": "硃82",
                    "source_type": "硃批",
                    "quote": "事平送部引見",
                    "title": "為奏聞守備陳邦光攻打彰化擒獲楊振國等緣由事",
                    "date": "1787/01/15",
                    "position": "夾批",
                    "context_quote": "臣查該署守備所稟"
                  },
                  {
                    "doc_id": "硃82",
                    "source_type": "硃批",
                    "quote": "自然",
                    "title": "為奏聞守備陳邦光攻打彰化擒獲楊振國等緣由事",
                    "date": "1787/01/15",
                    "position": "夾批",
                    "context_quote": "，節次撲捕賊匪事宜，及義民人等同心協力，俱屬奮勇可嘉，俟分別查明請旨優獎"
                  },
                  {
                    "doc_id": "諭51",
                    "source_type": "上諭",
                    "quote": "至署守備邦光，督率兵民於鹿港地方殺退賊衆，並擒獲賊匪僞官楊振國等四人，解送內地審辦，尚屬奮勇可嘉。著常青於事竣後，查明該出力之處，給諮送部引見。其義民鄉勇等，亦著分別旌賞，以示獎勵。",
                    "title": "諭閩浙總督常青審辦楊振國等其首要家屬容後拿辦",
                    "date": "1787/01/15"
                  }
                ],
                "__pendingResponses": [
                  {
                    "action_quote": "著常青於事竣後，查明該出力之處，給諮送部引見。其義民鄉勇等，亦著分別旌賞，以示獎勵。",
                    "doc_id": "硃146",
                    "how": "常青於正月二十八日接奉正月十五日上諭，具奏表明已欽遵旨意。針對署守備陳邦光殲擒賊眾奮勇可嘉，以及鄉勇、義民應行分別旌賞等事項，聲明容其逐一確查核實後辦理具奏。",
                    "receive_date": "1787/01/28",
                    "relations": [
                      {
                        "evidence": "陳邦光拿獲賊目楊振國等四犯",
                        "relation": "拿獲",
                        "relation_type": "conflict",
                        "source": "陳邦光",
                        "target": "楊振國"
                      },
                      {
                        "evidence": "至如陳邦光之殲擒賊眾，奮勇可嘉，鄉勇、義民分別旌賞……容臣逐一確查辦理",
                        "relation": "確查辦理",
                        "relation_type": "command",
                        "source": "常青",
                        "target": "陳邦光"
                      }
                    ],
                    "response_date": "1787/01/28",
                    "response_quote": "至如陳邦光之殲擒賊眾，奮勇可嘉，鄉勇、義民分別旌賞，及鳳山縣知縣湯大奎應行議恤之處，容臣逐一確查辦理外，合將奏到諭旨緣由，恭摺具奏。再，現在內地民情俱極寧貼，合併陳明，伏祈皇上睿鑒。謹奏。",
                    "subtitle": "常青遵旨具奏陳邦光殲擒賊眾奮勇可嘉，並聲明鄉勇與義民等容事後確查分別旌賞",
