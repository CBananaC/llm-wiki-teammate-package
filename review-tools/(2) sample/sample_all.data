        "items": [
          {
            "actor": "lin",
            "category": "done",
            "subtitle": "賊匪再逼營盤遭清軍夾擊潰敗",
            "description": "十二月十三日午後，叛軍再次逼近清軍營盤，遭柴大紀誘敵並與埋伏於大穆降之清軍前後夾攻，叛軍大敗四散奔逃。",
            "where": "鹽埕橋",
            "whenCh": "十二月十三日",
            "whenAr": "1786/12/13",
            "who": [],
            "whoLoc": {},
            "relations": [],
            "sources": [
              {
                "doc_id": "硃78",
                "quote": "巳刻遠見賊果復來...午後賊漸近營盤...打死賊匪百餘名，殺傷騎馬賊一名，賊皆喪膽，四散奔逃",
                "howKnown": "",
                "whenKnown": ""
              }
            ],
            "__traceChains": [
              {
                "events": [
                  {
                    "quote": "巳刻遠見賊果復來，當飭官兵不許先放槍炮。午後賊漸近營盤，奴才隨放號炮，督率官兵並臺灣縣義民，齊力向前。兵丁賴連升首先過橋放槍，打死一賊，復斬一賊。各兵隨齊放槍炮。邱能成帶兵亦經殺到，前後夾攻，打死賊匪百餘名，殺傷騎馬賊一名，賊皆喪膽，四散奔逃",
                    "reporter": "柴大紀",
                    "subtitle": "賊匪再逼營盤遭清軍夾擊潰敗",
                    "whenCh": "十二月十三日",
                    "where": "鹽埕橋"
                  }
                ],
                "hops": [
                  {
                    "doc_id": "硃78",
                    "from_person": "柴大紀",
                    "how": "親見",
                    "inferred": false,
                    "layer": 1,
                    "place": "鹽埕橋",
                    "quote": "奴才即督率官兵飛馳鹽埕察看，海邊一帶，已有小船數百隻浮水而來，俱係賊匪，飭令弁兵施放槍炮，被子母炮打沉小船數十隻，餘船遠逃。正欲覓船往擒，又見遍野賊匪，竟有萬餘。黑衣黑布包頭，多執長刀，亦有槍炮，蜂擁而至。",
                    "to_person": "柴大紀",
                    "whenAr": "1786/12/07",
                    "whenCh": "十二月初七日"
                  }
                ]
              }
            ],
            "__repeatId": "硃78#lin#candidate"
          }
