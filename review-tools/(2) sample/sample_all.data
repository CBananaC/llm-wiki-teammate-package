    {
      "id": "evms02dofott8",
      "actor": "emperor",
      "subtitle": "乾隆帝嚴厲斥責任承恩請求特簡重臣臨閩督辦係屬至愚且不成話並諭示督撫提鎮本有綏靖地方之責",
      "description": "乾隆帝針對福建陸路提督任承恩奏請特簡重臣前往福建鎮安督辦臺灣善後事宜一事，於奏摺尾批嚴斥其「更不成話，不料汝亦如此至愚」，並於上諭中進一步指出地方督撫提鎮各有綏靖地方之責，若一遇匪徒滋事即請欽差大臣前往，顯屬不曉事體。",
      "what": "乾隆帝嚴厲斥責任承恩請求特簡重臣臨閩督辦係屬至愚且不成話並諭示督撫提鎮本有綏靖地方之責",
      "where": "京師",
      "who": [
        "乾隆帝",
        "任承恩"
      ],
      "whoLoc": {},
      "relations": [],
      "provenance": [],
      "whenCh": "乾隆五十一年十二月二十九日",
      "dateAr": "1786/12/29",
      "sources": [
        {
          "doc_id": "諭20",
          "quote": "至所稱簡派欽差督辦，更不成話。督撫提鎮俱有綏靖地方之責，設一遇匪徒滋事，輒請欽派大臣督辦，又安用伊等爲耶？",
          "label": "乾隆帝嚴厲斥責任承恩請求特簡重臣臨閩督辦係屬至愚且不成話並諭示督撫提鎮本有綏靖地方之責",
          "aiFilterLabel": "相關上諭",
          "howKnown": "上諭"
        }
      ],
      "hidden": false,
      "aiFilterLabel": "相關上諭",
      "emperorDetail": {
        "kind": "edict",
        "combined": true,
        "action_type": "blame",
        "sources": [
          {
            "doc_id": "硃32",
            "source_type": "硃批",
            "quote": "更不成話，不料汝亦如此至愚。欽此。",
            "title": "為特簡重臣臨閩督辦事（附片）",
            "date": "1786/12/29",
            "position": "尾批"
          },
          {
            "doc_id": "諭20",
            "source_type": "上諭",
            "quote": "至所稱簡派欽差督辦，更不成話。督撫提鎮俱有綏靖地方之責，設一遇匪徒滋事，輒請欽派大臣督辦，又安用伊等爲耶？",
            "title": "諭閩浙總督常青等鎮定妥辦不必紛紛赴臺",
            "date": "1786/12/29"
          },
          {
            "doc_id": "硃32",
            "source_type": "奏摺",
            "quote": "仰懇皇上天恩，特簡重臣臨閩鎮安督辦，蕆事方能迅速。",
            "title": "為特簡重臣臨閩督辦事（附片）",
            "date": "1786/12/29"
          }
        ],
        "memDoc": "硃32",
