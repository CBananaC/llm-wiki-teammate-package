                    "to_person": "福建巡撫徐嗣曾",
                    "whenAr": "1786/12/18",
                    "whenCh": "十二月十八日"
                  },
                  {
                    "doc_id": "硃42",
                    "from_person": "臺灣縣典史易鳳翔",
