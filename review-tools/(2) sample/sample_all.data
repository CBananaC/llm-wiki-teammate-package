  "硃72": {
    "overallAdj": "乾隆五十一年十二月二十八日，福建巡撫徐嗣曾奏報調兵渡台會剿之部署。因應台灣戰局，省城改派督撫標兵一千人由副將林天洛率領，自閩安啟航前往鹿耳門支援；同時針對淡水、新莊一帶賊匪復聚於暗坑仔之危局，已催派總兵郝壯猷與副將徐鼎士各率大軍，共計近四千兵力馳援淡水，預計由八里坌登陸進剿。此摺於乾隆五十二年正月十三日奉硃批「知道了」。",
    "divisions": [
      {
        "label": "交代前情與督臣協調",
        "summary": "說明先前預調建寧、延平兵力之案，並接獲督臣咨會改派督撫標兵一千名由林天洛率領前往鹿耳門會剿，原調兵力則留守省城。",
        "start": 0,
        "end": 99,
        "n": 1
      },
      {
        "label": "兵力調配與出洋準備",
        "summary": "報告延平兵已到而建寧兵未到，臣已依會商自督標、撫標撥兵共一千名，備船由南臺至閩安候風放洋，待延建兵到齊後留守省城。",
        "start": 99,
        "end": 190,
        "n": 2
      },
      {
        "label": "淡水戰況與求援情報",
        "summary": "轉呈都司易連關於淡水、新莊一帶率領義民抗敵，以及賊匪復聚暗坑仔、請求速發兵進剿的稟報。",
        "start": 190,
        "end": 247,
        "n": 3
      },
      {
        "label": "淡水援軍部署與兵力估算",
        "summary": "說明已催促總兵郝壯猷與副將徐鼎士各帶兵前往淡水救援，加計隨行、炮手及舵水人等共計不下四千人，淡水一路兵勢已屬壯盛。",
        "start": 247,
        "end": 395,
        "n": 4
      },
      {
        "label": "派遣探船與結語",
        "summary": "報告另派小船往來探報，並將上述調兵情形附片具奏呈請皇帝睿鑒。",
        "start": 395,
        "end": 477,
        "n": 5
      }
    ],
