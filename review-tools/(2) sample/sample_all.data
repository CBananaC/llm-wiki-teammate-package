                ],
                "__pendingResponses": [
                  {
                    "action_quote": "著黃仕簡前往該處，即行查明。如果屬實，將帶兵剿殺賊匪者系屬何人，並首先出力之員及兵丁，分析具，候朕酌量加恩，以示獎勵。",
                    "doc_id": "硃94",
                    "how": "福建巡撫徐嗣曾於正月初十日接獲上諭後，隨即奏報臺灣戰況。他指出雖然賊匪攻搶多處，但艋舺、鹿港等地的泉州與廣東義民奮勇急公，且署都司易連、署守備陳邦光等率兵連次殺賊，總兵柴大紀亦於十二月中旬連殺賊匪甚多，以此查明並具報出力官兵與義民之實情。",
                    "receive_date": "1787/01/10",
                    "relations": [
                      {
                        "evidence": "臣親自查點，飭令統兵官沿途催越前進",
                        "relation": "催越前進",
                        "relation_type": "command",
                        "source": "徐嗣曾",
                        "target": "郝壯猷"
                      },
                      {
                        "evidence": "臣於初八日親赴督催",
                        "relation": "督催放洋",
                        "relation_type": "command",
                        "source": "徐嗣曾",
                        "target": "徐鼎士"
                      },
                      {
                        "evidence": "昨據興泉道萬鐘傑稟報",
                        "relation": "稟報",
                        "relation_type": "report",
                        "source": "萬鐘傑",
                        "target": "徐嗣曾"
                      }
                    ],
                    "response_date": "1787/01/10",
                    "response_quote": "臣查賊匪自彰化滋事之後，雖又攻搶諸羅、淡水、鳳山，但如艋舺、鹿港等處，各有泉州、廣東義民數千人，奮勇急公。經署都司易連、署守備陳邦光等，率同官兵連次殺賊。並據陳邦光收復彰化等處，擒獲賊目高文麟等四犯，而總兵柴大紀於十二月十一、二、三等日，亦連殺賊匪甚多。",
                    "subtitle": "徐嗣曾匯報臺灣各路官兵與義民殺賊出力實情",
                    "where": "臺灣",
                    "who": [
                      "徐嗣曾",
                      "黃仕簡",
                      "易連",
                      "陳邦光",
                      "柴大紀",
                      "蔡攀龍",
                      "林光玉",
                      "任承恩",
                      "萬鐘傑",
                      "郝壯猷",
                      "徐鼎士"
                    ],
                    "who_loc": {
                      "任承恩": "廈門",
                      "徐嗣曾": "福州",
                      "徐鼎士": "閩安",
                      "易連": "艋舺",
                      "林光玉": "臺灣郡城",
                      "柴大紀": "臺灣郡城",
                      "萬鐘傑": "泉州",
                      "蔡攀龍": "臺灣郡城",
                      "郝壯猷": "臺灣",
                      "陳邦光": "鹿港",
                      "黃仕簡": "料羅"
                    }
                  },
                  {
                    "action_quote": "著黃仕簡前往該處，即行查明。如果屬實，將帶兵剿殺賊匪者系屬何人，並首先出力之員及兵丁，分析具，候朕酌量加恩，以示獎勵。",
                    "doc_id": "硃105",
                    "how": "閩浙總督常青於正月十一日接獲上諭後，於次日具摺奏報。他詳細說明臺灣郡城有總兵柴大紀與遊擊蔡攀龍帶兵打仗、屢加殲戮，鹿仔港有守備陳邦光率領義民殺退賊人，艋舺則有都司易連召募匠首黃世恭及義民協同保護，展現官兵與義民奮勇出力之具體情形。",
                    "receive_date": "1787/01/11",
                    "relations": [
                      {
                        "evidence": "商之陸路提臣任承恩，多帶官兵，相度機宜，統率前進",
                        "relation": "商令帶兵",
                        "relation_type": "command",
                        "source": "常青",
                        "target": "任承恩"
                      },
                      {
                        "evidence": "臣並令調來之汀州鎮總兵普吉保，添帶水師兵六百名，由廈出口",
                        "relation": "令帶兵出口",
                        "relation_type": "command",
                        "source": "常青",
                        "target": "普吉保"
                      },
                      {
                        "evidence": "署都司易連召募匠首黃世恭及義民人等，共相保護",
                        "relation": "召募保護",
                        "relation_type": "command",
                        "source": "易連",
                        "target": "黃世恭"
                      },
                      {
                        "evidence": "已據漳浦縣羅澤坤稟報",
                        "relation": "稟報",
                        "relation_type": "report",
                        "source": "羅澤坤",
                        "target": "常青"
                      }
                    ],
                    "response_date": "1787/01/12",
                    "response_quote": "至臺郡情形，接據探差稟報，自十二月十八、九至二十等日，賊人往攻郡城，經柴鎮同澎湖蔡遊擊等帶兵打仗，屢加殲戮，並奪獲牛車米包等物，又連放大炮，賊皆退避。城內聚集義民鄉勇，協同抵敵。...其鹿仔港一路，已據署守備陳邦光率同泉、粵義民，殺退彰化賊人，協力固守。又淡水新莊之艋舺一帶，亦經署都司易連召募匠首黃世恭及義民人等，共相保護",
                    "subtitle": "常青奏報柴大紀及陳邦光等官兵義民禦賊情形",
                    "where": "臺灣",
                    "who": [
                      "常青",
                      "黃仕簡",
