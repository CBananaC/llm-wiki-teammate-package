                "sources": [
                  {
                    "doc_id": "諭13",
                    "source_type": "上諭",
                    "quote": "賊匪率衆擾諸羅，即被官兵殺死二千餘名。該地方文武，所辦尚好，著黃仕簡前往該處，即行查明。如果屬實，將帶兵剿殺賊匪者系屬何人，並首先出力之員及兵丁，分析具，候朕酌量加恩，以示獎勵。",
                    "title": "諭閩浙總督常青等嚴行殲戮林爽文等並防餘衆四散內渡",
                    "date": "1786/12/27"
                  },
                  {
                    "doc_id": "硃24",
                    "source_type": "奏摺",
                    "quote": "又聽人傳說，賊人赴諸羅縣攻城，被官兵殺死二千餘人。",
                    "title": "為奏接鎮道文報並派遣省兵赴臺事",
                    "date": "1786/12/27"
                  }
                ],
                "__repeatId": "諭13#emperor#candidate"
              },
              {
                "title": "定性彰化知縣俞峻在大墩搜捕賊匪係因公被害並交部議恤",
                "aspect": "command",
                "action_type": "command",
                "how": "乾隆帝就徐嗣曾奏報彰化知縣俞峻帶兵搜捕遇害事宜進行批示，指出俞峻雖防範疏懈，但屬因公倉猝被害，命令督撫查明其平日無劣跡後據實奏聞交部議恤。",
                "description": "乾隆帝就徐嗣曾奏報彰化知縣俞峻帶兵搜捕遇害事宜進行批示，指出俞峻雖防範疏懈，但屬因公倉猝被害，命令督撫查明其平日無劣跡後據實奏聞交部議恤。",
                "whenCh": "乾隆五十一年十二月二十七日",
                "whenAr": "1786/12/27",
                "where": "北京",
                "who": [
                  "乾隆帝",
                  "俞峻",
                  "常青",
                  "徐嗣曾"
                ],
                "whoLoc": {
                  "俞峻": "彰化",
                  "常青": "蚶江",
                  "徐嗣曾": "福州"
                },
                "relations": [],
                "origin_doc_id": "",
                "origin_type": "",
                "origin_quote": "",
                "origin_date": "",
                "same_as_event_id": "evmrbqyiq48b3",
                "sources": [
                  {
                    "doc_id": "諭13",
                    "source_type": "上諭",
                    "quote": "再，彰化知縣會同副將前往各莊搜捕，賊匪俱已逃竄。嗣又散而復聚，竟有數千人，已致被害。該縣於搜捕賊匪後，不能嚴密防範，雖失之疏懈，但帶兵緝犯，事屬因公，倉猝被害，尚非激變者可比。並著該督撫查明該縣，如平日並無別項劣跡及激變情事，即據實奏聞，候朕降旨交部議恤。",
                    "title": "諭閩浙總督常青等嚴行殲戮林爽文等並防餘衆四散內渡",
                    "date": "1786/12/27"
                  },
                  {
                    "doc_id": "硃24",
                    "source_type": "奏摺",
                    "quote": "俞知縣同赫副將、耿遊擊帶兵駐扎離縣城三十里之大墩汛地，前往各莊搜捕，賊匪俱已逃竄。二十八日辰刻，忽聞二十七日夜四更時候，賊匪散而復聚，竟有數千人往劫大墩營盤。",
                    "title": "為奏接鎮道文報並派遣省兵赴臺事",
                    "date": "1786/12/27"
                  }
                ],
                "__repeatId": "諭13#emperor#candidate"
              },
              {
                "title": "告誡徐嗣曾與常青辦理臺灣軍務應不動聲色且處以鎮定",
                "aspect": "command",
                "action_type": "command",
                "how": "乾隆帝針對徐嗣曾因文報未達深感焦灼、紛紛調兵救援之舉，告誡常青與徐嗣曾等督撫官員應不動聲色、鎮定妥辦，避免因動作過大而跡涉張皇，致使內地民人心生疑慮恐慌。",
                "description": "乾隆帝針對徐嗣曾因文報未達深感焦灼、紛紛調兵救援之舉，告誡常青與徐嗣曾等督撫官員應不動聲色、鎮定妥辦，避免因動作過大而跡涉張皇，致使內地民人心生疑慮恐慌。",
                "whenCh": "乾隆五十一年十二月二十七日",
                "whenAr": "1786/12/27",
                "where": "北京",
                "who": [
                  "乾隆帝",
                  "徐嗣曾",
                  "常青"
                ],
                "whoLoc": {
                  "常青": "蚶江",
                  "徐嗣曾": "福州"
                },
                "relations": [],
                "origin_doc_id": "",
                "origin_type": "",
                "origin_quote": "",
                "origin_date": "",
                "same_as_event_id": "evmrbqt7e3lh7",
                "sources": [
                  {
                    "doc_id": "諭13",
                    "source_type": "上諭",
                    "quote": "常青、徐嗣曾等，總須不動聲色，妥協辦理。若因外洋遇有此等案件，該督撫等紛紛調遣，跡涉張皇，轉致內地民人心生疑駭，殊有關係，該督撫不可不處以鎮定也。",
                    "title": "諭閩浙總督常青等嚴行殲戮林爽文等並防餘衆四散內渡",
                    "date": "1786/12/27"
                  },
                  {
                    "doc_id": "硃24",
                    "source_type": "奏摺",
                    "quote": "此皆傳聞之言，總因不見鎮、道文報，深為焦灼。",
                    "title": "為奏接鎮道文報並派遣省兵赴臺事",
                    "date": "1786/12/27"
                  }
                ],
                "__pendingResponses": [
                  {
                    "action_quote": "常青、徐嗣曾等，總須不動聲色，妥協辦理。若因外洋遇有此等案件，該督撫等紛紛調遣，跡涉張皇，轉致內地民人心生疑駭，殊有關係，該督撫不可不處以鎮定也。",
                    "doc_id": "硃94",
                    "how": "徐嗣曾覆奏於正月初十日接獲十二月二十七日上諭，報告其密札漳州道朱芫會及知府黃彬不動聲色妥為防範漳籍居民勾串，並會同督臣常青出示曉諭民人安生。同時說明渡臺官兵雇用商船、動碾倉穀及平抑糧價等措施，強調內地輿情安貼，並保證仰承訓示，辦理一切事事出以鎮定，不敢稍涉張皇轉滋疑駭。",
                    "receive_date": "乾隆五十二年正月初十日",
                    "relations": [
                      {
                        "evidence": "臣密札該道朱芫會、知府黃彬，不動聲色，妥為防範",
                        "relation": "密札",
                        "relation_type": "command",
                        "source": "徐嗣曾",
                        "target": "朱芫會"
                      },
                      {
                        "evidence": "臣密札該道朱芫會、知府黃彬，不動聲色，妥為防範",
                        "relation": "密札",
                        "relation_type": "command",
                        "source": "徐嗣曾",
                        "target": "黃彬"
                      }
                    ],
                    "response_date": "乾隆五十二年正月初十日",
                    "response_quote": "臣密札該道朱芫會、知府黃彬，不動聲色，妥為防範。復會同督臣出示曉諭，以賊匪雖係漳人，其在臺滋事，與原籍親屬毫無干涉。惟藏匿引逆，例應同罪，將來賊匪潛逃回籍，即捕獲首報，並懸賞格，剴切示諭。仍令該道府將該處地方情形，按日稟報。臣復密加防察，現在實俱寧謐，並無驚疑之處。至渡臺官兵，配坐戰船之外，需用商船，皆係厚價雇備，應給兵糧，亦皆動碾倉穀。惟漳、泉一帶，民食素資臺米，今商販不至，糧價稍昂，現在設法招商運赴下游糶濟。其過兵處所，俱飭令大員妥為經理，並無絲毫擾累民間。體訪輿情，各俱安貼。臣仰承訓示，辦理一切，唯有事事出以鎮定，不敢稍存疏忽，亦斷不敢稍涉張皇，轉滋疑駭",
                    "subtitle": "徐嗣曾遵旨密札漳州道府不動聲色防範漳籍居民並出以鎮定撫慰民心",
                    "where": "福建",
                    "who": [
                      "徐嗣曾",
                      "朱芫會",
                      "黃彬",
                      "常青"
                    ],
