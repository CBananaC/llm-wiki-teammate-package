                "hops": [
                  {
                    "doc_id": "硃82",
                    "from_person": "署鹿仔港守備陳邦光",
                    "how": "稟報",
                    "inferred": false,
                    "layer": 1,
                    "place": "鹿仔港",
                    "quote": "茲於十二月二十七日亥刻，接得該署備陳邦光兩稟同時並到。內十二月十一一稟，據稱：彰化縣近山之大里杙，有漳州積匪林爽文等，糾夥搶劫，擾害地方。先蒙鎮道飭令耿遊、孫知府赴彰督拿，孫知府駐紮縣城，耿遊擊與北協赫副將、彰化縣俞峻帶領兵役，親往大墩莊等處搜捕。詎該犯等始則竄遁山邊，旋復糾約數千人，於十一月二十七夜搶劫大墩營盤，全軍俱陷。",
                    "to_person": "閩浙總督常青",
                    "whenAr": "1786/12/11",
                    "whenCh": "十二月十一日"
                  }
                ]
              },
              {
                "events": [
                  {
                    "quote": "邦光傳令泉、粵義民乘夜以行，至大突、二林地方預先埋伏。適遇賊匪衝鋒而來，隨令義民百餘誘敵，引至埋伏處所，兩頭夾攻，殺賊百餘名，焚毀咳咍、湳仔、內灣、二八水等賊莊。",
                    "reporter": "署鹿仔港守備陳邦光",
                    "subtitle": "陳邦光率義民伏擊賊匪",
                    "whenCh": "十二月十八日",
                    "where": "大突、二林"
                  }
                ],
                "hops": [
                  {
                    "doc_id": "硃82",
                    "from_person": "署鹿仔港守備陳邦光",
                    "how": "稟報",
                    "inferred": false,
                    "layer": 1,
                    "place": "",
                    "quote": "又十二月二十一日一稟，內稱：十八日據大突莊義民報稱，復有咳咍等莊賊匪謀攻鹿港，邦光傳令泉、粵義民乘夜以行，至大突、二林地方預先埋伏。適遇賊匪衝鋒而來，隨令義民百餘誘敵，引至埋伏處所，兩頭夾攻，殺賊百餘名，焚毀咳咍、湳仔、內灣、二八水等賊莊。",
