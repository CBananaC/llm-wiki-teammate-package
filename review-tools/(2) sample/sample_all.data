                        "relation_type": "ally",
                        "source": "任承恩",
                        "target": "黃仕簡"
                      },
                      {
                        "evidence": "常青仍祇須駐劄蚶江、廈門一帶調度策應",
                        "relation": "調度策應",
                        "relation_type": "command",
                        "source": "常青",
                        "target": "黃仕簡"
                      },
                      {
                        "evidence": "總兵柴大紀...與賊打仗",
                        "relation": "打仗",
                        "relation_type": "conflict",
