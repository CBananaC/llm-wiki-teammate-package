      {
        "at": "2026-07-25 05:55",
        "model": "local skill output",
        "kind": "officialresponse",
        "evTitle": "乾隆帝重申國家調兵體制應由總督主政並指示巡撫遇事應鎮靜地方妥籌軍需",
        "addressee": "徐嗣曾",
