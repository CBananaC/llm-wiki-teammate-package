            "subtitle": "叛軍退守烏日莊",
            "description": "叛軍在沙轆、水里、大肚、茄投等地被義民擊敗後，退守至烏日莊，隔大溪與義民對峙。",
            "where": "烏日莊",
            "whenCh": "十二月二十日",
            "whenAr": "1786/12/20",
            "who": [],
            "sources": [
              {
                "doc_id": "硃82",
                "quote": "追逐至貓霧捒，賊匪退踞烏日莊。",
                "howKnown": "",
                "whenKnown": ""
              }
            ],
            "__rawSubtitle": "叛軍退守烏日莊",
