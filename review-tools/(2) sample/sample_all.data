    {
      "id": "evmrx9e2cksw3",
      "actor": "emperor",
      "subtitle": "針對徐嗣曾奏報已嚴飭沿海口岸實力巡防以防賊匪竄逸",
      "description": "針對徐嗣曾奏報已嚴飭沿海口岸實力巡防以防賊匪竄逸，乾隆帝於奏摺夾批「此為最」予以肯定，並在上諭中指示常青、任承恩等必須嚴格督飭沿海口岸文武官員實力巡防，嚴防餘匪偷越內渡。\n只保留皇帝自己的評論、答覆或命令；同義硃批與上諭合為一項。",
      "what": "針對徐嗣曾奏報已嚴飭沿海口岸實力巡防以防賊匪竄逸",
      "where": "北京",
      "who": [
        "常青",
        "任承恩",
        "徐嗣曾"
      ],
      "whoLoc": {},
      "relations": [],
      "provenance": [],
      "whenCh": "乾隆五十一年十二月二十七日",
      "dateAr": "1786/12/27",
      "sources": [
        {
          "doc_id": "諭13",
          "quote": "常青、任承恩現住蚶江一帶，著嚴飭沿海口岸地方文武員，實力巡防。如有竄逸餘匪，即行擒獲審辦，最爲緊要。",
          "label": "針對徐嗣曾奏報已嚴飭沿海口岸實力巡防以防賊匪竄逸",
          "howKnown": "上諭"
        }
      ],
      "hidden": false,
      "emperorDetail": {
        "kind": "edict",
        "aspect": "approve",
        "edict_title": "諭閩浙總督常青等嚴行殲戮林爽文等並防餘衆四散內渡",
        "edict_id": "諭13",
        "date": "1786/12/27",
        "memorial_quote": "此為最",
        "memorial_position": "夾批",
        "memorial_context_quote": "臣現在嚴飭沿海口岸，實力徼巡，防其竄逸",
        "edict_quote": "常青、任承恩現住蚶江一帶，著嚴飭沿海口岸地方文武員，實力巡防。如有竄逸餘匪，即行擒獲審辦，最爲緊要。",
        "how": "針對徐嗣曾奏報已嚴飭沿海口岸實力巡防以防賊匪竄逸，乾隆帝於奏摺夾批「此為最」予以肯定，並在上諭中指示常青、任承恩等必須嚴格督飭沿海口岸文武官員實力巡防，嚴防餘匪偷越內渡。",
        "memDoc": "硃24",
        "memTitle": "為奏接鎮道文報並派遣省兵赴臺事"
      }
    },
    {
      "id": "evmrx9e8e78y2",
      "actor": "emperor",
      "subtitle": "申飭官員應處以鎮定、切勿張皇",
      "description": "針對徐嗣曾因未見確報而「深為焦灼」並紛紛調遣省兵之舉，乾隆帝告誡常青與徐嗣曾等督撫官員應「不動聲色」、「處以鎮定」，避免因動作過大、跡涉張皇而導致內地民人心生疑慮恐慌。\n只保留皇帝自己的評論、答覆或命令；同義硃批與上諭合為一項。",
      "what": "申飭官員應處以鎮定、切勿張皇",
      "where": "北京",
      "who": [
        "常青",
        "徐嗣曾"
      ],
      "whoLoc": {},
      "relations": [],
      "provenance": [],
      "whenCh": "乾隆五十一年十二月二十七日",
      "dateAr": "1786/12/27",
      "sources": [
        {
          "doc_id": "諭13",
          "quote": "常青、徐嗣曾等，總須不動聲色，妥協辦理。若因外洋遇有此等案件，該督撫等紛紛調遣，跡涉張皇，轉致內地民人心生疑駭，殊有關係，該督撫不可不處以鎮定也。",
          "label": "申飭官員應處以鎮定、切勿張皇",
          "howKnown": "上諭"
        }
      ],
      "hidden": false,
