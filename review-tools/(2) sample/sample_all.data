                "sources": [
                  {
                    "doc_id": "諭20",
                    "source_type": "上諭",
                    "quote": "常青、黃仕簡、任承恩，俱著傳旨申飭。",
                    "title": "諭閩浙總督常青等鎮定妥辦不必紛紛赴臺",
                    "date": "1786/12/29"
                  }
                ],
                "__pendingResponses": [
                  {
                    "action_quote": "常青、黃仕簡、任承恩，俱著傳旨申飭。",
                    "doc_id": "硃110",
                    "how": "常青於正月十二日接奉申飭上諭後，覆奏坦承派任承恩親往渡臺殊失事理輕重，對辦理張皇失措深感愧悚。他表示將恪遵諭旨，仍駐蚶江、廈門一帶鎮靜調度策應，並俟任承恩與黃仕簡殲匪蕆事後即催促其速回內地駐防，以防範內地治安。",
                    "receive_date": "正月十二日",
                    "relations": [
                      {
                        "evidence": "經臣調派官兵進剿，該水師提臣黃仕簡、陸路提臣任承恩等",
                        "relation": "調派",
                        "relation_type": "command",
                        "source": "常青",
                        "target": "黃仕簡"
                      },
                      {
                        "evidence": "經臣調派官兵進剿，該水師提臣黃仕簡、陸路提臣任承恩等",
                        "relation": "調派",
                        "relation_type": "command",
                        "source": "常青",
                        "target": "任承恩"
                      },
                      {
                        "evidence": "臺匪林爽文等糾眾不法，攻擾三縣，經臣調派官兵進剿",
                        "relation": "進剿",
                        "relation_type": "conflict",
                        "source": "常青",
                        "target": "林爽文"
                      }
                    ],
                    "response_date": "乾隆五十二年正月十三日",
                    "response_quote": "並奉到上諭：「據常青、黃仕簡奏，接臺灣鎮道稟報彰化匪徒林爽文等糾眾滋事。等由。看來伊等辦理此事，但不免張皇失措。地方遇此等案件，總應權其輕重，鎮靜妥辦，不當各存預佔地步之見。常青、黃仕簡、任承恩，俱著傳旨申飭。」等因。欽此。臣伏查臺匪林爽文等糾眾不法，攻擾三縣，經臣調派官兵進剿，該水師提臣黃仕簡、陸路提臣任承恩等，於十二月二十八、正月初四等日，先後得有順風放洋，此時自必到臺。逆匪等么麼烏合，定即望風瓦解，克日殄滅。但既有提臣黃仕簡帶兵，而任承恩又復親往，殊失事理之輕重。況從前臺匪朱一貴滋擾一案，辦理迅速，成效可稽。臣罔識遵循，未得肯綮，一經聖明指示周詳，不勝愧悚之至。",
                    "subtitle": "常青就遭傳旨申飭坦承辦理失措愧悚自責並表遵旨鎮靜調度",
                    "where": "廈門",
                    "who": [
                      "常青",
                      "黃仕簡",
                      "任承恩",
                      "林爽文"
                    ],
