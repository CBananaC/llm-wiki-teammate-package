                ],
                "same_as_event_id": "evmrdbw8jessa",
                "sources": [
                  {
                    "doc_id": "諭56",
                    "source_type": "上諭",
                    "quote": "再，該督另片所奏，據楊詠供出之洪二房和尚及朱姓等，已另降諭旨，令孫士毅嚴密查拿矣。",
                    "title": "諭閩浙總督常青等拿獲嚴煙一併解京並調度應辦之事",
                    "date": "1787/01/20"
                  },
                  {
                    "doc_id": "硃87",
                    "source_type": "奏摺",
                    "quote": "據楊詠、楊軒同供：這天地會是五十年十二月裡，有漳州平和縣人莊煙即嚴煙，過臺來興起的。小的們聽得嚴煙說及起會的根源，是廣東有個姓洪的和尚，叫洪二房，同一個姓朱的人起的。",
                    "title": "為奏聞楊振國供天地會根源事",
                    "date": "1787/01/20"
                  }
                ],
                "__repeatId": "諭56#emperor#candidate"
              },
              {
                "title": "命令常青於緝獲天地會起會關鍵人嚴煙後將其妥速押解至北京審辦",
                "aspect": "command",
                "action_type": "command",
                "how": "常青奏報楊振國供稱天地會係漳州平和縣人嚴煙（莊煙）過臺興起。乾隆帝考量嚴煙籍隸漳州不難擒獲，下旨命令常青於拿獲嚴煙後，一併妥速解京審辦。",
                "description": "常青奏報楊振國供稱天地會係漳州平和縣人嚴煙（莊煙）過臺興起。乾隆帝考量嚴煙籍隸漳州不難擒獲，下旨命令常青於拿獲嚴煙後，一併妥速解京審辦。",
                "whenCh": "乾隆五二年正月二十日",
                "whenAr": "乾隆五二年正月二十日",
                "where": "北京",
                "who": [
                  "乾隆帝",
                  "常青"
                ],
                "whoLoc": {
                  "乾隆帝": "北京",
                  "常青": "福建"
                },
                "relations": [
                  {
                    "from": "乾隆帝",
                    "to": "常青",
                    "type": "command"
                  }
                ],
                "same_as_event_id": "evmrdbwdxkz4w",
                "sources": [
                  {
                    "doc_id": "諭56",
                    "source_type": "上諭",
                    "quote": "再，該督奏據楊詠供起會根由，系嚴煙過臺來興起的等語。嚴煙籍隸漳州，不難即時擒獲。並著常於拿該犯後，一併妥速解京。",
                    "title": "諭閩浙總督常青等拿獲嚴煙一併解京並調度應辦之事",
                    "date": "1787/01/20"
