        "items": [
          {
            "actor": "qing",
            "category": "nonmil",
            "subtitle": "柴大紀嚴審處決奸細林馬",
            "description": "柴大紀審訊拿獲之奸細林馬，審出賊匪欲經水陸兩路攻打府城之計畫後，將林馬即行正法。",
            "where": "府城",
            "whenCh": "十二月初七日",
            "whenAr": "1786/12/07",
            "who": [
              "柴大紀",
              "林馬"
            ],
            "whoLoc": {
              "林馬": "府城",
              "柴大紀": "府城"
