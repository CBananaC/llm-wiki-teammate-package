            "relations": [],
            "sources": [
              {
                "doc_id": "硃82",
                "quote": "據解逆犯四名，臣現委員飛赴迎提，即於泉州審明後，另摺具奏",
                "howKnown": "",
                "whenKnown": ""
              }
            ],
            "__qcat": "nonmil",
            "__traceChains": [
              {
                "events": [
                  {
                    "quote": "據解逆犯四名，臣現委員飛赴迎提，即於泉州審明後，另摺具奏",
                    "reporter": "署鹿仔港守備陳邦光",
                    "subtitle": "常青派員迎提偽官審訊",
                    "whenCh": "十二月十四日",
                    "where": "泉州"
                  }
                ],
                "hops": [
                  {
                    "doc_id": "硃82",
                    "from_person": "署鹿仔港守備陳邦光",
                    "how": "稟報",
                    "inferred": false,
                    "layer": 1,
                    "place": "鹿港",
                    "quote": "復於二十八日接據該署備十四日來稟，內稱：十二日午刻，率同各義民從鹿港抵彰，賊匪聞知，隨出西門外駐紮，各執器械，並用劫搶彰城營汛之槍炮施放。邦光令義民分為兩隊，上前攻殺，賊人退走，不能相顧，當即擒獲執旗之偽副元帥楊振國、偽協鎮高文麟、偽先鋒陳高、偽辦理水師軍務楊軒等四名。殺死賊夥百餘名，搶旗五桿，馬二匹，大炮三位，小炮一門，刀械八十餘件，餘賊四散奔逃。邦光入城查看，有三革前任彰化縣知縣張貞生、丁憂典史李爾和、教諭王梁、訓導陳琔，被羈未釋，並居民鋪戶受困在內。因彰城逼近賊巢，民心驚惶，各義民又無糧食可支，難以駐紮，隨與張三令等，護衛受困官親及居民男婦，一同回至鹿港保守。又將擒獲偽官楊振國等四名，押回鹿港，裝入檻車，交丁憂典史李爾和、受傷之北協外委許瑪分撥兵丁，配船解送泉州，聽候勘訊",
                    "to_person": "常青",
                    "whenAr": "1786/12/14",
                    "whenCh": "十二月十四日"
                  }
                ]
              }
            ],
            "__repeatId": "硃82#qing#candidate"
          }
