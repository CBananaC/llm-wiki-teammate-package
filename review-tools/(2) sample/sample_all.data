            "reply": {
              "id": "硃131",
              "title": "為奏聞與徐嗣曾續調官兵稍有三差並非各存意見事（附片）",
              "type": "zhupi",
              "doc_type": "硃批",
              "author": "常青",
              "recipients": [],
              "issue_date": null,
              "send_date": "1787/01/20",
