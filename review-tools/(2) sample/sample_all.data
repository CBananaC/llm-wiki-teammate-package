                "__pendingResponses": [
                  {
                    "action_quote": "並著該督撫查明該縣，如平日並無別項劣跡及激變情事，即據實奏聞，候朕降旨交部議恤。",
                    "doc_id": "硃94",
                    "how": "徐嗣曾於正月初十日回署途次接獲十二月二十七日廷寄上諭，於摺內引述旨意並陳明已遵旨知悉。隨後就官兵赴臺進剿進度、沿海口岸加派兵丁巡防及密札漳州道府妥為防範等辦理情形，具奏呈報皇上睿鑒。",
                    "receive_date": "乾隆五十二年正月初十日",
                    "relations": [
                      {
                        "evidence": "為提臣黃仕簡一路接應",
                        "relation": "接應",
                        "relation_type": "ally",
                        "source": "徐嗣曾",
                        "target": "黃仕簡"
                      }
                    ],
                    "response_date": "乾隆五十二年正月初十日",
                    "response_quote": "初十日辰刻回署途次，承准廷寄十二月二十七日奉上諭：「賊匪么麼烏合，黃仕簡到彼，督率該鎮道分路夾攻，盡力堵剿，無難立就撲滅。」等因。欽此。",
                    "subtitle": "徐嗣曾遵旨知悉十二月二十七日上諭並呈報沿海防務",
                    "where": "福建省城",
