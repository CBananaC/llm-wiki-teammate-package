                "sources": [
                  {
                    "doc_id": "諭43",
                    "source_type": "上諭",
                    "quote": "至林爽文不過一烏合之衆，無難速就撲滅。前因該省水陸兩提督概行渡臺，朕尚以爲過當。孫士毅系鄰省總督，止當鎮靜地方",
                    "title": "諭兩廣總督孫士毅毋庸親往潮州",
                    "date": "1787/01/13"
                  },
                  {
                    "doc_id": "硃71",
                    "source_type": "奏摺",
                    "quote": "查臺灣駐紮重兵，現在提臣黃仕簡帶領官兵渡臺督剿，量此么麼奸匪，即可立時撲滅。",
                    "title": "為接咨挑選戰兵預備赴臺策應並擬親赴潮州事",
                    "date": "1787/01/13"
                  }
                ],
                "__repeatId": "諭43#emperor#candidate",
                "__added": true,
                "__evId": "evms04w71fjkl"
              },
              {
                "title": "駁斥孫士毅欲親赴潮州駐紮之請並嚴令其鎮靜地方毋庸離省",
                "aspect": "command",
                "action_type": "command",
                "how": "乾隆帝嚴厲駁斥孫士毅欲親自帶兵或親赴潮州駐紮的計畫，斥之為『何必言及此』與『此則過矣』，批駁其過涉張皇，命令其鎮靜地方，毋庸前往潮州，若已起程亦應立即返回廣東省城。",
                "description": "乾隆帝嚴厲駁斥孫士毅欲親自帶兵或親赴潮州駐紮的計畫，斥之為『何必言及此』與『此則過矣』，批駁其過涉張皇，命令其鎮靜地方，毋庸前往潮州，若已起程亦應立即返回廣東省城。",
                "whenCh": "乾隆五十二年正月十三日",
