            "yu": {
              "id": "諭28",
              "title": "諭閩浙總督常青等務須同心協力俟大兵到齊夾攻",
              "type": "shangyu",
              "doc_type": "上諭",
              "author": "常青",
              "recipients": [
                "常青"
              ],
              "issue_date": "1787/01/03",
