        "items": [
          {
            "edict_id": "諭43",
            "title": "諭兩廣總督孫士毅毋庸親往潮州",
            "date": "1787/01/13",
            "memDoc": "硃71",
            "memTitle": "為接咨挑選戰兵預備赴臺策應並擬親赴潮州事",
            "summary": "只保留皇帝自己的評論、答覆或命令；同義硃批與上諭合為一項。",
            "points": [
              {
                "title": "肯定孫士毅嚴密巡防沿海隘口並預挑水師一千名備調之防禦部署",
                "aspect": "approve",
                "action_type": "approve",
                "how": "乾隆帝讚許兩廣總督孫士毅於閩粵交界及沿海隘口嚴密巡防盤詰，並預先挑選水師戰兵一千名備足軍火口糧以資策應之部署，評為『此係當辦之事』與『好』。",
                "description": "乾隆帝讚許兩廣總督孫士毅於閩粵交界及沿海隘口嚴密巡防盤詰，並預先挑選水師戰兵一千名備足軍火口糧以資策應之部署，評為『此係當辦之事』與『好』。",
                "whenCh": "乾隆五十二年正月十三日",
                "whenAr": "1787/01/13",
                "where": "北京",
                "who": [
                  "乾隆帝",
                  "孫士毅"
                ],
                "whoLoc": {
