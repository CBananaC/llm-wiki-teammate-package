                        "evidence": "為提臣黃仕簡一路接應",
                        "relation": "接應",
                        "relation_type": "ally",
                        "source": "徐嗣曾",
                        "target": "黃仕簡"
                      }
                    ],
                    "response_date": "乾隆五十二年正月初十日",
                    "response_quote": "初十日辰刻回署途次，承准廷寄十二月二十七日奉上諭：「賊匪么麼烏合，黃仕簡到彼，督率該鎮道分路夾攻，盡力堵剿，無難立就撲滅。」等因。欽此。",
                    "subtitle": "徐嗣曾遵旨知悉十二月二十七日上諭並呈報沿海防務",
                    "where": "福建省城",
                    "who": [
                      "徐嗣曾",
                      "黃仕簡"
                    ],
                    "who_loc": {
                      "徐嗣曾": "福建省城",
                      "黃仕簡": "料羅"
                    }
                  },
                  {
                    "action_quote": "並著該督撫查明該縣，如平日並無別項劣跡及激變情事，即據實奏聞，候朕降旨交部議恤。",
                    "doc_id": "硃105",
                    "how": "常青於正月十一日接獲十二月二十七日上諭後，於翌日具奏說明臺灣軍情與兵力調遣狀況。同時遵旨查明彰化縣俞峻係上年十月甫抵任，實因帶兵緝匪致被戕害，平日並無別項劣跡及激變情事，合並陳明請旨議恤。",
                    "receive_date": "乾隆五十二年正月十一日",
                    "relations": [
                      {
                        "evidence": "實因緝拿賊匪，致被戕害",
                        "relation": "戕害",
                        "relation_type": "conflict",
                        "source": "林爽文",
                        "target": "俞峻"
                      }
                    ],
                    "response_date": "乾隆五十二年正月十二日",
                    "response_quote": "竊臣於正月十一日承准大學士公阿桂、大學士和珅字寄，乾隆五十一年十二月二十七日奉上諭：「據常青等奏，臺灣彰化縣匪徒林爽文等結黨滋事，騷擾地方。等語。著傳諭常青徐嗣曾等，總須不動聲色，妥協辦理，迅速由六百里加緊復〔覆〕奏。云云。」欽此。……再，查彰化縣俞峻，係上年十月甫經抵任，實因緝拿賊匪，致被戕害，並無別項劣跡，合並陳明，伏乞皇上睿鑒。謹奏。",
                    "subtitle": "常青查明彰化縣俞峻無劣跡遵旨奏聞備議恤",
                    "where": "泉州",
                    "who": [
                      "常青",
                      "俞峻",
                      "林爽文"
                    ],
                    "who_loc": {
                      "俞峻": "彰化縣",
                      "常青": "泉州",
                      "林爽文": "彰化縣"
                    }
                  }
                ]
