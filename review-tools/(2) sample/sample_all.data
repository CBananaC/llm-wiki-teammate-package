                "__pendingResponses": [
                  {
                    "action_quote": "已降旨，將易連於事竣後送部引見矣。",
                    "doc_id": "硃138",
                    "how": "閩浙總督常青於正月二十二日接獲上諭，得知皇帝嘉獎署都司易連並允予事竣後引見。常青隨即於次日具折謝恩，表示感激涕零，並覆奏當時大兵會剿進度，以及易連、陳邦光等人在鹿港、新莊一帶攻殺賊匪、保護地方的防剿情形。",
                    "receive_date": "1787-02-09",
                    "relations": [
                      {
                        "evidence": "其鹿港、新莊一帶，又據署守備陳邦光、署都司易連及義民人等，攻殺賊匪，保護各境，俱經臣等節次奏聞在案。",
                        "relation": "奏報防剿功績",
                        "relation_type": "report",
                        "source": "常青",
                        "target": "易連"
                      },
                      {
                        "evidence": "其鹿港、新莊一帶，又據署守備陳邦光、署都司易連及義民人等，攻殺賊匪，保護各境，俱經臣等節次奏聞在案。",
                        "relation": "奏報防剿功績",
                        "relation_type": "report",
                        "source": "常青",
                        "target": "陳邦光"
                      },
                      {
                        "evidence": "聞黃仕簡於正月十二、三等日定期會剿",
                        "relation": "關注會剿進度",
                        "relation_type": "report",
                        "source": "常青",
                        "target": "黃仕簡"
                      },
                      {
                        "evidence": "任承恩於十一日在鹿仔港殺賊祭旗",
                        "relation": "關注進兵動態",
                        "relation_type": "report",
                        "source": "常青",
                        "target": "任承恩"
                      }
                    ],
                    "response_date": "1787-02-10",
                    "response_quote": "欽此。寄信到臣，仰蒙聖慈訓諭周詳，無微不到。臣跪讀之下，感激涕零，莫能言喻。一切調度事宜，惟有矢慎矢勤，竭力經理，斷不敢稍滋疏誤。...其鹿港、新莊一帶，又據署守備陳邦光、署都司易連及義民人等，攻殺賊匪，保護各境，俱經臣等節次奏聞在案。",
                    "subtitle": "常青遵旨謝恩並覆奏易連等地方防剿情形",
                    "where": "鹿港",
                    "who": [
                      "常青",
                      "易連",
                      "陳邦光",
                      "黃仕簡",
                      "任承恩"
                    ],
                    "who_loc": {
                      "任承恩": "鹿港",
                      "常青": "泉州",
                      "易連": "鹿港",
                      "陳邦光": "鹿港",
                      "黃仕簡": "臺灣府城"
                    }
                  }
                ]
              },
              {
                "title": "肯定並獎勵義民客民協防",
                "aspect": "praise",
                "action_type": "praise",
                "how": "皇帝對黃朝陽、邱龍四等生監及本處、廣東義民協同官兵攻殺賊匪、保護地方的義舉表示高度嘉獎，指示督撫於事竣後分別予以優獎，並對受傷陣亡的義民照兵丁之例一體撫恤。",
                "description": "皇帝對黃朝陽、邱龍四等生監及本處、廣東義民協同官兵攻殺賊匪、保護地方的義舉表示高度嘉獎，指示督撫於事竣後分別予以優獎，並對受傷陣亡的義民照兵丁之例一體撫恤。",
                "whenCh": "乾隆五十二年正月初十日",
                "whenAr": "1787-01-10",
                "where": "北京",
                "who": [
                  "乾隆帝"
                ],
                "whoLoc": {
                  "乾隆帝": "北京"
                },
                "relations": [
                  "常青",
                  "黃朝陽",
                  "邱龍四",
                  "林貴陽"
                ],
                "memorial_relation": "direct",
                "relevance_reason": "本奏摺詳細列舉了黃朝陽、邱龍四、林貴陽等生監與義民在各處戰役中奮勇殺賊、燒毀賊巢及救出官眷的戰功，同時提及義民亦有傷亡。皇帝對此逐一做出硃批嘉獎，並在隨後的上諭中下達具體的賞恤命令。",
                "memorial_anchor": "皆當優獎",
                "memorial_quote": "皆當優獎",
                "memorial_position": "夾批",
                "memorial_context_quote": "監生黃朝陽、林講、徐修等",
                "edict_quote": "至該處生監及本處並廣東商民，激發公義，志切同仇，共相糾衆，攻殺賊匪，保護地方，實堪嘉獎。著該督等查明，分別連賞，以示優獎。其義民內有被賊傷害者，並著該督等於事竣後，查明具奏，照陣亡兵丁之例，一體議恤。",
                "sources": [
                  {
                    "doc_id": "硃64",
                    "source_type": "硃批",
                    "position": "夾批",
                    "quote": "皆當優獎",
                    "context_quote": "監生黃朝陽、林講、徐修等",
                    "title": "為招募義民實力防守及發兵渡臺情形事",
                    "date": "1787/01/10"
                  },
                  {
                    "doc_id": "硃64",
                    "source_type": "硃批",
                    "position": "夾批",
                    "quote": "亦當旌賞",
                    "context_quote": "又廣省義民邱龍四、林貴陽等",
                    "title": "為招募義民實力防守及發兵渡臺情形事",
