        "evTitle": "乾隆帝命督撫等迅速將剿捕及獲犯情形復奏",
        "addressee": "常青、徐嗣曾",
        "action_doc_ids": [],
        "source_doc_ids": [],
        "confirmedPairsOnly": true,
        "prompt": "（本機技能輸出：outputs/official-response.json）",
        "items": [
          {
            "action_quote": "仍將現在剿捕及有無續獲首夥各犯情形，迅速由六百里復奏。",
            "doc_id": "硃94",
            "how": "福建巡撫徐嗣曾於正月初十日接獲十二月二十七日上諭後，當即具摺覆奏前線軍情與緝捕進展。文中詳細說明官兵及泉粵義民殺賊、收復彰化並擒獲賊目高文麟等四犯之經過，同時呈報沿海口岸嚴密巡防、搜拿燒沉賊船及漳州原籍防範示諭等處置，以回應皇帝迅速彙報剿捕獲犯情形之指示。",
            "receive_date": "乾隆五十二年正月初十日",
            "relations": [
              {
                "evidence": "並據陳邦光收復彰化等處，擒獲賊目高文麟等四犯",
                "relation": "擒獲",
                "relation_type": "conflict",
                "source": "陳邦光",
                "target": "高文麟"
              }
            ],
            "response_date": "乾隆五十二年正月初十日",
            "response_quote": "初十日辰刻回署途次，承准廷寄十二月二十七日奉上諭：「賊匪么麼烏合，黃仕簡到彼，督率該鎮道分路夾攻，盡力堵剿，無難立就撲滅。」等因。欽此。臣查賊匪自彰化滋事之後，雖又攻搶諸羅、淡水、鳳山，但如艋舺、鹿港等處，各有泉州、廣東義民數千人，奮勇急公。經署都司易連、署守備陳邦光等，率同官兵連次殺賊。並據陳邦光收復彰化等處，擒獲賊目高文麟等四犯，而總兵柴大紀於十二月十一、二、三等日，亦連殺賊匪甚多。",
            "subtitle": "徐嗣曾遵旨覆奏沿海防範與前線兵勇抗剿及緝捕賊目等辦理情形",
            "where": "福州",
            "who": [
              "徐嗣曾",
              "陳邦光",
              "高文麟",
              "柴大紀",
              "蔡攀龍",
              "黃仕簡",
              "任承恩"
            ],
            "who_loc": {
              "任承恩": "廈門",
              "徐嗣曾": "福州",
              "柴大紀": "臺灣府城",
              "蔡攀龍": "臺灣府城",
              "陳邦光": "彰化",
              "高文麟": "彰化",
              "黃仕簡": "料羅"
            }
          },
          {
            "action_quote": "仍將現在剿捕及有無續獲首夥各犯情形，迅速由六百里復奏。",
            "doc_id": "硃105",
            "how": "閩浙總督常青於正月初十一日奉到十二月二十七日上諭，旋即於次日覆奏。常青彙報水陸提臣黃仕簡、任承恩放洋進剿日期，以及廣東、福建各地調派官兵增援之部署，並陳明漳浦縣已盤獲匪犯陳樵提訊確究，展現鎮靜辦理、無過度張皇之情形。",
            "receive_date": "乾隆五十二年正月初十一日",
            "relations": [
              {
                "evidence": "已據漳浦縣羅澤坤稟報，盤獲匪犯陳樵一名",
                "relation": "盤獲",
                "relation_type": "conflict",
                "source": "羅澤坤",
                "target": "陳樵"
              }
            ],
            "response_date": "乾隆五十二年正月十二日",
            "response_quote": "臣於正月十一日承准大學士公阿桂、大學士和珅字寄，乾隆五十一年十二月二十七日奉上諭：「據常青等奏，臺灣彰化縣匪徒林爽文等結黨滋事，騷擾地方。等語。著傳諭常青徐嗣曾等，總須不動聲色，妥協辦理，迅速由六百里加緊復〔覆〕奏。云云。」欽此。……其餘沿海口岸，嚴飭文武員弁，實力巡查，已據漳浦縣羅澤坤稟報，盤獲匪犯陳樵一名，現在飭提確究，臣唯有鎮靜辦理，不敢過涉張皇，以仰副聖主諄切訓誡之至意。",
            "subtitle": "常青遵旨覆奏各路官兵派撥赴臺進剿及盤獲匪犯陳樵之辦理情形",
            "where": "泉州",
            "who": [
              "常青",
              "徐嗣曾",
              "黃仕簡",
              "任承恩",
              "羅澤坤",
              "陳樵"
            ],
