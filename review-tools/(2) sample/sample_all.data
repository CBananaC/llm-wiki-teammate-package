                "__pendingResponses": [
                  {
                    "action_quote": "常青、徐嗣曾等，總須不動聲色，妥協辦理。若因外洋遇有此等案件，該督撫等紛紛調遣，跡涉張皇，轉致內地民人心生疑駭，殊有關係，該督撫不可不處以鎮定也。",
                    "doc_id": "硃94",
                    "how": "福建巡撫徐嗣曾覆奏表示，已密札漳州道朱芫會、知府黃彬不動聲色妥為防範，並會同督臣出示曉諭以穩定人心。此外，沿海各口岸已加派兵丁截捕，自己辦理一切事宜唯有事事出以鎮定，絕不敢稍涉張皇，轉滋疑駭。",
                    "receive_date": "乾隆五十二年正月初十日",
                    "relations": [
                      {
                        "evidence": "臣密札該道朱芫會",
                        "relation": "密札",
                        "relation_type": "command",
                        "source": "徐嗣曾",
                        "target": "朱芫會"
                      },
                      {
                        "evidence": "臣密札...知府黃彬",
                        "relation": "密札",
                        "relation_type": "command",
                        "source": "徐嗣曾",
                        "target": "黃彬"
                      }
                    ],
                    "response_date": "1787/01/10",
                    "response_quote": "臣密札該道朱芫會、知府黃彬，不動聲色，妥為防範。復會同督臣出示曉諭，以賊匪雖係漳人，其在臺滋事，與原籍親屬毫無干涉。惟藏匿引逆，例應同罪，將來賊匪潛逃回籍，即捕獲首報，並懸賞格，剴切示諭。仍令該道府將該處地方情形，按日稟報。臣復密加防察，現在實俱寧謐，並無驚疑之處。...臣仰承訓示，辦理一切，惟有事事出以鎮定，不敢稍存疏忽，亦斷不敢稍涉張皇，轉滋疑駭一俟報有剿賊實情，另行飛摺恭奏外，所有臣近日辦理情形，謹由驛恭摺具奏，伏乞皇上睿鑒。",
                    "subtitle": "徐嗣曾奏報密札漳州道府不動聲色妥為防範並事事鎮定不敢張皇",
                    "where": "福州",
                    "who": [
                      "徐嗣曾",
                      "朱芫會",
                      "黃彬"
                    ],
                    "who_loc": {
                      "徐嗣曾": "福州",
                      "朱芫會": "漳州",
                      "黃彬": "漳州"
                    }
                  },
