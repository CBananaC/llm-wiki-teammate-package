                "__pendingResponses": [
                  {
                    "action_quote": "常青仍祇須駐紮蚶江、廈門一帶調度策應，此時總以鎮靜內地爲要。",
                    "doc_id": "硃110",
                    "how": "閩浙總督常青奏報恪遵諭旨，仍駐紮於蚶江與廈門一帶主持調度策應，並以鎮靜內地為第一要務。他表明不敢少動聲色致廑聖懷，並已通飭沿海文武官員嚴密巡查，防止賊匪潛逃回籍。同時會同撫臣曉諭居民懸賞捕拿，務使漳泉民情安輯、內地秩序穩定。",
                    "receive_date": "正月十二日",
                    "relations": [
                      {
                        "evidence": "仍駐蚶江、廈門一帶，調度策應",
                        "relation": "調度策應",
                        "relation_type": "command",
                        "source": "常青",
                        "target": "黃仕簡"
                      },
                      {
                        "evidence": "仍駐蚶江、廈門一帶，調度策應",
                        "relation": "調度策應",
                        "relation_type": "command",
                        "source": "常青",
                        "target": "任承恩"
                      },
                      {
                        "evidence": "鹿港署守備陳邦光擒獲匪黨楊詠等四犯",
                        "relation": "擒獲",
                        "relation_type": "conflict",
                        "source": "陳邦光",
                        "target": "楊詠"
                      }
                    ],
                    "response_date": "1787/01/13",
                    "response_quote": "臣惟恪遵諭旨，仍駐蚶江、廈門一帶，調度策應，務期鎮靜，不敢少動聲色，致廑聖懷。現在漳、泉等處民情，俱各安輯。至臺地逆匪，必須盡數殲除。先據鹿港署守備陳邦光擒獲匪黨楊詠等四犯，業經審明解京，具奏在案。茲又據漳浦縣盤獲匪犯陳樵一名，現在飛提嚴究辦理。臣惟時飭沿海文武員弁，慎密巡查，並與撫臣曉諭居民，懸立重賞，遇有賊匪潛逃回籍，捕獲首報，總不使餘孽得以漏網。",
                    "subtitle": "常青奏遵旨駐紮蚶江廈門並鎮靜調度",
                    "where": "蚶江",
                    "who": [
                      "常青",
                      "黃仕簡",
                      "任承恩",
                      "陳邦光",
                      "楊詠",
                      "陳樵"
                    ],
                    "who_loc": {
