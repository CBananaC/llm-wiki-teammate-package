            "points": [
              {
                "title": "肯定常青調度剿捕事宜稍有主見",
                "aspect": "praise",
                "action_type": "praise",
                "how": "乾隆帝認為常青此次派兵剿捕各項事宜的處置較以往稍有主見且能鎮定，對此表示肯定與寬慰。",
                "description": "乾隆帝認為常青此次派兵剿捕各項事宜的處置較以往稍有主見且能鎮定，對此表示肯定與寬慰。",
                "whenCh": "乾隆五十二年正月初二日",
                "whenAr": "1787/01/02",
