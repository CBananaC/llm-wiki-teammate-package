        "items": [
          {
            "edict_id": "諭36",
            "title": "諭閩浙總督常青等巡撫徐嗣曾越制徵調殊屬矜張著傳旨申飭",
            "date": "1787/01/08",
            "memDoc": "硃59",
            "memTitle": "為准咨奏明調撥各路兵丁情形事",
            "summary": "只保留皇帝自己的評論、答覆或命令；同義硃批與上諭合為一項。",
            "points": [
              {
                "title": "批評常青與徐嗣曾因溝通不及重複調派副將徐鼎士致使兵無所適從，並申飭徐嗣曾越權發兵",
                "aspect": "blame",
                "action_type": "blame",
                "how": "乾隆帝指責閩浙總督常青與福建巡撫徐嗣曾因距離遙遠、關會不及，同時調派副將徐鼎士帶兵渡臺，致使軍隊無所適從，辦理過涉張皇；並申飭徐嗣曾未先會商總督即擅自調動省城兵力赴援，屬於越權之舉。",
                "description": "乾隆帝指責閩浙總督常青與福建巡撫徐嗣曾因距離遙遠、關會不及，同時調派副將徐鼎士帶兵渡臺，致使軍隊無所適從，辦理過涉張皇；並申飭徐嗣曾未先會商總督即擅自調動省城兵力赴援，屬於越權之舉。",
                "whenCh": "乾隆五十二年正月初八日",
                "whenAr": "1787/01/08",
                "where": "",
                "who": [
                  "常青",
                  "徐嗣曾",
                  "徐鼎士"
                ],
                "whoLoc": {
                  "常青": "泉州",
                  "徐嗣曾": "福州",
                  "徐鼎士": "福建"
                },
                "relations": [
                  "常青與徐嗣曾同時調派徐鼎士"
                ],
                "origin_doc_id": "",
                "origin_type": "",
                "origin_quote": "",
                "origin_date": "",
                "same_as_event_id": "evmr4m4u9pu7k",
                "sources": [
                  {
                    "doc_id": "硃59",
                    "source_type": "硃批",
                    "quote": "已有旨了。欽此。",
                    "title": "為准咨奏明調撥各路兵丁情形事",
                    "date": "1787/01/08",
                    "position": "尾批"
                  },
                  {
                    "doc_id": "諭36",
                    "source_type": "上諭",
                    "quote": "看來伊等辦理此事，皆不免過涉張皇。而徐嗣曾於未接督臣會之先，即行調發，固屬急公，略近越俎，已於折內批示。",
                    "title": "諭閩浙總督常青等巡撫徐嗣曾越制徵調殊屬矜張著傳旨申飭",
                    "date": "1787/01/08"
                  },
                  {
                    "doc_id": "硃59",
                    "source_type": "奏摺",
                    "quote": "惟是臣續調之督、撫二標兵一千名，已派令副將徐鼎士帶領，而撫臣所調之督、撫二標兵一千五百名，據稱亦派該將帶領，實緣省城距泉相隔數百里，同時調派，以致關會不及。",
                    "title": "為准咨奏明調撥各路兵丁情形事",
                    "date": "1787/01/08"
                  }
                ],
                "__pendingResponses": [
                  {
                    "action_quote": "看來伊等辦理此事，皆不免過涉張皇。",
                    "doc_id": "硃131",
                    "how": "常青接獲諭旨告誡後附片覆奏，解釋其駐紮泉州而省城相距遠隔，致使兩府調派官兵事宜出現銜接差錯。他強調與撫臣徐嗣曾長期和衷辦理地方事務、同心滅賊，絕無生嫌或各存意見之情事。",
                    "receive_date": "",
                    "relations": [
                      {
                        "evidence": "臣與撫臣徐嗣曾共事日久，一切地方公務，無不和衷辦理",
                        "relation": "和衷辦理",
                        "relation_type": "ally",
                        "source": "常青",
                        "target": "徐嗣曾"
                      },
                      {
                        "evidence": "已咨水師提臣黃仕簡於事竣後，逐一查明，請旨獎賞",
                        "relation": "咨",
                        "relation_type": "command",
                        "source": "常青",
                        "target": "黃仕簡"
                      }
                    ],
                    "response_date": "1787/01/20",
                    "response_quote": "臣跪讀之下，仰見我皇上睿訓周詳，告誡諄切之至意。伏念臣與撫臣徐嗣曾共事日久，一切地方公務，無不和衷辦理。今臺地遠隔重洋，匪徒竊發，恨不令官兵飛渡，滅此朝食。臣與徐嗣曾俱有同心，祗因臣駐紮泉州，距省較遠，以致續調官兵稍有三差，並非各存意見。況軍務尤關緊要，臣斷不敢因此生嫌，上廑聖懷。",
                    "subtitle": "常青覆奏與徐嗣曾因兩地相隔致續調官兵稍有差錯並非互存意見",
                    "where": "泉州",
