        "items": [
          {
            "edict_id": "諭89",
            "title": "諭閩浙總督李侍堯等擒獲首要解京審辦並速建郡城",
            "date": "1787/02/04",
            "memDoc": "硃128",
            "memTitle": "為奏聞調度水陸官兵守禦府城事",
            "summary": "只保留皇帝自己的評論、答覆或命令；同義硃批與上諭合為一項。",
            "points": [
              {
                "title": "肯定柴大紀守禦府城調度合宜並指示常青等務以擒獲首犯林爽文為要",
                "aspect": "praise",
                "action_type": "praise",
                "how": "乾隆帝肯定柴大紀調度水陸官兵四面守禦臺灣府城之部署合乎機宜，並指出目前大兵已到、賊匪奔逃四散，要求常青等督率鎮將乘勝搜捕，務以擒獲首犯解京審辦為要。",
                "description": "乾隆帝肯定柴大紀調度水陸官兵四面守禦臺灣府城之部署合乎機宜，並指出目前大兵已到、賊匪奔逃四散，要求常青等督率鎮將乘勝搜捕，務以擒獲首犯解京審辦為要。",
                "whenCh": "乾隆五十二年二月初四日",
                "whenAr": "1787/02/04",
                "where": "京城",
                "who": [
                  "乾隆帝",
                  "柴大紀",
                  "常青",
                  "林爽文"
                ],
                "whoLoc": {
                  "常青": "福建",
                  "林爽文": "臺灣",
                  "柴大紀": "臺灣府城"
                },
                "relations": [],
                "origin_doc_id": "",
                "origin_type": "",
                "origin_quote": "",
                "origin_date": "",
                "same_as_event_id": "",
                "sources": [
                  {
                    "doc_id": "硃128",
                    "source_type": "硃批",
                    "quote": "所辦皆合機宜，目今大兵已到，賊匪四散，惟擒獲首犯為要。勉為之。欽此。",
                    "title": "為奏聞調度水陸官兵守禦府城事",
                    "date": "1787/02/04",
                    "position": "尾批"
                  },
                  {
                    "doc_id": "諭89",
                    "source_type": "上諭",
                    "quote": "大紀所辦，尚合機宜。現在大兵已到，賊匪奔逃四散。水陸二提督剋期會剿，自必立時撲滅。常青等惟當督率鎮將，擒獲首要各犯，解京審辦。並乘此兵力，上緊搜捕，務盡根株，以靖海疆。",
                    "title": "諭閩浙總督李侍堯等擒獲首要解京審辦並速建郡城",
                    "date": "1787/02/04"
                  },
                  {
                    "doc_id": "硃128",
                    "source_type": "奏摺",
                    "quote": "福建臺灣鎮總兵官奴才柴大紀謹奏，為調度水陸官兵四面守禦，力保郡城，待應援以圖恢復，恭摺奏聞事。",
                    "title": "為奏聞調度水陸官兵守禦府城事",
                    "date": "1787/02/04"
                  }
                ],
                "__repeatId": "硃128#emperor#candidate"
              },
              {
                "title": "針對參將瑚圖里重新回郡城率兵禦敵指示常青於事竣後核明功罪並給諮送京候詢",
                "aspect": "command",
                "action_type": "command",
                "how": "針對柴大紀奏報參將瑚圖里就桶盤棧紮營禦敵，乾隆帝考慮瑚圖里此前在鳳山兵散避鋒非臨陣退縮，今既回郡城奮勉出力，指示常青於事竣後秉公核明其功罪具奏，並將瑚圖里給諮送京候詢。",
                "description": "針對柴大紀奏報參將瑚圖里就桶盤棧紮營禦敵，乾隆帝考慮瑚圖里此前在鳳山兵散避鋒非臨陣退縮，今既回郡城奮勉出力，指示常青於事竣後秉公核明其功罪具奏，並將瑚圖里給諮送京候詢。",
                "whenCh": "乾隆五十二年二月初四日",
                "whenAr": "1787/02/04",
                "where": "京城",
                "who": [
                  "乾隆帝",
                  "瑚圖裏",
                  "常青",
                  "柴大紀"
                ],
                "whoLoc": {
                  "常青": "福建",
                  "柴大紀": "臺灣府城",
                  "瑚圖裏": "桶盤棧"
                },
                "relations": [],
                "origin_doc_id": "",
                "origin_type": "",
                "origin_quote": "",
                "origin_date": "",
                "same_as_event_id": "",
                "sources": [
                  {
                    "doc_id": "諭89",
                    "source_type": "上諭",
                    "quote": "朕以該參將之不能抵禦，由於兵散，獨力難支，其勢不得不暫避其鋒，與臨陣退縮者不同，曾諭令常青事定後，核其功罪，分別辦理。今該參將業已回至郡城，率兵堵御。如果奮勉出力，殺獲賊衆，則功過尚足以相抵。著常事竣後，秉公核明功罪，據實具，並將該參將給諮送京，候朕詢問臺地一切情形。",
                    "title": "諭閩浙總督李侍堯等擒獲首要解京審辦並速建郡城",
                    "date": "1787/02/04"
                  },
                  {
                    "doc_id": "硃128",
                    "source_type": "奏摺",
                    "quote": "並南路參將瑚圖里，就此紮營。",
                    "title": "為奏聞調度水陸官兵守禦府城事",
                    "date": "1787/02/04"
                  }
                ],
                "__pendingResponses": [
                  {
                    "action_quote": "著常事竣後，秉公核明功罪，據實具，並將該參將給諮送京，候朕詢問臺地一切情形。",
                    "doc_id": "硃226",
                    "how": "常青奏稱於二月十六日奉到諭旨，知悉參將瑚圖里已回至郡城率兵堵截、若殺獲賊眾功過尚可相抵之指示。常青表示將遵旨於剿捕事竣之日，秉公查明瑚圖里功罪據實奏聞，並給諮送京候詢。",
                    "receive_date": "二月十六日",
                    "relations": [
                      {
                        "evidence": "並於事竣之日，查明參將瑚圖里功罪，據實奏聞",
                        "relation": "查明功罪",
                        "relation_type": "command",
                        "source": "常青",
                        "target": "瑚圖里"
                      }
                    ],
                    "response_date": "乾隆五十二年二月十九日",
                    "response_quote": "一面諭知任承恩迅速赴京，無庸疑懼。並於事竣之日，查明參將瑚圖里功罪，據實奏聞，給咨送部外，所有臣節次奉到諭旨，及起程赴臺欽遵辦理緣由，理合恭摺覆奏，伏乞皇上睿鑒。",
                    "subtitle": "常青遵旨俟剿捕事竣後查明參將瑚圖里功罪據實奏聞並給諮送京",
