      ],
      "whoLoc": {},
      "relations": [
        {
          "from": "徐嗣曾",
          "to": "乾隆帝",
          "type": "奏報飭屬不動聲色辦理"
        }
      ],
      "provenance": [],
      "whenCh": "乾隆五十一年十二月二十七日",
      "dateAr": "1786/12/27",
