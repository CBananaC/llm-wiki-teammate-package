                "__pendingResponses": [
                  {
                    "action_quote": "若一聞稟報，即行調動各營兵丁，而派出帶兵之員，督臣又經檄調，轉致兵無所適從。",
                    "doc_id": "硃131",
                    "how": "閩浙總督常青奏報，他與福建巡撫徐嗣曾共事已久，向來和衷共濟辦理地方公務。因他當時駐紮泉州，距離省城較遠，導致在續調官兵時有些微時間差，但絕非彼此存有意見或生嫌，請皇帝寬心。",
                    "receive_date": "",
                    "relations": [
                      {
                        "evidence": "接准撫臣咨會，將備調省城兵一千五百名",
                        "relation": "咨會",
                        "relation_type": "report",
                        "source": "徐嗣曾",
                        "target": "常青"
                      },
                      {
                        "evidence": "已咨水師提臣黃仕簡於事竣後，逐一查明，請旨獎賞",
                        "relation": "咨",
                        "relation_type": "other",
                        "source": "常青",
                        "target": "黃仕簡"
                      }
                    ],
                    "response_date": "1787/01/20",
                    "response_quote": "臣跪讀之下，仰見我皇上睿訓周詳，告誡諄切之至意。伏念臣與撫臣徐嗣曾共事日久，一切地方公務，無不和衷辦理。今臺地遠隔重洋，匪徒竊發，恨不令官兵飛渡，滅此朝食。臣與徐嗣曾俱有同心，祗因臣駐紮泉州，距省較遠，以致續調官兵稍有三差，並非各存意見。況軍務尤關緊要，臣斷不敢因此生嫌，上廑聖懷。",
                    "subtitle": "常青奏明與徐嗣曾並無意見且和衷共濟",
                    "where": "泉州",
                    "who": [
                      "常青",
                      "徐嗣曾",
                      "黃仕簡"
                    ],
                    "who_loc": {
                      "常青": "泉州",
                      "徐嗣曾": "省城",
                      "黃仕簡": "臺灣"
                    }
                  },
                  {
                    "action_quote": "至巡撫遇有此等事件，理應鎮靜地方，將軍需糧餉等務，妥爲籌備，以資接濟。",
                    "doc_id": "奏127",
                    "how": "福建巡撫徐嗣曾上摺引咎自責，承認自己在派遣兵力赴淡水時，因情況緊急而未及與總督常青札商便自行調派，確實屬於越俎與張皇。他表示總督常青對此並無芥蒂，兩人仍協力同心，並已妥善籌備軍需糧餉、水陸運送，且加強內地鎮靜與防堵。",
                    "receive_date": "",
                    "relations": [
                      {
                        "evidence": "因巡檢王增錞稟請救援迫切",
                        "relation": "稟請",
                        "relation_type": "report",
                        "source": "王增錞",
                        "target": "徐嗣曾"
                      },
                      {
                        "evidence": "竟一面奏派，一面咨會督臣",
                        "relation": "咨會",
                        "relation_type": "report",
                        "source": "徐嗣曾",
                        "target": "常青"
                      },
                      {
                        "evidence": "據廈防同知劉嘉會稟報",
                        "relation": "稟報",
                        "relation_type": "report",
                        "source": "劉嘉會",
                        "target": "徐嗣曾"
                      }
                    ],
                    "response_date": "1787/02/02",
                    "response_quote": "遣將調兵，本應督臣主政，乃臣於派兵赴淡水一節，因巡檢王增錞稟請救援迫切，急求集事，竟一面奏派，一面咨會督臣，未及札商辦理。事後捫心自訟，實屬過涉張皇，近於越俎，咎無可辭。至督臣遇有公事，悉皆開誠剖示，總以協力同心，相為期勉。即如臣調兵赴淡水，未及待督臣咨覆，臣之錯謬已難自解，而督臣並不因此稍存意見，惟以公事為重，虛衷斟酌，將所調省兵留省彈壓，改用延、建之兵，由六赴廈，悉皆往返札商，議歸畫一。",
                    "subtitle": "徐嗣曾引咎自責越權調兵並妥籌軍需",
                    "where": "省城",
                    "who": [
                      "徐嗣曾",
                      "常青",
                      "王增錞",
                      "劉嘉會"
                    ],
                    "who_loc": {
                      "劉嘉會": "廈門",
                      "常青": "泉州",
                      "徐嗣曾": "省城",
                      "王增錞": "淡水"
                    }
                  },
                  {
                    "action_quote": "雖巡撫有封疆之責，原不得稍存膜視，但調發兵棄，自應札商督臣，公同檄調",
                    "doc_id": "硃174",
                    "how": "署廣東提督彭承堯奏報，他收到福建巡撫徐嗣曾因臺灣匪亂、恐兵力單薄而請求廣東撥兵支援的札文後，立即轉咨兩廣總督孫士毅。隨後配合孫士毅的調度，將水師兵力經陸路開赴廈門聽候閩浙總督調遣，其餘兵力則在閩粵交界駐紮備調。",
                    "receive_date": "",
