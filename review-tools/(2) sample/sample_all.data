                "target": "董得魁"
              }
            ],
            "sources": [
              {
                "doc_id": "硃31",
                "quote": "賊匪眾多，抵敵不住，我父親存亡不知。",
                "howKnown": "",
                "whenKnown": ""
              }
            ],
            "__traceChains": [
              {
                "events": [
                  {
                    "quote": "賊匪眾多，抵敵不住，我父親存亡不知。",
                    "reporter": "程必大",
                    "subtitle": "賊匪於中港擊潰清軍",
                    "whenCh": "十二月初七日前",
                    "where": "中港"
                  }
                ],
                "hops": [
                  {
                    "doc_id": "硃31",
                    "from_person": "程必大",
                    "how": "口述",
                    "inferred": false,
                    "layer": 1,
                    "place": "轅門",
                    "quote": "茲于十二日有該廳程峻之子程必大，奔赴奴才轅門求見，奴才立即傳進。據程必大懷取淡防同知關防，請求救援。……奴才率同地方官詢問，據程必大供：我父親程峻，現署淡水同知，駐紮竹塹。因彰化賊匪滋事，我父親會同董守備帶領兵役鄉勇，前赴中港地方堵禦。賊匪眾多，抵敵不住，我父親存亡不知。",
                    "to_person": "任承恩",
                    "whenAr": "1786/12/12",
                    "whenCh": "十二月十二日"
                  }
                ]
              },
              {
                "events": [
                  {
                    "quote": "連日隨同守備董得魁會同程廳官帶兵在中港地方堵禦賊匪。到本月初七日，不料賊匪漸多，兵少不敵",
                    "reporter": "虞文光、王元浩",
                    "subtitle": "賊匪於中港擊潰清軍",
                    "whenCh": "十二月初七日",
                    "where": "中港"
                  }
                ],
                "hops": [
                  {
                    "doc_id": "硃31",
                    "from_person": "虞文光、王元浩",
                    "how": "口述",
                    "inferred": false,
                    "layer": 1,
                    "place": "",
                    "quote": "有北路竹塹營外委虞文光、兵丁王元浩，亦先後投到求救。奴才率同地方官詢問，……問據外委虞文光供：外委係現任臺灣北路竹塹營外委，連日隨同守備董得魁會同程廳官帶兵在中港地方堵禦賊匪。到本月初七日，不料賊匪漸多，兵少不敵……又問據兵丁王元浩供同。",
                    "to_person": "任承恩",
                    "whenAr": "",
                    "whenCh": ""
                  }
                ]
              }
            ],
