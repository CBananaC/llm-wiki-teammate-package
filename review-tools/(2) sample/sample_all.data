                  {
                    "doc_id": "諭62",
                    "source_type": "上諭",
                    "quote": "惟竄匿賊黨，恐有逃至原籍及內地者，當於各海口，不動聲色，嚴行防範截拿，此則徐嗣曾應辦之事。該撫務督飭所屬，嚴密鎮靜妥辦，不可張皇疏忽。",
                    "title": "諭欽差湖廣總督李侍堯等徐嗣曾離省往閩安著傳旨申飭",
                    "date": "1787/01/22"
                  },
                  {
                    "doc_id": "硃94",
                    "source_type": "奏摺",
                    "quote": "而漳州一屬，係賊匪原籍，誠慮有勾串連結情事。臣密札該道朱芫會、知府黃彬，不動聲色，妥為防範",
                    "title": "為恭摺覆奏督催官兵放洋及巡查海口等緣由事",
                    "date": "1787/01/22"
                  }
                ],
                "__pendingResponses": [
                  {
                    "action_quote": "當於各海口，不動聲色，嚴行防範截拿，此則徐嗣曾應辦之事。該撫務督飭所屬，嚴密鎮靜妥辦，不可張皇疏忽。",
                    "doc_id": "硃172",
                    "how": "徐嗣曾遵旨將沿海各口岸之防範嚴緝列為分內最要之事，已嚴飭文武員弁加意堵截查拿。同時回報署漳浦縣知縣羅澤坤盤獲在臺從逆後因病潛回之匪犯陳榜，印證賊匪竄回原籍之威脅，並保證將持續嚴密鎮靜妥辦，絕不敢稍涉張皇或疏忽。",
                    "receive_date": "乾隆五十二年二月初四日",
