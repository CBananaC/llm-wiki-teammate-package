                "events": [
                  {
                    "quote": "二十九日即劫彰化縣城。因存兵無多，被賊攻入。孫知府並理番同知長庚、前署彰化縣事俸滿臺防同知劉亨基、署典史事鹿港巡檢馮啟宗、北協中營王都司及弁兵數十人，俱被殺害。",
                    "reporter": "署鹿仔港守備陳邦光",
                    "subtitle": "匪徒攻陷彰化縣城",
                    "whenCh": "十一月二十九日",
                    "where": "彰化縣城"
                  }
                ],
                "hops": [
                  {
                    "doc_id": "硃82",
                    "from_person": "署鹿仔港守備陳邦光",
                    "how": "稟報",
                    "inferred": false,
                    "layer": 1,
                    "place": "鹿仔港",
                    "quote": "茲於十二月二十七日亥刻，接得該署備陳邦光兩稟同時並到。內十二月十一一稟，據稱：彰化縣近山之大里杙，有漳州積匪林爽文等，糾夥搶劫，擾害地方。先蒙鎮道飭令耿遊、孫知府赴彰督拿，孫知府駐紮縣城，耿遊擊與北協赫副將、彰化縣俞峻帶領兵役，親往大墩莊等處搜捕。詎該犯等始則竄遁山邊，旋復糾約數千人，於十一月二十七夜搶劫大墩營盤，全軍俱陷。",
                    "to_person": "閩浙總督常青",
                    "whenAr": "1786/12/11",
                    "whenCh": "十二月十一日"
                  }
                ]
              }
            ],
            "__repeatId": "硃82#lin#candidate"
          }
        ],
