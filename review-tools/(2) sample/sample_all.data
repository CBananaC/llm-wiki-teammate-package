        "items": [
          {
            "edict_id": "諭51",
            "title": "諭閩浙總督常青審辦楊振國等其首要家屬容後拿辦",
            "date": "1787/01/15",
            "memDoc": "硃83",
            "memTitle": "為奏聞鳳山失陷援兵渡海赴臺事",
            "summary": "只保留皇帝自己的評論、答覆或命令；同義硃批與上諭合為一項。",
            "points": [
              {
                "title": "指示常青等地方大員應以鎮靜為要毋得張皇失措",
                "aspect": "command",
                "action_type": "command",
                "how": "乾隆帝針對常青奏報鳳山失陷、郡城告急以及飛速派兵赴臺救援等情，於硃批及上諭中均明確批示此時應以鎮靜為要，切勿張皇失措。",
                "description": "乾隆帝針對常青奏報鳳山失陷、郡城告急以及飛速派兵赴臺救援等情，於硃批及上諭中均明確批示此時應以鎮靜為要，切勿張皇失措。",
                "whenCh": "乾隆五十二年正月十五日",
                "whenAr": "1787/01/15",
                "where": "北京",
                "who": [
                  "乾隆帝",
                  "常青"
                ],
                "whoLoc": {
                  "乾隆帝": "北京",
                  "常青": "泉州"
                },
                "relations": [],
                "origin_doc_id": "",
                "origin_type": "",
                "origin_quote": "",
                "origin_date": "",
                "same_as_event_id": "evmrd7h9uvygs",
                "sources": [
                  {
                    "doc_id": "硃83",
                    "source_type": "硃批",
                    "quote": "此時惟以鎮靜為要，毋得張皇失措，餘有旨諭。欽此。",
                    "title": "為奏聞鳳山失陷援兵渡海赴臺事",
                    "date": "1787/01/15",
                    "position": "尾批"
                  },
                  {
                    "doc_id": "諭51",
                    "source_type": "上諭",
                    "quote": "此時常青等惟以鎮靜爲要，毋致張皇失措。",
                    "title": "諭閩浙總督常青審辦楊振國等其首要家屬容後拿辦",
                    "date": "1787/01/15"
                  },
                  {
                    "doc_id": "硃83",
                    "source_type": "奏摺",
                    "quote": "事在危急，相應飛稟迅撥大兵來臺，以便克期進剿，恢復諸、彰等邑，不勝惶悚待命之至。",
                    "title": "為奏聞鳳山失陷援兵渡海赴臺事",
                    "date": "1787/01/15"
                  }
                ],
                "__pendingResponses": [
                  {
                    "action_quote": "此時常青等惟以鎮靜爲要，毋致張皇失措。",
                    "doc_id": "硃146",
                    "how": "閩浙總督常青奏覆於正月二十八日奉到正月十五日上諭。常青遵旨將要犯家屬密為存記俟事竣查辦，並陳明內地民情極其寧貼，自己與地方官員必事事處以鎮靜，斷不敢稍涉張皇致滋驚駭。",
                    "receive_date": "1787/01/28",
                    "relations": [
                      {
                        "evidence": "臣即經咨明黃仕簡嚴切究追",
                        "relation": "咨明",
                        "relation_type": "report",
                        "source": "常青",
                        "target": "黃仕簡"
                      },
                      {
                        "evidence": "嗣據柴大紀稟報：瑚圖里已馳赴軍前，飭令前往桶盤棧營盤，協同遊擊蔡攀龍堵禦賊匪",
                        "relation": "飭令",
                        "relation_type": "command",
                        "source": "柴大紀",
                        "target": "瑚圖里"
                      }
                    ],
                    "response_date": "1787/01/28",
                    "response_quote": "嗣後如有續獲要犯，其家屬住居原籍者，臣恪遵訓示，密為存記，統俟剿匪事竣，會同提臣查拿究辦。臣惟有事事處以鎮靜，斷不敢稍涉張皇，致滋驚駭。再，查南路參將瑚圖里前據報鳳山失守之時，該參將不知下落，臣即經咨明黃仕簡嚴切究追。",
                    "subtitle": "常青遵旨表示內地民情寧貼將事事處以鎮靜不敢稍涉張皇",
                    "where": "泉州",
                    "who": [
                      "常青",
                      "陳邦光",
                      "楊振國",
                      "黃仕簡",
                      "瑚圖里",
