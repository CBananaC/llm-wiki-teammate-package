        "items": [
          {
            "action_quote": "爾鄰省更宜鎮靜，無因一、二賊匪騷動各省之理",
            "doc_id": "硃160",
            "how": "兩廣總督孫士毅接獲諭旨後，深感慚悚，自責才庸識淺、不知輕重緩急，因惑於漳潮壤接民情疑恐而輕率親赴彈壓。孫士毅表示已將防範稽查事宜交由署提督彭承堯暫駐潮州料理，自己則遵旨於正月二十六日起程返回省城。",
            "receive_date": "乾隆五十二年正月二十四日",
            "relations": [
              {
                "evidence": "一切稽查防範事宜，臣遵旨交與署提臣彭承堯，暫駐潮州督率料理",
                "relation": "交與",
                "relation_type": "command",
                "source": "孫士毅",
                "target": "彭承堯"
              }
            ],
            "response_date": "乾隆五十二年正月二十六日",
            "response_quote": "臣跪讀之下，仰見我皇上睿謨廣運，坐照無遺，萬里情形，洞如觀火。臣才庸識淺，不知輕重緩急，惑於漳、潮壤接，民情疑恐，親赴彈壓。一經聖明詳晰指示，臣自知錯謬，不禁慚悚交集。...臣即於正月二十六日起程回省，仍俟續得臺地信息，隨時由驛迅速奏聞。",
            "subtitle": "孫士毅自責不知輕重輕離省城並遵旨交辦防務起程回省",
            "where": "潮州",
            "who": [
              "孫士毅",
              "彭承堯",
              "姚棻"
            ],
            "who_loc": {
              "姚棻": "潮州",
              "孫士毅": "潮州",
              "彭承堯": "潮州"
            }
          }
        ],
