  "硃40": {
    "overallAdj": "乾隆五十一年十一月底，彰化大里杙民變首領林爽文等人聚眾起事，接連攻劫大墩營盤並攻陷彰化縣城，致使副將赫生額、知縣俞峻等文武官員殉難。臺灣鎮總兵柴大紀與兵備道永福於十二月初四日具摺上奏，報告已緊急調兵分防諸羅、鐵線橋等要隘以護衛府城，並檄調澎湖兵力及懇請閩省水陸提督速派大軍渡臺馳援。乾隆皇帝於五十二年正月初二日對此摺批覆「已有旨了」。",
    "divisions": [
      {
        "label": "起因與前情",
        "summary": "奏報林爽文等聚眾謀反，柴大紀等已率兵剿捕，孫景燧亦前往協辦。",
        "start": 0,
        "end": 145,
        "n": 1
      },
      {
        "label": "災情與情報",
        "summary": "陸續接獲逃回兵丁與地方官員稟報，彰化縣城已被攻破，多位文武官員遇害，賊兵意圖進攻諸羅、鹿港及府城。",
        "start": 145,
        "end": 459,
        "n": 2
      },
      {
        "label": "軍事部署",
        "summary": "派兵分赴諸羅剿捕、防守羅漢門要道，並親率兵力駐紮鐵線橋以應援各路。",
        "start": 459,
        "end": 671,
        "n": 3
      },
      {
        "label": "局勢分析與增援",
        "summary": "分析賊勢猖獗且兵力不足，已調澎湖兵並請水陸提督派兵赴臺，同時加強府城防守。",
        "start": 671,
        "end": 832,
        "n": 4
      },
      {
        "label": "結語與馳奏",
        "summary": "將奸民起事、攻陷縣城及傷亡情形，以六百里加急具摺馳奏御覽。",
        "start": 832,
        "end": 924,
        "n": 5
      }
    ],
