        "items": [
          {
            "edict_id": "諭36",
            "title": "諭閩浙總督常青等巡撫徐嗣曾越制徵調殊屬矜張著傳旨申飭",
            "date": "1787/01/08",
            "memDoc": "硃60",
            "memTitle": "為奏聞續派副將徐鼎士統兵出口赴鹿耳門事",
            "summary": "只保留皇帝自己的評論、答覆或命令；同義硃批與上諭合為一項。",
            "points": [
              {
                "title": "乾隆帝申飭巡撫徐嗣曾未待督臣會商即擅自派兵赴援係急公越俎且過涉張皇",
                "aspect": "blame",
                "action_type": "blame",
                "how": "福建巡撫徐嗣曾奏報在未接獲總督常青通知前，即先行調派省城兵一千五百名交副將徐鼎士統領赴援淡水。乾隆帝於硃批及上諭中指出，徐嗣曾辦理軍務雖屬急公近義，但未與總督商榷即擅自動用兵力屬於越俎代庖，且導致重複調派將領、兵無所適從，辦理過涉張皇，下旨予以傳旨申飭。",
                "description": "福建巡撫徐嗣曾奏報在未接獲總督常青通知前，即先行調派省城兵一千五百名交副將徐鼎士統領赴援淡水。乾隆帝於硃批及上諭中指出，徐嗣曾辦理軍務雖屬急公近義，但未與總督商榷即擅自動用兵力屬於越俎代庖，且導致重複調派將領、兵無所適從，辦理過涉張皇，下旨予以傳旨申飭。",
                "whenCh": "乾隆五十二年正月初八日",
                "whenAr": "1787/01/08",
                "where": "",
                "who": [
                  "乾隆帝",
                  "徐嗣曾"
                ],
                "whoLoc": {
                  "徐嗣曾": "福州"
                },
                "relations": [],
                "origin_doc_id": "",
                "origin_type": "",
                "origin_quote": "",
                "origin_date": "",
                "same_as_event_id": "evmr4l52zndmx",
                "sources": [
                  {
                    "doc_id": "硃60",
                    "source_type": "硃批",
                    "quote": "固屬急公，略近越俎，已有旨了。欽此。",
                    "title": "為奏聞續派副將徐鼎士統兵出口赴鹿耳門事",
                    "date": "1787/01/08",
                    "position": "尾批"
                  },
                  {
                    "doc_id": "硃60",
                    "source_type": "奏摺",
                    "quote": "臣以淡水地高〔方〕緊要，即將派備之省兵一千五百名，飭令閩安協副將徐鼎士、臣標遊擊吳秀等統領，克日進發",
                    "title": "為奏聞續派副將徐鼎士統兵出口赴鹿耳門事",
                    "date": "1787/01/08"
                  }
                ],
                "__repeatId": "硃60#emperor#candidate"
              },
              {
                "title": "乾隆帝重申國家調兵體制應由總督主政並指示巡撫遇事應鎮靜地方妥籌軍需",
                "aspect": "command",
                "action_type": "command",
                "how": "乾隆帝因徐嗣曾擅自調兵導致與總督常青後續調度重疊，明確申明國家調兵體制。皇帝指出全省兵力調遣自應由總督主政統轄，巡撫遇有民變事件理應鎮靜地方，著重籌備軍需糧餉，不可一聞稟報即擅自調兵，致使號令兩歧、兵無所適從。",
                "description": "乾隆帝因徐嗣曾擅自調兵導致與總督常青後續調度重疊，明確申明國家調兵體制。皇帝指出全省兵力調遣自應由總督主政統轄，巡撫遇有民變事件理應鎮靜地方，著重籌備軍需糧餉，不可一聞稟報即擅自調兵，致使號令兩歧、兵無所適從。",
                "whenCh": "乾隆五十二年正月初八日",
                "whenAr": "1787/01/08",
                "where": "",
                "who": [
                  "乾隆帝",
                  "徐嗣曾",
                  "常青"
                ],
                "whoLoc": {
                  "常青": "泉州",
                  "徐嗣曾": "福州"
                },
                "relations": [],
                "origin_doc_id": "",
                "origin_type": "",
                "origin_quote": "",
                "origin_date": "",
                "same_as_event_id": "evmr4i9uovo3k",
                "sources": [
                  {
                    "doc_id": "諭36",
                    "source_type": "上諭",
                    "quote": "總督統轄營制，全省兵棄，凡有調遣，自應聽督臣主政。至巡撫遇有此等事件，理應鎮靜地方，將軍需糧餉等務，妥爲籌備，以資接濟。若一聞稟報，即行調動各營兵丁，而派出帶兵之員，督臣又經檄調，轉致兵無所適從。雖巡撫有封疆之責，原不得稍存膜視，但調發兵棄，自應札商督臣，公同檄調，況無迫不及待之情形也。此乃國家體制，不可紊越。",
                    "title": "諭閩浙總督常青等巡撫徐嗣曾越制徵調殊屬矜張著傳旨申飭",
                    "date": "1787/01/08"
                  }
                ],
                "__pendingResponses": [
                  {
                    "action_quote": "總督統轄營制，全省兵棄，凡有調遣，自應聽督臣主政。至巡撫遇有此等事件，理應鎮靜地方，將軍需糧餉等務，妥爲籌備，以資接濟。",
                    "doc_id": "硃131",
                    "how": "常青覆奏表示已恭讀諭旨，說明其與撫臣徐嗣曾平日辦理地方公務均能和衷共濟。此次因自己駐扎泉州、距省城較遠，兩地訊息傳遞不及，才致續調官兵銜接稍有差錯，絕非二人各存意見或互生嫌隙。",
                    "receive_date": "",
                    "relations": [
                      {
                        "evidence": "臣與撫臣徐嗣曾共事日久，一切地方公務，無不和衷辦理",
                        "relation": "和衷辦理",
                        "relation_type": "ally",
                        "source": "常青",
                        "target": "徐嗣曾"
                      },
                      {
                        "evidence": "已咨水師提臣黃仕簡於事竣後，逐一查明，請旨獎賞",
                        "relation": "咨",
                        "relation_type": "command",
                        "source": "常青",
                        "target": "黃仕簡"
                      }
                    ],
                    "response_date": "1787/01/20",
                    "response_quote": "臣正在繕摺具奏間，又接奉上諭：「據常青奏，接准撫臣咨會，將備調省城兵一千五百名。」等因。欽此。臣跪讀之下，仰見我皇上睿訓周詳，告誡諄切之至意。伏念臣與撫臣徐嗣曾共事日久，一切地方公務，無不和衷辦理。今臺地遠隔重洋，匪徒竊發，恨不令官兵飛渡，滅此朝食。臣與徐嗣曾俱有同心，祗因臣駐紮泉州，距省較遠，以致續調官兵稍有三差，並非各存意見。況軍務尤關緊要，臣斷不敢因此生嫌，上廑聖懷。",
                    "subtitle": "常青奏明與巡撫徐嗣曾和衷共事並解釋因兩地相隔致續調官兵稍有差錯",
                    "where": "泉州",
                    "who": [
                      "常青",
                      "徐嗣曾",
                      "黃仕簡"
                    ],
                    "who_loc": {
                      "常青": "泉州",
