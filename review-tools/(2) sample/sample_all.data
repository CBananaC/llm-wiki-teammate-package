    {
      "id": "evmrxa03aoega",
      "actor": "qing",
      "subtitle": "柴大紀帶兵堵截三坎店",
      "description": "臺灣鎮總兵柴大紀帶兵堵截在距離臺灣府城十里的三坎店，阻擋叛軍進攻。",
      "what": "柴大紀帶兵堵截三坎店",
      "where": "三坎店",
      "who": [
        "柴大紀"
      ],
      "whoLoc": {},
      "relations": [],
      "provenance": [
        {
          "id": "pvcmrxa065tczt",
          "hops": [
            {
              "doc_id": "硃41",
              "from_person": "興泉永道萬鐘杰",
              "how": "稟報",
              "inferred": false,
              "layer": 1,
              "place": "廈門",
              "quote": "旋又接據興泉永道萬鐘杰稟稱：十二月十五亥刻，有臺灣典史易鳳翔執持臺灣道印照，同永道家人曹泰、諸榮來廈，當即傳詢。據易典史稱：十一月二十九日賊匪攻陷彰化，十二月初六日卯時，攻破諸羅。柴鎮帶兵堵住離府城十里之三坎店，臺道召募鄉勇，緊守府城。初七夜，臺道因事勢迫急，令該典史同家人二名來廈請救。",
              "to_person": "閩浙總督常青",
              "whenAr": "1786/12/15",
              "whenCh": "十二月十五日",
              "id": "pvmrxa065to9d"
            },
            {
              "doc_id": "硃41",
              "from_person": "臺灣典史易鳳翔",
              "how": "口述",
              "inferred": false,
              "layer": 2,
              "place": "廈門",
              "quote": "十二月十五亥刻，有臺灣典史易鳳翔執持臺灣道印照，同永道家人曹泰、諸榮來廈，當即傳詢。據易典史稱：十一月二十九日賊匪攻陷彰化，十二月初六日卯時，攻破諸羅。柴鎮帶兵堵住離府城十里之三坎店，臺道召募鄉勇，緊守府城。",
              "to_person": "興泉永道萬鐘杰",
              "whenAr": "1786/12/15",
              "whenCh": "十二月十五日",
              "id": "pvmrxa065tum8"
