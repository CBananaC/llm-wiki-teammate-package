                "sources": [
                  {
                    "doc_id": "諭13",
                    "source_type": "上諭",
                    "quote": "賊匪率衆擾諸羅，即被官兵殺死二千餘名。該地方文武，所辦尚好，著黃仕簡前往該處，即行查明。如果屬實，將帶兵剿殺賊匪者系屬何人，並首先出力之員及兵丁，分析具，候朕酌量加恩，以示獎勵。",
                    "title": "諭閩浙總督常青等嚴行殲戮林爽文等並防餘衆四散內渡",
                    "date": "1786/12/27"
                  },
                  {
                    "doc_id": "硃24",
                    "source_type": "奏摺",
                    "quote": "又聽人傳說，賊人赴諸羅縣攻城，被官兵殺死二千餘人。",
                    "title": "為奏接鎮道文報並派遣省兵赴臺事",
                    "date": "1786/12/27"
                  }
                ],
                "__repeatId": "諭13#emperor#candidate"
              },
              {
                "title": "定性彰化知縣俞峻在大墩搜捕賊匪係因公被害並交部議恤",
                "aspect": "command",
                "action_type": "command",
                "how": "乾隆帝就徐嗣曾奏報彰化知縣俞峻帶兵搜捕遇害事宜進行批示，指出俞峻雖防範疏懈，但屬因公倉猝被害，命令督撫查明其平日無劣跡後據實奏聞交部議恤。",
                "description": "乾隆帝就徐嗣曾奏報彰化知縣俞峻帶兵搜捕遇害事宜進行批示，指出俞峻雖防範疏懈，但屬因公倉猝被害，命令督撫查明其平日無劣跡後據實奏聞交部議恤。",
                "whenCh": "乾隆五十一年十二月二十七日",
                "whenAr": "1786/12/27",
                "where": "北京",
                "who": [
                  "乾隆帝",
                  "俞峻",
                  "常青",
                  "徐嗣曾"
                ],
                "whoLoc": {
