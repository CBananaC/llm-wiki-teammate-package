                "sources": [
                  {
                    "doc_id": "諭13",
                    "source_type": "上諭",
                    "quote": "常青、任承恩現住蚶江一帶，著嚴飭沿海口岸地方文武員，實力巡防。如有竄逸餘匪，即行擒獲審辦，最爲緊要。",
                    "title": "諭閩浙總督常青等嚴行殲戮林爽文等並防餘衆四散內渡",
                    "date": "1786/12/27"
                  },
                  {
                    "doc_id": "硃22",
                    "source_type": "奏摺",
                    "quote": "臣除一面將沿海口隘，密飭各營將弁嚴加防守",
                    "title": "為奏林爽文攻陷彰化已備兵聽候調遣事",
                    "date": "1786/12/27"
                  },
                  {
                    "doc_id": "硃22",
                    "source_type": "硃批",
                    "quote": "已有旨了。欽此。",
                    "title": "為奏林爽文攻陷彰化已備兵聽候調遣事",
                    "date": "1786/12/27",
                    "position": "尾批"
