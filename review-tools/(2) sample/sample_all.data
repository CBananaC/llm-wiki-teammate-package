          "events": [
            {
              "quote": "邦光遂密約牛罵頭等莊義民，於二十日辰刻，由沙轆進攻水里、大肚、茄投等賊巢，並率義民襲後，追逐至貓霧捒",
              "reporter": "署鹿仔港守備陳邦光",
              "subtitle": "陳邦光率義民進攻水里大肚",
              "whenCh": "十二月二十日",
              "where": "沙轆、水里、大肚、茄投、貓霧捒"
            },
            {
              "quote": "二十三日林爽文黨羽陳泮、吳領等燒毀泉、粵民莊，隨率義民前往追捕，殺死賊夥三十餘名，十獲紅旗四枝，器械四十餘件，並力追趕，賊人退歸南、北投而去。",
              "reporter": "署鹿仔港守備陳邦光",
              "subtitle": "陳邦光率義民追捕陳泮吳領",
              "whenCh": "十二月二十三日",
              "where": "鹿港、南北投"
            }
          ]
