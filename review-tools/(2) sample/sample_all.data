                "hops": [
                  {
                    "doc_id": "硃59",
                    "from_person": "撫臣徐嗣曾",
                    "how": "咨會",
                    "inferred": false,
                    "layer": 1,
                    "place": "",
                    "quote": "茲於十二月二十一日接准撫臣徐嗣曾自省來咨，據稱：調集各處官兵及南澳鎮兵赴泉聽用，並咨廣東、浙江各督、撫、提臣，酌撥備戰兵，各於交界本境駐紮，以資策應。又因接據淡水新莊巡檢王增錞稟報：現於艋舺地方募雇鄉勇、匠頭人等，分守堵禦。經該撫臣將備調之省兵一千五百名，飭令閩安協副將徐鼎士、遊擊吳秀等統領赴援。等情。一面具奏，一面知會到臣。",
                    "to_person": "常青",
                    "whenAr": "",
                    "whenCh": ""
                  },
