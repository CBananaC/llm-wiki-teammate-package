            "relations": [],
            "sources": [
              {
                "doc_id": "硃82",
                "quote": "據解逆犯四名，臣現委員飛赴迎提，即於泉州審明後，另摺具奏",
                "howKnown": "",
                "whenKnown": ""
              }
            ],
            "__qcat": "nonmil",
            "__traceChains": [
              {
                "events": [
                  {
                    "quote": "據解逆犯四名，臣現委員飛赴迎提，即於泉州審明後，另摺具奏",
                    "reporter": "署鹿仔港守備陳邦光",
                    "subtitle": "常青派員迎提偽官審訊",
                    "whenCh": "十二月十四日",
                    "where": "泉州"
