    {
      "id": "evmrx9rjk0bjo",
      "actor": "lin",
      "subtitle": "董得魁中港之役擊退官兵",
      "description": "淡水同知程峻與竹塹營守備董得魁率領兵役鄉勇在中港地方堵禦賊匪，因賊匪人數眾多，官兵抵敵不住而潰散。",
      "what": "董得魁中港之役擊退官兵",
      "where": "中港",
      "who": [
        "賊匪",
        "程峻",
        "董得魁"
      ],
      "whoLoc": {},
      "relations": [],
      "provenance": [
        {
          "id": "pvcmrx9rpeuzd0",
          "hops": [
            {
              "doc_id": "硃35",
              "from_person": "泉州府知府王右弼、晉江縣知縣徐夢麟",
              "how": "稟報",
              "inferred": false,
              "layer": 1,
              "place": "泉州",
              "quote": "十二月十三日夜，自涂嶺拜摺後，旋於惠安途次接據泉州府知府王右弼、晉江縣知縣徐夢麟稟稱...理合稟報。等由到臣。",
              "to_person": "閩浙總督常青",
              "whenAr": "",
              "whenCh": "",
              "id": "pvmrx9rpevtia"
            },
            {
              "doc_id": "硃35",
              "from_person": "程必大",
              "how": "口述",
              "inferred": false,
              "layer": 2,
              "place": "泉州",
              "quote": "十二日有署淡水同知程峻之子程必大，懷取淡防同知關防，赴泉求救...當即隨同陸路提督傳詢。據程必大供稱：父親程峻現署淡水同知，駐紮竹塹。因彰化賊匪滋事，我父親會同董守備，帶領兵役鄉勇，赴中港地方堵禦。賊匪眾多，抵敵不住，我父親存亡不知。賊匪于十初七日已到竹塹，四行搶擄，我恐印信被他搶去，又因彰化地方已被賊踞，不能前往府城，只得帶印改裝，跑到八里坌內渡求救的。",
              "to_person": "泉州府知府王右弼、晉江縣知縣徐夢麟、陸路提督",
              "whenAr": "1786/12/12",
              "whenCh": "十二月十二日",
              "id": "pvmrx9rpevrkl"
            }
          ],
          "events": [
            {
              "quote": "父親程峻現署淡水同知，駐紮竹塹。因彰化賊匪滋事，我父親會同董守備，帶領兵役鄉勇，赴中港地方堵禦。賊匪眾多，抵敵不住，我父親存亡不知。賊匪于十初七日已到竹塹，四行搶擄",
              "reporter": "程必大",
              "subtitle": "董得魁中港擊散官兵並踞竹塹",
              "whenCh": "十二月初七日",
