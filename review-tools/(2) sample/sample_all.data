          "who": "徐嗣曾"
        },
        {
          "loc": "蚶江",
          "role": "受託者",
          "who": "常青"
        }
      ],
      "provenance": [],
      "whenCh": "乾隆五十一年十二月二十七日",
      "dateAr": "1786/12/27",
      "sources": [
        {
          "doc_id": "諭13",
          "quote": "常青、徐嗣曾等，總須不動聲色，妥協辦理。若因外洋遇有此等案件，該督撫等紛紛調遣，跡涉張皇，轉致內地民人心生疑駭，殊有關係，該督撫不可不處以鎮定也。",
          "label": "申飭官員應處以鎮定、切勿張皇",
          "howKnown": "上諭"
        }
      ],
      "hidden": false,
