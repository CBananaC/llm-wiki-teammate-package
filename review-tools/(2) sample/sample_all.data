        "prompt": "（本機技能輸出：outputs/official-response.json）",
        "items": [
          {
            "action_quote": "常青、徐嗣曾等，總須不動聲色，妥協辦理。若因外洋遇有此等案件，該督撫等紛紛調遣，跡涉張皇，轉致內地民人心生疑駭，殊有關係，該督撫不可不處以鎮定也。",
            "doc_id": "硃94",
            "how": "福建巡撫徐嗣曾於正月初十日接獲上諭後，隨即具奏。他表示已密札漳州道朱芫會、知府黃彬，要求其不動聲色、妥為防範，並會同督臣出示曉諭安撫漳籍百姓。他強調自己辦理一切事務皆出以鎮定，絕不敢稍涉張皇，以防內地民人驚疑。",
            "receive_date": "1787/01/10",
            "relations": [
              {
                "evidence": "臣密札該道朱芫會、知府黃彬，不動聲色，妥為防範",
                "relation": "密札",
                "relation_type": "command",
                "source": "徐嗣曾",
                "target": "朱芫會"
              },
              {
                "evidence": "臣密札該道朱芫會、知府黃彬，不動聲色，妥為防範",
                "relation": "密札",
                "relation_type": "command",
                "source": "徐嗣曾",
                "target": "黃彬"
              },
              {
                "evidence": "復會同督臣出示曉諭",
                "relation": "會同",
                "relation_type": "ally",
                "source": "徐嗣曾",
                "target": "常青"
              }
            ],
            "response_date": "1787/01/10",
            "response_quote": "臣密札該道朱芫會、知府黃彬，不動聲色，妥為防範。復會同督臣出示曉諭，以賊匪雖係漳人，其在臺滋事，與原籍親屬毫無干涉。惟藏匿引逆，例應同罪，將來賊匪潛逃回籍，即捕獲首報，並懸賞格，剴切示諭。仍令該道府將該處地方情形，按日稟報。臣復密加防察，現在實俱寧謐，並無驚疑之處。...臣仰承訓示，辦理一切，惟有事事出以鎮定，不敢稍存疏忽，亦斷不敢稍涉張皇，轉滋疑駭。",
            "subtitle": "徐嗣曾密飭屬員不動聲色妥協防範以安民心",
            "where": "漳州",
            "who": [
              "徐嗣曾",
              "朱芫會",
              "黃彬",
              "常青",
              "黃仕簡",
              "任承恩",
              "柴大紀",
              "蔡攀龍"
            ],
            "who_loc": {
              "任承恩": "蚶江",
              "常青": "蚶江",
              "徐嗣曾": "省城",
              "朱芫會": "漳州",
              "柴大紀": "臺灣郡城",
              "蔡攀龍": "臺灣郡城",
              "黃仕簡": "料羅",
              "黃彬": "漳州"
            }
          },
          {
            "action_quote": "著傳諭常青徐嗣曾等，總須不動聲色，妥協辦理",
            "doc_id": "硃105",
            "how": "閩浙總督常青於正月十一日接獲上諭後，於次日具奏。他表示自己並未調派漳州之兵以示不動聲色，並已嚴飭沿海口岸文武員弁實力巡查，力求鎮靜辦理，絕不敢過涉張皇，以仰副聖主諄切訓誡之意。",
            "receive_date": "1787/01/11",
            "relations": [
              {
                "evidence": "商之陸路提臣任承恩，多帶官兵，相度機宜，統率前進",
                "relation": "商之",
                "relation_type": "ally",
                "source": "常青",
                "target": "任承恩"
              },
              {
                "evidence": "臣並令調來之汀州鎮總兵普吉保，添帶水師兵六百名，由廈出口",
                "relation": "令調",
                "relation_type": "command",
                "source": "常青",
                "target": "普吉保"
              },
              {
                "evidence": "並准兩廣督臣孫士毅...協同進剿",
                "relation": "協同",
                "relation_type": "ally",
                "source": "孫士毅",
                "target": "常青"
              }
            ],
            "response_date": "1787/01/12",
            "response_quote": "即如漳州之兵，並未調派，示其不動聲色。今又得兩廣督臣駐兵界首，人心尤可懾服。其餘沿海口岸，嚴飭文武員弁，實力巡查...臣唯有鎮靜辦理，不敢過涉張皇，以仰副聖主諄切訓誡之至意。",
            "subtitle": "常青遵旨鎮靜辦理並嚴飭沿海口岸實力巡查",
            "where": "泉州",
