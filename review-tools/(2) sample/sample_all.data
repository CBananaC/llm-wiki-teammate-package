    "overallAdj": "乾隆五十一年十二月，因應臺灣林爽文事件，浙江巡撫覺羅琅玕接獲福建巡撫徐嗣曾照會，隨即飛咨提督陳大用等人，自溫州、黃巖等水師營抽調兵力三千名進駐閩浙交界，以資策應並防範匪徒潛竄內地。然而，乾隆帝對此防剿部署頗有微詞，於摺內硃批批評其舉措「過於張皇」，認為僅需盤查緝拿逸犯，毋庸大張旗鼓致使沿海人心惶惶，並對此奏批示「已有旨了」。",
    "divisions": [
      {
        "label": "前期防務與驛遞",
        "summary": "說明先前接獲閩浙總督常青通知後，已飭令沿海嚴防並增設驛站以加速郵報。",
        "start": 0,
        "end": 117,
        "n": 1
      },
      {
        "label": "接獲閩省協防請求",
        "summary": "收到福建巡撫徐嗣曾來文，請求在閩浙交界處酌撥二、三千名水師駐紮以備調遣。",
        "start": 117,
        "end": 202,
        "n": 2
      },
      {
        "label": "評估調兵策略",
        "summary": "分析浙閩交界地理與兵力，認為省城陸路兵不便輕動，應就近調派沿海水師以求便捷。",
        "start": 202,
        "end": 317,
        "n": 3
      },
      {
        "label": "調兵駐紮部署",
        "summary": "決定調派提標、溫州、黃巖三鎮水師共三千人，整備器械糧餉駐紮於交界處，並派員隨同彈壓。",
        "start": 317,
        "end": 573,
        "n": 4
      },
      {
        "label": "防範匪徒潛竄",
        "summary": "預期起事匪徒將被殲滅，為防其四散潛入內地，已派員在各海口嚴密盤查截拿。",
        "start": 573,
        "end": 687,
        "n": 5
      },
      {
        "label": "結語呈請聖鑒",
        "summary": "將上述辦理情形具摺馳奏，呈請皇帝聖鑒。",
        "start": 687,
        "end": 769,
        "n": 6
      }
    ]
  },
