                "sources": [
                  {
                    "doc_id": "硃78",
                    "source_type": "硃批",
                    "quote": "奮勇得勝，可嘉。餘有旨諭。欽此。",
                    "title": "為奏聞鹽埕橋接仗情形事",
                    "date": "1787/01/14",
                    "position": "尾批"
                  },
                  {
                    "doc_id": "諭47",
                    "source_type": "上諭",
                    "quote": "此次柴大紀與賊打仗，奮勇得勝，尚屬可嘉。",
                    "title": "諭閩浙總督常青等痛剿抗拒者並著水陸提督速奏抵臺各情",
                    "date": "1787/01/14"
                  },
                  {
                    "doc_id": "硃78",
                    "source_type": "奏摺",
                    "quote": "奴才柴大紀謹奏，為鹽埕打仗連日得勝，恭摺奏聞事。",
                    "title": "為奏聞鹽埕橋接仗情形事",
                    "date": "1787/01/14"
                  }
                ],
                "__repeatId": "硃78#emperor#candidate"
              },
              {
                "title": "指示柴大紀應繼續留守水陸扼要之鹽埕橋督剿叛匪以防賊人踵後",
                "aspect": "command",
                "action_type": "command",
                "how": "乾隆帝認同鹽埕橋為水陸形勢扼要之地，指示柴大紀應繼續在該處督兵剿捕，不可遽然撤回郡城以防叛匪尾隨攻擊。",
                "description": "乾隆帝認同鹽埕橋為水陸形勢扼要之地，指示柴大紀應繼續在該處督兵剿捕，不可遽然撤回郡城以防叛匪尾隨攻擊。",
                "whenCh": "乾隆五十二年正月十四日",
                "whenAr": "",
                "where": "",
                "who": [
                  "柴大紀"
                ],
                "whoLoc": {},
                "relations": [],
                "origin_doc_id": "",
                "origin_type": "",
                "origin_quote": "",
                "origin_date": "",
                "same_as_event_id": "evmr3itkjojsv",
                "sources": [
                  {
                    "doc_id": "諭47",
                    "source_type": "上諭",
                    "quote": "北路賊勢蔓延，鹽埕橋系水陸扼要之區，該鎮自應仍在彼督剿捕，未便遽回郡城，以致賊人踵後。",
                    "title": "諭閩浙總督常青等痛剿抗拒者並著水陸提督速奏抵臺各情",
                    "date": "1787/01/14"
                  },
                  {
                    "doc_id": "硃78",
                    "source_type": "奏摺",
                    "quote": "奴才相度形勢，鐵線橋離海尚遠，惟有鹽埕橋地方可以截拿水、陸兩路。",
                    "title": "為奏聞鹽埕橋接仗情形事",
                    "date": "1787/01/14"
                  }
                ],
                "__repeatId": "諭47#emperor#candidate"
              },
              {
                "title": "命令對抗拒官兵之叛匪嚴加痛剿並將擒獲犯人渡海押送內地審明正法",
                "aspect": "command",
                "action_type": "command",
                "how": "乾隆帝針對叛匪抗拒官兵之罪行，下令凡抗拒者即屬亂民一律嚴加痛剿，被擒獲者應陸續渡海押交常青於廈門、泉州等地審明正法。",
                "description": "乾隆帝針對叛匪抗拒官兵之罪行，下令凡抗拒者即屬亂民一律嚴加痛剿，被擒獲者應陸續渡海押交常青於廈門、泉州等地審明正法。",
                "whenCh": "乾隆五十二年正月十四日",
                "whenAr": "",
                "where": "",
                "who": [
                  "常青",
                  "柴大紀"
                ],
                "whoLoc": {},
                "relations": [],
                "origin_doc_id": "",
                "origin_type": "",
                "origin_quote": "",
                "origin_date": "",
                "same_as_event_id": "evmr3itkjojsv",
                "sources": [
                  {
                    "doc_id": "諭47",
                    "source_type": "上諭",
                    "quote": "此次惟有痛加誅剿，以示懲創。凡與官兵抗拒者，即系亂民，斷不可使一名幸逃顯戮。除臨陣時盡力斃不計外，其有被官兵擒拿及續行捕獲者，及見事敗然後投降，但既曾與官兵對仗者，俱當予駢誅。但此時不可稍露端倪，使賊匪自知必死，負隅固守，轉於攻捕無益。且臺地辦理多人，亦恐不便。將來拿之犯，竟宜陸續渡海，交常青在於廈門、蚶江、泉州一帶訊明，即行正法，不可稍存姑息。",
                    "title": "諭閩浙總督常青等痛剿抗拒者並著水陸提督速奏抵臺各情",
                    "date": "1787/01/14"
                  },
                  {
                    "doc_id": "硃78",
                    "source_type": "奏摺",
                    "quote": "攻戰之際，不能飭解，即行正法。",
                    "title": "為奏聞鹽埕橋接仗情形事",
                    "date": "1787/01/14"
                  }
                ],
                "__repeatId": "諭47#emperor#candidate"
              },
              {
                "title": "指示地方官對不肯從賊及協助官軍之民人無分漳泉一體獎勵以孤立賊勢",
                "aspect": "command",
                "action_type": "command",
                "how": "乾隆帝針對柴大紀提及漳州民人附逆之情形，指示不可預存歧視，凡不肯從賊或協助官兵出力者，無論漳州或泉州籍貫俱屬良民，應一體給予獎勵，以孤立叛匪勢力。",
                "description": "乾隆帝針對柴大紀提及漳州民人附逆之情形，指示不可預存歧視，凡不肯從賊或協助官兵出力者，無論漳州或泉州籍貫俱屬良民，應一體給予獎勵，以孤立叛匪勢力。",
                "whenCh": "乾隆五十二年正月十四日",
                "whenAr": "",
                "where": "",
                "who": [
                  "柴大紀",
                  "常青"
                ],
                "whoLoc": {},
                "relations": [],
                "origin_doc_id": "",
                "origin_type": "",
                "origin_quote": "",
                "origin_date": "",
                "same_as_event_id": "evmr3itkjojsv",
                "sources": [
                  {
                    "doc_id": "諭47",
                    "source_type": "上諭",
                    "quote": "總之，助賊者即系亂民，法無可貸。其不肯從賊及幫同官軍出力者，無分漳泉，俱系良民，自應一體獎勵，使賊勢日孤，易於竣事。",
                    "title": "諭閩浙總督常青等痛剿抗拒者並著水陸提督速奏抵臺各情",
                    "date": "1787/01/14"
                  },
                  {
                    "doc_id": "硃78",
                    "source_type": "奏摺",
                    "quote": "查賊匪林爽文等係漳州人，諸、彰漳民，所到附從。",
                    "title": "為奏聞鹽埕橋接仗情形事",
                    "date": "1787/01/14"
                  }
                ],
                "__repeatId": "諭47#emperor#candidate"
              }
            ]
          }
        ],
