  "硃99": {
    "overallAdj": "乾隆五十二年正月，兩廣總督孫士毅因臺灣林爽文起事，親赴潮州督辦徵兵，先行派遣水師一千名經陸路前往廈門聽候調遣，另預備水陸兵二千名於閩粵交界處候命。孫士毅於正月初九日親赴交界處點送兵丁出境並加發糧餉，隨後會同署提督彭承堯奏報起程日期與籌辦情形。乾隆帝對此下硃批批評，認為孫士毅親赴邊界的舉動「實屬無謂」，並指責其因張皇過當而徒增糧餉開支。",
    "divisions": [
      {
        "label": "前情與兵力籌劃",
        "summary": "孫士毅彙報此前籌劃三千徵兵、自省城出發，以及因應閩省會商先將水師一千名經陸路撥赴廈門之緣由與經過。",
        "start": 0,
        "end": 332,
        "n": 1
      },
      {
        "label": "抵潮與水師起程進度",
        "summary": "報告抵達潮州後與署提臣彭承堯商辦，碣石、南澳等營一千名水師分批起程經詔安前往廈門之行程。",
        "start": 332,
        "end": 464,
        "n": 2
      },
      {
        "label": "親赴交界點送與御批批評",
        "summary": "說明派員稽查及孫士毅預定親赴閩粵交界處點送官兵出境，乾隆帝硃批批評其親赴交界實屬無謂。",
        "start": 464,
        "end": 577,
        "n": 3
      },
      {
        "label": "糧餉籌辦與御批批評",
        "summary": "交代兵丁出境口糧、自帶一月糧餉與出兵分例給發等安排，乾隆帝硃批質疑其張皇多費。",
        "start": 577,
        "end": 776,
        "n": 4
      },
      {
        "label": "結語與最終御批",
        "summary": "具摺會奏請旨，並附上奏摺日期與乾隆帝「已有旨了」之最終硃批。",
        "start": 776,
        "end": 875,
        "n": 5
      }
    ],
