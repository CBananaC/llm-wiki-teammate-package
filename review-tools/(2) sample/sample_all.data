                    "title": "諭閩浙總督常青等鎮定妥辦不必紛紛赴臺",
                    "date": "1786/12/29"
                  }
                ],
                "__pendingResponses": [
                  {
                    "action_quote": "乃任承恩竟欲親往，豈有水陸兩提督俱遠渡重洋，內地於不顧，辦一匪類之理？",
                    "doc_id": "硃110",
                    "how": "常青接獲諭旨後，承認自己未能妥善權衡事理輕重，對任承恩親往臺灣一事深感愧悚。他表示已遵旨留駐蚶江、廈門一帶進行調度，並已飭令任承恩在與黃仕簡合力殲匪後立即返回內地，以確保內地防務安全。",
                    "receive_date": "1787/01/12",
                    "relations": [
                      {
                        "evidence": "今任承恩既已渡臺，即遵旨俟其同黃仕簡殲匪蕆事，即行速回",
                        "relation": "飭令速回",
                        "relation_type": "command",
                        "source": "常青",
                        "target": "任承恩"
                      },
                      {
                        "evidence": "仍駐蚶江、廈門一帶，調度策應",
                        "relation": "調度",
                        "relation_type": "command",
                        "source": "常青",
                        "target": "黃仕簡"
                      }
                    ],
                    "response_date": "1787/01/13",
                    "response_quote": "但既有提臣黃仕簡帶兵，而任承恩又復親往，殊失事理之輕重。況從前臺匪朱一貴滋擾一案，辦理迅速，成效可稽。臣罔識遵循，未得肯綮，一經聖明指示周詳，不勝愧悚之至。今任承恩既已渡臺，即遵旨俟其同黃仕簡殲匪蕆事，即行速回，總以內地為緊要。",
                    "subtitle": "常青遵旨留駐內地並飭任承恩蕆事速回",
                    "where": "蚶江、廈門",
                    "who": [
                      "常青",
                      "任承恩",
                      "黃仕簡"
                    ],
                    "who_loc": {
                      "任承恩": "臺灣",
                      "常青": "蚶江",
                      "黃仕簡": "臺灣"
                    }
                  },
                  {
                    "action_quote": "乃任承恩竟欲親往，豈有水陸兩提督俱遠渡重洋，內地於不顧，辦一匪類之理？",
                    "doc_id": "硃153",
                    "how": "任承恩並未在文中直接提及該上諭，但其具奏內容詳細匯報了其親率二千官兵於正月初六日抵達鹿港的過程。他隨即展開部署，分兵搜剿虎仔坑等處賊莊，以此行動實踐並說明其「親往」協剿的必要性與進展。",
                    "receive_date": "",
                    "relations": [
                      {
                        "evidence": "奴才即當親統官兵南下，會同水師提臣黃仕簡商酌機宜",
                        "relation": "會同商酌",
                        "relation_type": "ally",
                        "source": "任承恩",
                        "target": "黃仕簡"
                      }
                    ],
                    "response_date": "1787/01/14",
                    "response_quote": "奴才於聞報之日，即將派撥官兵，親督協剿緣由，奏聞在案。奴才隨即統領官兵二千名，配船二十五號，於十二月十七日開行。因風雨阻滯，直至正月初四夜放洋。仰托聖主洪福，於初六日官兵船隻同時全抵鹿港。奴才立即登岸，以安民心。",
                    "subtitle": "任承恩匯報親率官兵抵臺及首期剿匪戰果",
                    "where": "鹿港",
                    "who": [
                      "任承恩",
                      "黃仕簡"
                    ],
                    "who_loc": {
                      "任承恩": "鹿港",
                      "黃仕簡": "府城"
                    }
                  },
                  {
                    "action_quote": "乃任承恩竟欲親往，豈有水陸兩提督俱遠渡重洋，內地於不顧，辦一匪類之理？",
                    "doc_id": "奏80",
                    "how": "任承恩在摺中詳細陳述其親自率兵渡海、於正月初六日抵達鹿港的經過，並匯報其隨即分兵三路焚毀多處賊莊、擒斬偽官賊夥的戰績。此摺雖未直接提及上諭，但實質上是在為其「親往」臺灣的軍事行動進行成果匯報。",
                    "receive_date": "",
                    "relations": [
                      {
                        "evidence": "奴才即當親統官兵南下，會同水師提臣黃仕簡商酌機宜",
                        "relation": "會同商酌",
                        "relation_type": "ally",
                        "source": "任承恩",
                        "target": "黃仕簡"
                      }
                    ],
                    "response_date": "1787/01/14",
                    "response_quote": "奴才於聞報之日即將派撥官兵、親督協勦緣由奏聞在案。奴才隨即統領官兵二千名，配船二十五號於十二月十七日開行，因風雨阻滯，直至正月初四夜放洋，仰託聖主洪福，於初六日官兵船隻同時全抵鹿港，奴才立即登岸，以安民心。",
                    "subtitle": "任承恩詳報親統兵馬登陸鹿港及分兵搜剿",
                    "where": "鹿港",
                    "who": [
                      "任承恩",
                      "黃仕簡"
                    ],
                    "who_loc": {
                      "任承恩": "鹿港",
                      "黃仕簡": "府城"
                    }
                  },
                  {
                    "action_quote": "乃任承恩竟欲親往，豈有水陸兩提督俱遠渡重洋，內地於不顧，辦一匪類之理？",
                    "doc_id": "硃158",
                    "how": "常青轉報了已渡臺的陸路提督任承恩之最新戰況，說明任承恩已在鹿港分兵剿匪、焚毀賊巢。常青藉此向皇帝表明，雖然任承恩已然渡臺，但其在臺已展開積極攻勢，且自己仍在內地密切追蹤其動向並進行調度。",
                    "receive_date": "",
                    "relations": [
                      {
                        "evidence": "茲於二月初一日申刻，該提臣任承恩傳齊奏摺過泉，並准咨稱",
                        "relation": "咨報戰情",
                        "relation_type": "report",
                        "source": "任承恩",
                        "target": "常青"
                      }
                    ],
                    "response_date": "1787/02/02",
                    "response_quote": "因任承恩由鹿港抵臺之後，未得進兵確信，復又咨催差探問。茲於二月初一日申刻，該提臣任承恩傳齊奏摺過泉，並准咨稱...現聞水師提督到臺，並可會商機宜，迅擒逆賊首夥，不使少留餘孽。等因到臣。伏查該提臣自抵鹿港，即已分兵剿補，焚毀賊巢，使匪徒無頓身之地。",
                    "subtitle": "常青轉報任承恩在臺進兵及焚毀賊莊戰情",
                    "where": "泉州",
                    "who": [
                      "常青",
                      "任承恩"
                    ],
                    "who_loc": {
                      "任承恩": "鹿港",
                      "常青": "泉州"
                    }
                  },
                  {
                    "action_quote": "乃任承恩竟欲親往，豈有水陸兩提督俱遠渡重洋，內地於不顧，辦一匪類之理？",
                    "doc_id": "硃119",
                    "how": "常青向皇帝具奏水陸兩提督黃仕簡、任承恩已分別於正月初四和初六日安全抵達臺灣。他強調自己正嚴飭內地沿海各口岸加緊巡查，以防賊匪偷渡回籍，以此向皇帝保證內地防務並未因提督渡臺而廢弛。",
                    "receive_date": "",
                    "relations": [
                      {
                        "evidence": "據報官兵抵臺日期...探明提臣黃仕簡...俱於初三日自澎湖開駕",
