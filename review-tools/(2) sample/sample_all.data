                "same_as_event_id": "evmrdbjklp0sj",
                "sources": [
                  {
                    "doc_id": "硃82",
                    "source_type": "硃批",
                    "quote": "速行審其起事之故，六百里加緊奏來",
                    "title": "為奏聞守備陳邦光攻打彰化擒獲楊振國等緣由事",
                    "date": "1787/01/15",
                    "position": "夾批",
                    "context_quote": "據解逆犯四名，臣現委員飛赴迎提，即於泉州審明後，另摺具奏"
                  },
                  {
                    "doc_id": "諭51",
                    "source_type": "上諭",
                    "quote": "即如現在拿獲之楊振國等四犯，俱曾受僞職，並與官兵抗拒者，亦應一例緣坐。該犯等系漳州民人，其家屬想仍在內地者必多。若此時遽行查辦，恐內地漳民聞而生駭，轉多未便。著傳諭常青，楊振國等四犯解到時，即訊明起事根由，由六百里加緊據實復奏，並訊明各要犯家屬下落，密爲存記。黃仕簡等在臺搜捕賊匪事竣，大兵撤回廈門、蚶江等處時，督提聚在一處，將賊犯家屬按名查拿辦理，自無虞其兔脫漏網。",
                    "title": "諭閩浙總督常青審辦楊振國等其首要家屬容後拿辦",
                    "date": "1787/01/15"
                  },
                  {
                    "doc_id": "諭52",
                    "source_type": "上諭",
                    "quote": "已有旨令常青等，俟楊振國等解到時，究明起事根由，迅速具。各要犯家屬，俟撤兵後，再行辦理緣坐矣。",
                    "title": "諭湖廣總督李侍堯將楊振國等家屬於撤兵後再行緣坐",
                    "date": "1787/01/15"
                  }
                ],
                "__pendingResponses": [
                  {
                    "action_quote": "著傳諭常青，楊振國等四犯解到時，即訊明起事根由，由六百里加緊據實復奏，並訊明各要犯家屬下落，密爲存記。",
                    "doc_id": "硃146",
                    "how": "閩浙總督常青覆奏，楊振國等四犯解到泉州時已訊明起事根由，並於正月初六日將供詞由六百里馳奏解交刑部。至要犯家屬因多在彰化及原籍，已抄摺密會提臣嚴搜密記，恪遵旨意俟剿匪事竣大兵撤回後，再行會同按名查拿辦理。",
                    "receive_date": "乾隆五十二年正月二十八日",
