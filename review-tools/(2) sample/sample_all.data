                "sources": [
                  {
                    "doc_id": "硃71",
                    "source_type": "硃批",
                    "quote": "何必言及此，閩省於此事已覺張望，爾鄰省更宜鎮靜，無因一、二賊匪騷動各省之理",
                    "title": "為接咨挑選戰兵預備赴臺策應並擬親赴潮州事",
                    "date": "1787/01/13",
                    "position": "夾批",
                    "context_quote": "臣聞之不勝髮指，恨不親身帶兵，即日前赴會同剿滅"
                  },
                  {
                    "doc_id": "硃71",
                    "source_type": "硃批",
                    "quote": "此則過矣",
                    "title": "為接咨挑選戰兵預備赴臺策應並擬親赴潮州事",
                    "date": "1787/01/13",
                    "position": "夾批",
                    "context_quote": "臣恐在省得閩信較遲，除知會署提臣彭承堯先赴潮州稽查彈壓，臣將督、撫兩署事務於數日內略為料理"
                  }
