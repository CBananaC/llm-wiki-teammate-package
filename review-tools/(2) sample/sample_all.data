            "subtitle": "常青就遭傳旨申飭坦承辦理失措愧悚自責並表遵旨鎮靜調度",
            "where": "廈門",
            "who": [
              "常青",
              "黃仕簡",
              "任承恩",
              "林爽文"
            ],
            "who_loc": {
              "任承恩": "臺灣",
              "常青": "廈門",
              "林爽文": "臺灣",
              "黃仕簡": "臺灣"
            }
          }
        ],
