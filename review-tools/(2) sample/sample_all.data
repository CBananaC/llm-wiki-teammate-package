                "whoLoc": {
                  "常青": "福建",
                  "林爽文": "臺灣",
                  "柴大紀": "臺灣府城"
                },
                "relations": [],
                "origin_doc_id": "",
                "origin_type": "",
                "origin_quote": "",
                "origin_date": "",
                "same_as_event_id": "",
                "sources": [
                  {
                    "doc_id": "硃128",
                    "source_type": "硃批",
                    "quote": "所辦皆合機宜，目今大兵已到，賊匪四散，惟擒獲首犯為要。勉為之。欽此。",
                    "title": "為奏聞調度水陸官兵守禦府城事",
                    "date": "1787/02/04",
                    "position": "尾批"
                  },
                  {
                    "doc_id": "諭89",
                    "source_type": "上諭",
                    "quote": "大紀所辦，尚合機宜。現在大兵已到，賊匪奔逃四散。水陸二提督剋期會剿，自必立時撲滅。常青等惟當督率鎮將，擒獲首要各犯，解京審辦。並乘此兵力，上緊搜捕，務盡根株，以靖海疆。",
                    "title": "諭閩浙總督李侍堯等擒獲首要解京審辦並速建郡城",
                    "date": "1787/02/04"
