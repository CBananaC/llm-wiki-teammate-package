                "sources": [
                  {
                    "doc_id": "硃64",
                    "source_type": "硃批",
                    "quote": "不出此，蓋訛傳語耳",
                    "title": "為招募義民實力防守及發兵渡臺情形事",
                    "date": "1787/01/10",
                    "position": "夾批",
                    "context_quote": "其所稱天地會名目，尤屬不經，是否與諸羅匪犯楊光勳等所設之添弟會暗樹黨援"
                  },
                  {
                    "doc_id": "硃64",
                    "source_type": "奏摺",
                    "quote": "是否與諸羅匪犯楊光勳等所設之添弟會暗樹黨援",
