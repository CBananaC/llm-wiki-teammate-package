  "硃79": {
    "overallAdj": "乾隆五十二年正月初八日，江南提督藍元枚接獲上諭，受命署理福建陸路提督以平定臺灣林爽文事件。藍元枚於當日完成松江印信交接後即刻起程趕赴泉州蚶江，預計會同總督常青統籌後勤與軍務調度。乾隆帝於正月十四日批復「一切勉為之」，勉勵藍元枚實力盡心、全力以赴。",
    "divisions": [
      {
        "label": "奉諭謝恩",
        "summary": "藍元枚奏報於正月初八日接獲上諭命其前往泉州署理福建陸路提督，並恭設香案叩頭謝恩。",
        "start": 0,
        "end": 118,
        "n": 1
      },
      {
        "label": "研判賊情與起程交代",
        "summary": "研判林爽文部眾為烏合之眾，交接印信後定於本日巳刻自松江起程前往蚶江，會同總督常青調度。",
        "start": 118,
        "end": 249,
        "n": 2
      },
      {
        "label": "馳奏請旨",
        "summary": "說明將起程日期由六百里加急奏聞呈請御覽。",
        "start": 249,
        "end": 290,
        "n": 3
      },
      {
        "label": "硃批",
        "summary": "乾隆皇帝下達「一切勉為之」之硃批指示。",
        "start": 290,
        "end": 324,
        "n": 4
      }
    ],
