      {
        "at": "2026-07-25 06:04",
        "model": "local skill output",
        "kind": "officialresponse",
        "evTitle": "乾隆帝命令常青審明解到逆犯楊振國等起事根由並密記家屬下落俟撤兵後辦理緣坐",
        "addressee": "常青",
        "action_doc_ids": [
          "硃82",
          "諭51",
          "諭52"
        ],
        "source_doc_ids": [
