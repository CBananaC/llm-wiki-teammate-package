        "items": [
          {
            "edict_id": "諭43",
            "title": "諭兩廣總督孫士毅毋庸親往潮州",
            "date": "1787/01/13",
            "memDoc": "硃71",
            "memTitle": "為接咨挑選戰兵預備赴臺策應並擬親赴潮州事",
            "summary": "只保留皇帝自己的評論、答覆或命令；同義硃批與上諭合為一項。",
            "points": [
              {
                "title": "肯定孫士毅嚴密巡防沿海隘口並預挑水師一千名備調之防禦部署",
                "aspect": "approve",
                "action_type": "approve",
                "how": "乾隆帝讚許兩廣總督孫士毅於閩粵交界及沿海隘口嚴密巡防盤詰，並預先挑選水師戰兵一千名備足軍火口糧以資策應之部署，評為『此係當辦之事』與『好』。",
                "description": "乾隆帝讚許兩廣總督孫士毅於閩粵交界及沿海隘口嚴密巡防盤詰，並預先挑選水師戰兵一千名備足軍火口糧以資策應之部署，評為『此係當辦之事』與『好』。",
                "whenCh": "乾隆五十二年正月十三日",
                "whenAr": "1787/01/13",
                "where": "北京",
                "who": [
                  "乾隆帝",
                  "孫士毅"
                ],
                "whoLoc": {
                  "乾隆帝": "北京",
                  "孫士毅": "廣州"
                },
                "relations": [
                  {
                    "from": "孫士毅",
                    "to": "乾隆帝",
                    "type": "subordinate"
                  }
                ],
                "origin_doc_id": "",
                "origin_type": "",
                "origin_quote": "",
                "origin_date": "",
                "same_as_event_id": "evmr4lq7x33ib",
                "sources": [
                  {
                    "doc_id": "硃71",
                    "source_type": "硃批",
                    "quote": "此則當辦之事",
                    "title": "為接咨挑選戰兵預備赴臺策應並擬親赴潮州事",
                    "date": "1787/01/13",
                    "position": "夾批",
                    "context_quote": "臣已密派妥幹弁員，於各隘口商船漁艇往來處所，改裝易服，梭織游巡，不露圭角，遇有形跡可疑之人，立即盤詰究辦"
                  },
                  {
                    "doc_id": "硃71",
                    "source_type": "硃批",
                    "quote": "好",
                    "title": "為接咨挑選戰兵預備赴臺策應並擬親赴潮州事",
                    "date": "1787/01/13",
                    "position": "夾批",
                    "context_quote": "查南澳右營係歸粵省統轄，臣現於該營及附近閩省之碣石、澄海、海門等處鎮、協、營內，共挑選水師戰兵一千名，配定戰艦，備足軍火器械，裹帶一月口糧，並派撥得力之統領將備員弁，一一料理停妥，設有徵調，便於立即起程，以資策應"
                  },
                  {
                    "doc_id": "諭43",
                    "source_type": "上諭",
                    "quote": "孫士毅接準諮文，派兵前往預備策應，及嚴飭各隘口，嚴密盤潔，遇有形跡可疑之人，立即究辦。此係當辦之事。",
                    "title": "諭兩廣總督孫士毅毋庸親往潮州",
                    "date": "1787/01/13"
                  }
                ],
                "__pendingResponses": [
                  {
                    "action_quote": "據孫士毅奏，接准閩省咨文，挑備水師戰兵一千名，立即起程前赴南澳，以資策應，並知會署提臣彭承堯先赴潮州稽查彈壓。等語。閩粵境壤毗連，臺匪糾眾滋事，各隘口嚴密盤詰，此係當辦之事。",
                    "doc_id": "硃160",
                    "how": "孫士毅接奉乾隆五十二年正月十三日諭旨後，深感自己輕離省城親赴潮州彈壓之錯謬，隨即遵旨安排於正月二十六日起程回省。其先前預挑赴閩之水師一千名，現已聽候閩浙總督調遣並暫駐漳州彈壓。同時，他將惠潮一帶之稽查防範事宜交由署提督彭承堯暫駐潮州料理，並調按察使姚棻至潮州專司督緝天地會匪，徹底搜捕淨絕根株。",
                    "receive_date": "正月二十四日",
                    "relations": [
                      {
                        "evidence": "一切稽查防範事宜，臣遵旨交與署提臣彭承堯，暫駐潮州督率料理。",
                        "relation": "交與",
                        "relation_type": "command",
                        "source": "孫士毅",
                        "target": "彭承堯"
                      },
                      {
                        "evidence": "臬司姚棻現已行調來潮，專司督緝",
                        "relation": "調來",
                        "relation_type": "command",
                        "source": "孫士毅",
                        "target": "姚棻"
                      }
                    ],
                    "response_date": "乾隆五十二年正月二十六日",
                    "response_quote": "同日，接奉廷寄乾隆五十二年正月十三日奉上諭：「據孫士毅奏，接准閩省咨文，挑備水師戰兵一千名，立即起程前赴南澳，以資策應，並知會署提臣彭承堯先赴潮州稽查彈壓。等語。閩粵境壤毗連，臺匪糾眾滋事，各隘口嚴密盤詰，此係當辦之事。孫士毅止當鎮靜地方，密飭隘口堵拿逸犯，豈得輕離省城，以致內地民人心懷疑惑。著孫士毅如尚未起程，即毋庸前往。若已起程，亦即速回省城。」等因。欽此。臣跪讀之下，仰見我皇上睿謨廣運，坐照無遺，萬里情形，洞如觀火。臣才庸識淺，不知輕重緩急，惑於漳、潮壤接，民情疑恐，親赴彈壓。一經聖明詳晰指示，臣自知錯謬，不禁慚悚交集……其先赴閩省之水師一千名，昨准閩浙督臣知會，現在暫駐漳州，用資彈壓……一切稽查防範事宜，臣遵旨交與署提臣彭承堯，暫駐潮州督率料理。臣即於正月二十六日起程回省",
                    "subtitle": "孫士毅遵旨撤兵回省並部署彭承堯與姚棻在潮州稽查搜捕會匪",
                    "where": "潮州",
                    "who": [
                      "孫士毅",
                      "彭承堯",
                      "姚棻"
                    ],
                    "who_loc": {
