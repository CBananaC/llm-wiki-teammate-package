  "硃97": {
    "overallAdj": "乾隆五十一年底，臺灣發生林爽文之亂並接連攻陷彰化與諸羅，閩粵兩省緊急動員會剿。南澳鎮總兵六廷柱隨即加強邊防，並奉兩廣總督孫士毅等指令，統領南澳、碣石等營官兵一千名預備調用。六廷柱於乾隆五十二年正月初六日率隊星夜兼程經詔安趕赴廈門，聽候閩浙總督調遣渡臺進剿，並將起程日期奏報朝廷，獲乾隆帝批復「知道了」。",
    "divisions": [
      {
        "label": "奏報事由",
        "summary": "說明奏報的主旨為領兵前往廈門預備會剿臺灣逆匪。",
        "start": 0,
        "end": 30,
        "n": 1
      },
      {
        "label": "接獲警訊",
        "summary": "敘述接獲福建水師提督與閩浙總督通知臺灣彰化城池被林爽文等攻陷之警報。",
        "start": 30,
        "end": 127,
        "n": 2
      },
      {
        "label": "防禦部署",
        "summary": "說明因應臺灣民情與漳州背景，採取嚴密堵截防範及挑選預備兵丁之處置。",
        "start": 127,
        "end": 342,
        "n": 3
      },
      {
        "label": "請纓參戰",
        "summary": "接獲諸羅城亦告失陷之消息後，隨即呈請閩浙總督委派親自帶兵前往征剿。",
        "start": 342,
