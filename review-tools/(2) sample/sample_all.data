        "model": "local skill output",
        "kind": "officialresponse",
        "evTitle": "研判臺灣郡城防守嚴密尚無大虞並指示黃仕簡等俟官兵齊集後併力夾攻",
        "addressee": "常青",
        "action_doc_ids": [
          "諭31",
          "硃56"
