                "sources": [
                  {
                    "doc_id": "諭36",
                    "source_type": "上諭",
                    "quote": "至該督等折內所稱鹿仔港等處，有客民 義民共相糾集，守護地方等語。該處商民等激發公義，保護地方，甚屬可嘉。著該督撫事竣後，會同查明，分別獎勵。",
                    "title": "諭閩浙總督常青等巡撫徐嗣曾越制徵調殊屬矜張著傳旨申飭",
                    "date": "1787/01/08"
                  },
                  {
                    "doc_id": "硃59",
                    "source_type": "奏摺",
                    "quote": "又因接據淡水新莊巡檢王增錞稟報：現於艋舺地方募雇鄉勇、匠頭人等，分守堵禦。",
                    "title": "為准咨奏明調撥各路兵丁情形事",
                    "date": "1787/01/08"
                  }
                ],
                "__pendingResponses": [
                  {
