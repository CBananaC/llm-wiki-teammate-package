  "硃58": {
    "overallAdj": "乾隆五十一年十二月，閩浙總督常青與福建巡撫徐嗣曾合署上奏，因新任臺灣諸羅縣知縣黃嘉訓因案降調，該要缺亟需員接補。常青等人考量諸羅民番雜處、政務繁雜，遴選出辦事勤練且熟悉海疆風土的現任長汀縣知縣王悳齡，懇請准予調補諸羅，並免送部引見。乾隆五十二年正月初七日，此奏獲硃批「該部議奏」辦理。",
    "divisions": [
      {
        "label": "奏辦緣由",
        "summary": "閩浙總督常青與福建巡撫徐嗣曾上奏，因原諸羅縣知縣黃嘉訓因案降調，急需遴選合適官員調補該缺。",
        "start": 0,
        "end": 104,
        "n": 1
      },
      {
        "label": "遴選人選",
        "summary": "考量諸羅縣政務繁雜，經與藩臬兩司篩選後，推薦年富力強且熟悉閩省風土的長汀縣知縣王悳齡調補。",
        "start": 104,
        "end": 318,
        "n": 2
      },
      {
        "label": "懇請聖裁",
        "summary": "懇請皇上准予將王悳齡調補諸羅知縣且免送部引見，其遺留的長汀縣缺則歸部選，並呈送其任內處分清單請吏部議復。",
        "start": 318,
        "end": 457,
        "n": 3
      },
      {
        "label": "奉旨硃批",
        "summary": "乾隆五十二年正月初七日奉到硃批，命該部（吏部）議奏。",
        "start": 457,
        "end": 503,
        "n": 4
      }
    ],
