            "relations": [],
            "sources": [
              {
                "doc_id": "硃89",
                "quote": "縣城原是栽種刺竹為牆，官兵竭力堵禦",
                "howKnown": "",
                "whenKnown": ""
              }
            ],
            "__qcat": "done",
            "__traceChains": [
              {
                "events": [
                  {
                    "quote": "縣城原是栽種刺竹為牆，官兵竭力堵禦",
                    "reporter": "原任彰化縣典史李爾和",
                    "subtitle": "官兵於彰化縣城竭力堵禦",
                    "whenCh": "十一月二十九日",
                    "where": "彰化縣城"
