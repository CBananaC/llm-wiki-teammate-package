            "subtitle": "常青奏遵旨仍駐紮蚶江及廈門一帶調度策應並鎮靜內地民情",
            "where": "蚶江",
            "who": [
              "常青",
              "黃仕簡",
              "任承恩"
            ],
            "who_loc": {
              "任承恩": "臺灣",
              "常青": "蚶江",
