    {
      "id": "evms07e2wc886",
      "actor": "emperor",
      "subtitle": "乾隆帝研判臺灣府城安全無虞並期盼水師提督黃仕簡抵臺消息",
      "description": "乾隆帝根據常青轉奏船戶傳聞臺灣府城有鄉勇保護、人心安定等情報，研判府城目前應無危殆，現在關鍵在於水師提督黃仕簡率大軍抵達臺灣之確切訊息。",
      "what": "乾隆帝研判臺灣府城安全無虞並期盼水師提督黃仕簡抵臺消息",
      "where": "北京",
      "who": [
        "乾隆帝",
        "常青",
        "黃仕簡"
      ],
      "whoLoc": {},
      "relations": [
        {
          "from": "常青",
          "to": "乾隆帝",
          "type": "奏報"
        },
        {
          "from": "乾隆帝",
          "to": "常青",
          "type": "批示"
        }
      ],
      "provenance": [],
      "whenCh": "乾隆五十二年正月十五日",
      "dateAr": "1787/01/15",
      "sources": [
        {
          "doc_id": "諭51",
          "quote": "看來臺灣府城可以無事。黃仕簡等所帶之兵一到，賊匪無難立時撲滅。",
          "label": "乾隆帝研判臺灣府城安全無虞並期盼水師提督黃仕簡抵臺消息",
          "aiFilterLabel": "相關上諭",
          "howKnown": "上諭"
        }
      ],
      "hidden": false,
      "aiFilterLabel": "相關上諭",
      "emperorDetail": {
        "kind": "edict",
        "combined": true,
        "action_type": "comment",
        "sources": [
          {
            "doc_id": "硃82",
            "source_type": "硃批",
            "quote": "看來府城無事，紙盼黃仕簡到臺灣之信耳。欽此。",
            "title": "為奏聞守備陳邦光攻打彰化擒獲楊振國等緣由事",
            "date": "1787/01/15",
            "position": "尾批"
          },
          {
            "doc_id": "諭51",
            "source_type": "上諭",
            "quote": "看來臺灣府城可以無事。黃仕簡等所帶之兵一到，賊匪無難立時撲滅。",
            "title": "諭閩浙總督常青審辦楊振國等其首要家屬容後拿辦",
            "date": "1787/01/15"
          }
        ],
        "memDoc": "硃82",
        "memTitle": "為奏聞守備陳邦光攻打彰化擒獲楊振國等緣由事",
        "how": "乾隆帝根據常青轉奏船戶傳聞臺灣府城有鄉勇保護、人心安定等情報，研判府城目前應無危殆，現在關鍵在於水師提督黃仕簡率大軍抵達臺灣之確切訊息。"
      }
    },
    {
      "id": "evms07eme8fw7",
      "actor": "emperor",
      "subtitle": "乾隆帝命令常青審明解到逆犯楊振國等起事根由並密記家屬下落俟撤兵後辦理緣坐",
      "description": "乾隆帝指示常青於解到偽官楊振國等四犯後，迅速加緊審明起事根由並六百里加緊奏聞；同時考慮到內地民心，命令先暗中查明各要犯家屬下落密記，待臺灣大兵撤回後再行按名拿辦緣坐。",
      "what": "乾隆帝命令常青審明解到逆犯楊振國等起事根由並密記家屬下落俟撤兵後辦理緣坐",
      "where": "北京",
      "who": [
        "乾隆帝",
        "常青",
        "楊振國"
      ],
      "whoLoc": {},
      "relations": [
        {
          "from": "常青",
          "to": "楊振國",
          "type": "解提審訊"
        },
        {
          "from": "乾隆帝",
          "to": "常青",
          "type": "審訊與緣坐命令"
        }
      ],
      "provenance": [],
      "whenCh": "乾隆五十二年正月十五日",
      "dateAr": "1787/01/15",
      "sources": [
        {
          "doc_id": "諭51",
          "quote": "即如現在拿獲之楊振國等四犯，俱曾受僞職，並與官兵抗拒者，亦應一例緣坐。該犯等系漳州民人，其家屬想仍在內地者必多。若此時遽行查辦，恐內地漳民聞而生駭，轉多未便。著傳諭常青，楊振國等四犯解到時，即訊明起事根由，由六百里加緊據實復奏，並訊明各要犯家屬下落，密爲存記。黃仕簡等在臺搜捕賊匪事竣，大兵撤回廈門、蚶江等處時，督提聚在一處，將賊犯家屬按名查拿辦理，自無虞其兔脫漏網。",
          "label": "乾隆帝命令常青審明解到逆犯楊振國等起事根由並密記家屬下落俟撤兵後辦理緣坐",
          "aiFilterLabel": "相關上諭",
          "howKnown": "上諭"
        }
      ],
      "hidden": false,
      "aiFilterLabel": "相關上諭",
      "emperorDetail": {
        "kind": "edict",
        "combined": true,
        "action_type": "command",
        "sources": [
          {
            "doc_id": "硃82",
            "source_type": "硃批",
            "quote": "速行審其起事之故，六百里加緊奏來",
            "title": "為奏聞守備陳邦光攻打彰化擒獲楊振國等緣由事",
            "date": "1787/01/15",
            "position": "夾批",
            "context_quote": "據解逆犯四名，臣現委員飛赴迎提，即於泉州審明後，另摺具奏"
          },
          {
            "doc_id": "諭51",
            "source_type": "上諭",
            "quote": "即如現在拿獲之楊振國等四犯，俱曾受僞職，並與官兵抗拒者，亦應一例緣坐。該犯等系漳州民人，其家屬想仍在內地者必多。若此時遽行查辦，恐內地漳民聞而生駭，轉多未便。著傳諭常青，楊振國等四犯解到時，即訊明起事根由，由六百里加緊據實復奏，並訊明各要犯家屬下落，密爲存記。黃仕簡等在臺搜捕賊匪事竣，大兵撤回廈門、蚶江等處時，督提聚在一處，將賊犯家屬按名查拿辦理，自無虞其兔脫漏網。",
            "title": "諭閩浙總督常青審辦楊振國等其首要家屬容後拿辦",
            "date": "1787/01/15"
          },
          {
            "doc_id": "諭52",
            "source_type": "上諭",
            "quote": "已有旨令常青等，俟楊振國等解到時，究明起事根由，迅速具。各要犯家屬，俟撤兵後，再行辦理緣坐矣。",
            "title": "諭湖廣總督李侍堯將楊振國等家屬於撤兵後再行緣坐",
            "date": "1787/01/15"
          }
        ],
        "memDoc": "硃82",
        "memTitle": "為奏聞守備陳邦光攻打彰化擒獲楊振國等緣由事",
        "how": "乾隆帝指示常青於解到偽官楊振國等四犯後，迅速加緊審明起事根由並六百里加緊奏聞；同時考慮到內地民心，命令先暗中查明各要犯家屬下落密記，待臺灣大兵撤回後再行按名拿辦緣坐。"
      }
    },
