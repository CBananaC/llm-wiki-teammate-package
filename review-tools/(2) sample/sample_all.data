            "relations": [
              {
                "evidence": "臣等隨與藩、梟兩司，於內地知縣內，詳加遴選...惟以長汀縣知縣王惠〔悳〕齡調補",
                "relation": "遴選調補",
                "relation_type": "command",
                "source": "常青",
                "target": "王悳齡"
              },
              {
                "evidence": "臣等隨與藩、梟兩司，於內地知縣內，詳加遴選...惟以長汀縣知縣王惠〔悳〕齡調補",
                "relation": "遴選調補",
                "relation_type": "command",
                "source": "徐嗣曾",
                "target": "王悳齡"
              }
            ],
            "sources": [
              {
                "doc_id": "硃58",
                "quote": "臣等隨與藩、梟兩司，於內地知縣內，詳加遴選。非處分違礙，即人地未宜。惟查有長汀縣知縣王惠〔悳〕齡，年四十六歲，順天府大興縣人，由壬午科副榜捐知縣即用。乾隆四十一年選授貴州天柱縣知縣，丁憂服滿，籤掣今職，乾隆四十七年五月十八日到任。該員年壯才明，辦事勤練，在閩年久，熟悉海疆風土情形",
                "howKnown": "",
                "whenKnown": ""
              }
            ],
            "__qcat": "nonmil",
            "__traceChains": [
              {
                "events": [
                  {
                    "quote": "臣等隨與藩、梟兩司，於內地知縣內，詳加遴選。非處分違礙，即人地未宜。惟查有長汀縣知縣王惠〔悳〕齡，年四十六歲，順天府大興縣人，由壬午科副榜捐知縣即用。乾隆四十一年選授貴州天柱縣知縣，丁憂服滿，籤掣今職，乾隆四十七年五月十八日到任。該員年壯才明，辦事勤練，在閩年久，熟悉海疆風土情形",
                    "reporter": "藩、梟兩司",
                    "subtitle": "常青等遴選王悳齡調補諸羅",
                    "whenCh": "乾隆五十一年十二月初十日",
                    "where": "福建"
                  }
                ],
