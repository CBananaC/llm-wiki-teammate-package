  "硃90": {
    "overallAdj": "乾隆五十一年底，臺灣林爽文起事，汀州鎮總兵普吉保奉總督常青調遣，先於閩粵交界的永定一帶調兵防守，後赴泉州密商軍務。旋因鳳山陷落、臺灣郡城告急，常青指派普吉保統領建寧、延平及水師提標等兵丁渡海增援。普吉保於五十二年正月初四日抵廈，鑑於軍情緊迫，遂率先行配船帶領水師六百名飛渡鹿耳門應援，其餘兵力則飛催隨後接續渡臺會剿。",
    "divisions": [
      {
        "label": "接咨調兵與抵達永定",
        "summary": "普吉保接獲巡撫與總督咨文，調派汀州與邵武官兵赴永定、上杭駐紮防守，並於十二月二十五日親抵永定彈壓。",
        "start": 0,
        "end": 213,
        "n": 1
      },
      {
        "label": "鳳山陷落與奉命渡臺",
        "summary": "普吉保奉總督之命赴泉州密商，途中獲悉鳳山縣亦被攻陷、府城告急，奉命統領建延及水師官兵由廈門渡臺救援。",
        "start": 213,
        "end": 360,
        "n": 2
      },
      {
        "label": "赴廈率兵先行渡臺",
        "summary": "普吉保抵泉後因建延兵未到，經與總督商議，決定於初四日先率水師六百名赴廈配船渡臺應援，其餘官兵催促接續渡臺。",
        "start": 360,
        "end": 477,
        "n": 3
      },
      {
        "label": "說明未奏緣由與結語",
        "summary": "說明此前調派汀邵官兵駐紮本轄境內未及具奏之緣由，並將率兵渡臺情由具摺呈奏。",
        "start": 477,
        "end": 580,
        "n": 4
      }
    ],
