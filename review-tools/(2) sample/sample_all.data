  "硃40": {
    "overallAdj": "乾隆五十一年十一月底，林爽文、王芬等人於彰化起事，接連攻陷大墩營盤與彰化縣城，導致赫姓副將、俞姓知縣等多名文武官員陣亡，賊勢並迅速威脅諸羅、鹿港與臺灣府城。臺灣鎮總兵柴大紀與臺灣道永福聞訊於十二月初二日帶兵北上，除分派兵力扼守鐵線橋等關鍵要衝以護府城，亦急調澎湖兵力並奏請水陸提督帶兵渡臺應援。柴大紀等人於十二月初四日將此緊急軍情具摺馳奏，後於乾隆五十二年正月初二日奉硃批「已有旨了」。",
    "divisions": [
      {
        "label": "奏題開端",
        "summary": "柴大紀與永福奏報林爽文等人起事，說明已率兵前往剿捕並派員協同查辦。",
        "start": 0,
        "end": 145,
        "n": 1
      },
      {
        "label": "彰化陷落與官員殉職",
        "summary": "根據逃回兵丁與地方官員回報，彰化縣城已於十一月二十八日夜被攻破，多名文武官員被害。",
        "start": 145,
        "end": 459,
        "n": 2
      },
      {
        "label": "軍事部署與防禦",
        "summary": "官府派兵飛馳諸羅剿捕，並於羅漢門、鐵線橋等重要要隘分兵駐守以資應援。",
        "start": 459,
        "end": 671,
        "n": 3
      },
      {
        "label": "賊勢分析與請調援兵",
        "summary": "分析叛匪勢力猖獗且兵力不足，已請水陸提督帶兵赴臺支援，並嚴加防守府城。",
        "start": 671,
        "end": 832,
        "n": 4
      },
      {
        "label": "具奏與日期",
        "summary": "將彰化陷落與官員殉職情形經由驛站六百里加急呈奏。",
        "start": 832,
        "end": 891,
        "n": 5
      },
      {
        "label": "皇上硃批",
        "summary": "乾隆皇帝下達「已有旨了」之硃批。",
        "start": 891,
        "end": 924,
        "n": 6
      }
    ],
