        "items": [
          {
            "actor": "qing",
            "category": "done",
            "subtitle": "柴大紀與邱能成等擊退賊眾",
            "description": "賊眾數萬三面圍攻，柴大紀督官兵施放槍炮，守備邱能成擊斃騎馬賊首，臺灣知縣王露率義民前來助戰，成功擊退賊軍。",
            "where": "鹽埕橋",
            "whenCh": "十二月十二日",
            "whenAr": "1786/12/12",
            "who": [
              "柴大紀",
              "邱能成",
              "王露"
            ],
            "whoLoc": {
              "柴大紀": "鹽埕橋",
              "王露": "鹽埕橋",
              "邱能成": "鹽埕橋"
            },
            "relations": [
              {
                "evidence": "臺灣知縣王露帶義民七、八百名，亦來助戰",
                "relation": "助戰",
                "relation_type": "ally",
                "source": "王露",
                "target": "柴大紀"
              }
            ],
            "sources": [
              {
                "doc_id": "硃78",
                "quote": "十二日早...奴才督率官兵，協力施放槍炮...城守守備邱能成打死穿紅袍騎馬賊一名。又臺灣知縣王露帶義民七、八百名，亦來助戰。我兵益振，竭力鏖戰，打死賊匪約二百多名...賊眾畏衛始退。",
                "howKnown": "",
                "whenKnown": ""
              }
            ],
            "__qcat": "done",
            "__traceChains": [
              {
                "events": [
                  {
                    "quote": "十二日早，正在點齊兵丁，欲往各莊搜賊，乃賊眾數萬，散漫滿野，三面擁至。奴才督率官兵，協力施放槍炮，打裂大炮三門，用麻繩捆好復放，母子炮隨損隨修。槍炮打死賊匪約有一百餘名，殺死者十數名。自卯至未，賊尚不退，城守守備邱能成打死穿紅袍騎馬賊一名。又臺灣知縣王露帶義民七、八百名，亦來助戰。我兵益振，竭力鏖戰，打死賊匪約二百多名，殺死十數名，賊眾畏懼始退。",
                    "reporter": "柴大紀",
                    "subtitle": "柴大紀與邱能成等擊退賊眾",
                    "whenCh": "十二月十二日",
                    "where": "鹽埕橋"
                  }
                ],
                "hops": [
                  {
                    "doc_id": "硃78",
                    "from_person": "柴大紀",
                    "how": "親見",
                    "inferred": false,
                    "layer": 1,
                    "place": "鹽埕橋",
                    "quote": "奴才即督率官兵飛馳鹽埕察看，海邊一帶，已有小船數百隻浮水而來，俱係賊匪，飭令弁兵施放槍炮，被子母炮打沉小船數十隻，餘船遠逃。正欲覓船往擒，又見遍野賊匪，竟有萬餘。黑衣黑布包頭，多執長刀，亦有槍炮，蜂擁而至。",
                    "to_person": "柴大紀",
                    "whenAr": "1786/12/07",
                    "whenCh": "十二月初七日"
                  }
                ]
              }
            ],
            "__repeatId": "硃78#qing#candidate"
          }
