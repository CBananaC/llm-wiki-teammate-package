      "whoLoc": {},
      "relations": [],
      "provenance": [],
      "whenCh": "乾隆五十二年一月七日",
      "dateAr": "1787/01/07",
      "sources": [
        {
          "doc_id": "諭31",
          "quote": "至常青折內稱探得澎湖兵於十四日到臺郡，安平林遊擊亦帶兵赴援，現在賊勢稍退等語。郡城防守嚴密，全臺根本尚不致有他虞。黃仕簡等務須俟各路官兵到齊，約會日期，同時併力夾攻，自無難一舉蕆事",
          "label": "針對臺灣局部戰況與郡城防守的指示",
          "howKnown": "上諭"
        }
      ],
