            "evidence": {
              "marker": "奉到諭旨",
              "quote_in_reply": "正月二十六日，臣奉到諭旨：「黃仕簡、任承恩俱已前後渡臺，何以尚未據奏報剿賊消息。」等因。欽此",
              "matched_yu_span": "至黃仕簡、任承恩俱已前後臺，何以尚未據報剿賊消息？",
              "issue_date": "未明",
              "receive_date": "乾隆五十二年正月二十六日",
              "receipt": {
                "type": "direct",
                "via": "未明",
