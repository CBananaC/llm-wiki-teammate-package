            "reply": {
              "id": "奏92",
              "title": "為欽奉諭旨謹將辦理備撥粵兵情形恭摺覆奏事",
              "type": "shangzou",
              "doc_type": "上奏",
              "author": "孫士毅",
              "recipients": [],
