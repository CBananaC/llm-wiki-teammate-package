      "who": [
        "乾隆帝",
        "藍元枚",
        "常青"
      ],
      "whoLoc": {},
      "relations": [],
      "provenance": [],
      "whenCh": "乾隆五十二年正月初二日",
      "dateAr": "1787/01/02",
      "sources": [
        {
          "doc_id": "諭24",
          "label": "特旨命藍元枚署理福建陸路提督駐紮蚶江以彈壓漳泉及協助調度",
