                "whoLoc": {
                  "乾隆帝": "京師",
                  "任承恩": "福建"
                },
                "relations": [],
                "origin_doc_id": "",
                "origin_type": "",
                "origin_quote": "",
                "origin_date": "",
                "same_as_event_id": "evmr3ct01fofz",
                "sources": [
                  {
                    "doc_id": "硃32",
                    "source_type": "硃批",
                    "quote": "更不成話，不料汝亦如此至愚。欽此。",
                    "title": "為特簡重臣臨閩督辦事（附片）",
                    "date": "1786/12/29",
                    "position": "尾批"
