      {
        "at": "2026-07-25 11:51",
        "model": "local skill output",
        "kind": "edictmatch",
        "combinedEmperor": true,
        "marker": "上諭皇帝行動",
        "memDoc": "諭31",
        "memTitle": "諭閩浙總督常青等務宜鎮定妥辦不可張大其事",
        "items": [
          {
            "edict_id": "諭31",
            "title": "諭閩浙總督常青等務宜鎮定妥辦不可張大其事",
            "date": "1787/01/07",
            "memDoc": "諭31",
            "memTitle": "諭閩浙總督常青等務宜鎮定妥辦不可張大其事",
            "summary": "上諭中皇帝自己的評論與命令。",
            "points": [
              {
                "title": "乾隆帝斥責常青等張皇失措過度調兵",
                "aspect": "blame",
                "action_type": "blame",
                "how": "乾隆帝嚴厲批評常青等官員因一匪犯滋擾即動用全省兵力並諮會鄰省預備，辦理失措且置封疆大體於不顧。",
                "description": "乾隆帝嚴厲批評常青等官員因一匪犯滋擾即動用全省兵力並諮會鄰省預備，辦理失措且置封疆大體於不顧。",
                "whenCh": "乾隆五十二年正月初七日",
                "whenAr": "1787/01/07",
                "where": "京師",
                "who": [
                  "乾隆帝"
                ],
                "whoLoc": {
                  "乾隆帝": "京師"
                },
                "relations": [],
                "same_as_event_id": "",
                "target": [
                  "常青",
                  "徐嗣曾"
                ],
                "quote": "看來常青等辦理此事，皆過於張皇失措。豈有因一匪犯滋擾，而調及全省兵力，並諮會鄰疆預備調撥，使民心皆懷恐懼之理？從前康熙年間，奸民朱一貴聚衆滋擾，全臺失陷。其時不過水師提督施世驃帶兵渡臺進剿，不及一月，即已收復蕆功。即前此黃教勾結生番搶掠之案，亦系水師提督領兵進剿滅，從未有水陸二提遠渡重洋辦一類，內地於不顧。且從前剿捕朱一貴、黃教二案，調兵若干名，該督自有成案可查。今常青既令任承恩帶兵，由鹿耳門前進，又復加調官兵陸續渡臺，並諮會粵東、浙江酌備戰兵，以資策應。臺灣常有糾衆不法之事，此次常青等何以張皇畏懼至此？若因匪徒滋擾，而沿海一帶俱須預備，則山東登萊、直隸天津等處，亦當紛紛調遣防範，有是理乎？地方遇有此等案件，如真定總兵全保不速拿段文經等，自有應得之罪。若常青等則又全不顧事理輕重，各存預佔地步之見，以見其留心努力，反置封疆大體於不問。徐嗣曾於此事初起時，尚能處以鎮靜，及常青等矜張失措，亦不免爲所惶惑，是以有移諮鄰省一體預備之舉。",
                "sources": [
                  {
                    "doc_id": "諭31",
                    "source_type": "上諭",
                    "quote": "看來常青等辦理此事，皆過於張皇失措。豈有因一匪犯滋擾，而調及全省兵力，並諮會鄰疆預備調撥，使民心皆懷恐懼之理？從前康熙年間，奸民朱一貴聚衆滋擾，全臺失陷。其時不過水師提督施世驃帶兵渡臺進剿，不及一月，即已收復蕆功。即前此黃教勾結生番搶掠之案，亦系水師提督領兵進剿滅，從未有水陸二提遠渡重洋辦一類，內地於不顧。且從前剿捕朱一貴、黃教二案，調兵若干名，該督自有成案可查。今常青既令任承恩帶兵，由鹿耳門前進，又復加調官兵陸續渡臺，並諮會粵東、浙江酌備戰兵，以資策應。臺灣常有糾衆不法之事，此次常青等何以張皇畏懼至此？若因匪徒滋擾，而沿海一帶俱須預備，則山東登萊、直隸天津等處，亦當紛紛調遣防範，有是理乎？地方遇有此等案件，如真定總兵全保不速拿段文經等，自有應得之罪。若常青等則又全不顧事理輕重，各存預佔地步之見，以見其留心努力，反置封疆大體於不問。徐嗣曾於此事初起時，尚能處以鎮靜，及常青等矜張失措，亦不免爲所惶惑，是以有移諮鄰省一體預備之舉。",
                    "title": "諭閩浙總督常青等務宜鎮定妥辦不可張大其事",
                    "date": "1787/01/07"
                  }
                ],
                "card_id": "#emperor#7",
                "__pendingResponses": [
                  {
                    "action_quote": "看來常青等辦理此事，皆過於張皇失措。豈有因一匪犯滋擾，而調及全省兵力，並諮會鄰疆預備調撥，使民心皆懷恐懼之理？",
                    "doc_id": "硃130",
                    "how": "閩浙總督常青於正月十九日接奉上諭後，坦承因臺匪蔓延、恐府城兵力不敷而加調官兵，且未詳查朱一貴等成案遵辦，實屬張惶失措與深感慚悚。同時說明對兩廣總督派來之一千粵兵已令暫駐，將俟兩提臣音訊再行斟酌，並彙報水陸兩提臣業已到臺會剿及郡城民情安堵之情形。",
                    "receive_date": "乾隆五十二年正月十九日",
                    "relations": [
                      {
                        "evidence": "加調官兵二千名，檄令副將徐鼎士等帶領，俱從各該處出口渡臺",
                        "relation": "加調渡臺",
                        "relation_type": "command",
                        "source": "常青",
                        "target": "徐鼎士"
                      },
                      {
                        "evidence": "臣伏查臺匪林爽文等糾衆不法...實屬張惶失措",
                        "relation": "剿捕",
                        "relation_type": "conflict",
                        "source": "常青",
                        "target": "林爽文"
                      }
                    ],
                    "response_date": "乾隆五十二年正月二十日",
                    "response_quote": "臣伏查臺匪林爽文等糾衆不法，攻佔彰化，旋又搶踞諸羅水，進擾郡城。此等奸民，本屬么麼小丑，無難克期撲滅。但不意旬日之間，即已蔓延四橫。臣因府城爲全臺根本，賊勢猖獗，誠恐兵力不敷，一時憂迫。復又加調官兵前往，未及將從前剿捕朱一貴、黃教等案詳查遵辦，實屬張惶失措，仰蒙聖明訓示諄切，不勝慚悚。",
                    "subtitle": "常青坦承加調官兵屬張惶失措並陳報粵兵屯駐與兩提臣渡臺戰況",
                    "where": "福建",
                    "who": [
                      "常青",
                      "林爽文",
                      "黃仕簡",
                      "任承恩",
                      "徐鼎士"
                    ],
                    "who_loc": {
                      "任承恩": "鹿港",
                      "常青": "福建",
                      "徐鼎士": "臺灣",
                      "林爽文": "臺灣",
                      "黃仕簡": "臺灣府城"
                    }
                  },
                  {
                    "action_quote": "看來常青等辦理此事，皆過於張皇失措。豈有因一匪犯滋擾，而調及全省兵力，並諮會鄰疆預備調撥，使民心皆懷恐懼之理？",
                    "doc_id": "硃130",
                    "how": "閩浙總督常青於正月十九日接奉上諭後，坦承因臺匪蔓延、恐府城兵力不敷而加調官兵，且未詳查朱一貴等成案遵辦，實屬張惶失措與深感慚悚。同時說明對兩廣總督派來之一千粵兵已令暫駐，將俟兩提臣音訊再行斟酌，並彙報水陸兩提臣業已到臺會剿及郡城民情安堵之情形。",
                    "receive_date": "乾隆五十二年正月十九日",
                    "relations": [
                      {
                        "evidence": "加調官兵二千名，檄令副將徐鼎士等帶領，俱從各該處出口渡臺",
                        "relation": "加調渡臺",
                        "relation_type": "command",
                        "source": "常青",
                        "target": "徐鼎士"
                      },
                      {
                        "evidence": "臣伏查臺匪林爽文等糾衆不法...實屬張惶失措",
