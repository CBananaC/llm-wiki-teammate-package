                "relation": "黨羽",
                "relation_type": "ally",
                "source": "吳領",
                "target": "林爽文"
              }
            ],
            "sources": [
              {
                "doc_id": "硃82",
                "quote": "二十三日林爽文黨羽陳泮、吳領等燒毀泉、粵民莊，隨率義民前往追捕，殺死賊夥三十餘名，十獲紅旗四枝，器械四十餘件，並力追趕，賊人退歸南、北投而去。",
                "howKnown": "",
                "whenKnown": ""
              }
            ],
            "__traceChains": [
              {
                "events": [
                  {
                    "quote": "二十三日林爽文黨羽陳泮、吳領等燒毀泉、粵民莊，隨率義民前往追捕，殺死賊夥三十餘名，十獲紅旗四枝，器械四十餘件，並力追趕，賊人退歸南、北投而去。",
                    "reporter": "署鹿仔港守備陳邦光",
                    "subtitle": "陳泮吳領等燒毀民莊",
                    "whenCh": "十二月二十三日",
                    "where": "南北投"
