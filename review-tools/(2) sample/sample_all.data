                "whenCh": "乾隆五十二年正月初二日",
                "whenAr": "1787/01/02",
                "where": "北京",
                "who": [
                  "乾隆帝",
                  "柴大紀",
                  "徐嗣曾"
                ],
                "whoLoc": {
                  "乾隆帝": "北京",
