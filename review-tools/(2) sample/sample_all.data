                    "subtitle": "常青奏報瑚圖里已至軍前效力並遵旨於事竣查明功罪暨議恤湯大奎",
                    "where": "桶盤棧",
                    "who": [
                      "常青",
                      "瑚圖里",
                      "黃仕簡",
                      "柴大紀",
                      "蔡攀龍",
                      "湯大奎"
                    ],
                    "who_loc": {
                      "常青": "泉州",
                      "柴大紀": "臺灣",
                      "湯大奎": "鳳山",
                      "瑚圖里": "桶盤棧",
                      "蔡攀龍": "桶盤棧",
                      "黃仕簡": "臺灣"
                    }
                  }
                ],
