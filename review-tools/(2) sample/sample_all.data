  "硃72": {
    "overallAdj": "乾隆五十一年十二月，福建巡撫徐嗣曾奏報赴臺支援與省城防衛兵力調配情形。閩省已自督標與撫標抽調一千名官兵，由延平協副將林天洛率領，由閩安出海前往鹿耳門會剿，原調之建寧、延平兵勇則留紮省城防守。同時，因應淡水、新莊賊匪復聚暗坑仔之緊急軍情，已派總兵郝壯猷與副將徐鼎士各率兵千餘名（計及後勤軍裝共四千餘人）前往淡水救援，擬由八里坌進口進剿，並派小船往來探報。此奏獲乾隆皇帝硃批「知道了」。",
    "divisions": [
      {
        "label": "調兵背景",
        "summary": "說明先前預調建寧與延平官兵至省城，後遵督臣咨會改由督撫標抽調兵丁渡海會剿，建延兵留駐省城。",
        "start": 0,
        "end": 99,
        "n": 1
      },
      {
        "label": "兵勇動向與集結",
        "summary": "報告延平與建寧兵員到省情形，並已完成督標與臣標一千名官兵配船往閩安候風放洋之部署。",
        "start": 99,
        "end": 190,
        "n": 2
      },
      {
        "label": "淡水戰情",
        "summary": "轉述都司易連稟報淡水、新莊義民擊退賊匪，然匪徒又於暗坑仔聚集，請求速派大軍進剿。",
        "start": 190,
        "end": 247,
        "n": 3
      },
      {
        "label": "增援淡水與兵力部署",
        "summary": "說明郝壯猷與徐鼎士兩路兵馬進援淡水的兵力規模與後勤配備，並派哨船探報以附片呈奏。",
        "start": 247,
        "end": 477,
        "n": 4
      }
