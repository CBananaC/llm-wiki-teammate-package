                "__pendingResponses": [
                  {
                    "action_quote": "著傳諭徐嗣曾，務宜不動聲色，彈壓坐鎮，並飭沿海口岸文武員弁，嚴密巡查。",
                    "doc_id": "硃113",
                    "how": "福建巡撫徐嗣曾接獲上諭後，報告提臣黃仕簡、任承恩及副將徐鼎士等分路渡海進剿的日期與兵力部署。他強調已遵旨飭令地方文武不動聲色、嚴密稽查，並妥協辦理防範賊匪竄回內地，同時加強內地漳泉一帶的防防與安撫。",
                    "receive_date": "1787/01/11",
                    "relations": [
                      {
                        "evidence": "提臣黃仕簡...先由南路鹿耳門進發",
                        "relation": "協同",
                        "relation_type": "ally",
                        "source": "徐嗣曾",
                        "target": "黃仕簡"
                      },
                      {
                        "evidence": "提臣任承恩進剿中路鹿仔港",
                        "relation": "協同",
                        "relation_type": "ally",
                        "source": "徐嗣曾",
                        "target": "任承恩"
                      }
                    ],
                    "response_date": "1787/01/14",
                    "response_quote": "臣伏思林爽文本係積賊，因被拿情急，起意抗拒，劫營攻城。游手無賴之徒，乘機搶奪，輾轉附和，烏合遂多。此等么麼，誠如聖諭，大兵四路進剿，無難立就撲滅。...臣現已札飭該道、府等，恭錄聖訓，委曲榜示城鄉，明白開導...臣節飭地方文武，不動聲色，嚴密稽查。...臣惟有凜遵諭旨，鎮靜彈壓，一應軍行供支糧餉、火藥等項，督同司、道妥速辦理，不敢稍有忽誤，亦不敢稍涉張皇，致駭眾聽。",
                    "subtitle": "徐嗣曾報告調度兩提督渡海進剿與內地防範",
                    "where": "福建內地",
                    "who": [
                      "徐嗣曾",
                      "黃仕簡",
                      "任承恩",
                      "徐鼎士",
                      "常青",
                      "林爽文"
