    {
      "id": "evms07c5iwu22",
      "actor": "lin",
      "subtitle": "賊匪出彰城西門迎戰",
      "description": "十二月十二日午刻，陳邦光率義民抵彰化時，賊匪出西門外開槍施炮迎戰，後戰敗潰散，偽官楊振國等四人被擒。",
      "what": "賊匪出彰城西門迎戰",
      "where": "彰化縣城西門外",
      "who": [
        "楊振國",
        "高文麟",
        "陳高",
        "楊軒"
      ],
      "whoLoc": {
        "楊振國": "彰化縣城西門外",
        "楊軒": "彰化縣城西門外",
        "陳高": "彰化縣城西門外",
        "高文麟": "彰化縣城西門外"
      },
      "relations": [],
      "provenance": [
        {
          "id": "pvcms07cbyv8h8",
          "hops": [
            {
              "doc_id": "硃82",
              "from_person": "署鹿仔港守備陳邦光",
              "how": "稟報",
              "inferred": false,
              "layer": 1,
              "place": "鹿仔港",
              "quote": "茲於十二月二十七日亥刻，接得該署備陳邦光兩稟同時並到。內十二月十一一稟，據稱：彰化縣近山之大里杙，有漳州積匪林爽文等，糾夥搶劫，擾害地方。先蒙鎮道飭令耿遊、孫知府赴彰督拿，孫知府駐紮縣城，耿遊擊與北協赫副將、彰化縣俞峻帶領兵役，親往大墩莊等處搜捕。詎該犯等始則竄遁山邊，旋復糾約數千人，於十一月二十七夜搶劫大墩營盤，全軍俱陷。",
              "to_person": "閩浙總督常青",
              "whenAr": "1786/12/11",
              "whenCh": "十二月十一日",
              "id": "pvms07cbyve4i"
            }
          ],
          "events": [
            {
              "quote": "十二日午刻，率同各義民從鹿港抵彰，賊匪聞知，隨出西門外駐紮，各執器械，並用劫搶彰城營汛之槍炮施放。邦光令義民分為兩隊，上前攻殺，賊人退走，不能相顧，當即擒獲執旗之偽副元帥楊振國、偽協鎮高文麟、偽先鋒陳高、偽辦理水師軍務楊軒等四名。",
              "reporter": "署鹿仔港守備陳邦光",
              "subtitle": "賊匪出彰城西門迎戰",
              "whenCh": "十二月十二日",
              "where": "彰化縣城西門外"
            }
          ]
        }
      ],
      "whenCh": "十二月十二日",
      "dateAr": "1786/12/12",
