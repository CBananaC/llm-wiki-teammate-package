      "hidden": false,
      "aiFilterLabel": "相關上諭",
      "emperorDetail": {
        "kind": "edict",
        "combined": true,
        "action_type": "command",
        "sources": [
          {
            "doc_id": "諭24",
            "source_type": "上諭",
            "quote": "此時似可無需鄰省接濟兵力，然備撥亦可，總宜不動聲色，密爲佈置，不可稍涉矜張，驚動衆聽。此一節並傳諭孫士毅、琅玕一體遵照妥辦。",
            "title": "諭閩浙總督常青等總須鎮定持重並俟兵丁到齊約期夾攻",
            "date": "1787/01/02"
          }
        ],
        "memDoc": "諭24",
        "memTitle": "諭閩浙總督常青等總須鎮定持重並俟兵丁到齊約期夾攻",
        "how": "乾隆帝指示廣東、浙江督撫備撥鄰省兵力時，應不動聲色密為佈置，切不可張揚驚動大眾。"
      }
